#!/bin/sh
# shellcheck disable=SC3043 # FreeBSD sh has local
# cook: rebuild the next, seen, and hold merge branches from the topics
# listed in next's description. See cook(1).

set -eu
# Topic lists are split on whitespace, and must not glob.
set -f

readonly PROGNAME="${0##*/}"

die() {
	echo "${PROGNAME}: ${*}" >&2
	exit 1
}

usage() {
	echo "usage: ${PROGNAME} [-nv]" >&2
	exit 2
}

# quote <arg>: print an argument quoted for the shell, if it needs it.
quote() {
	case "${1}" in
	'' | *[!A-Za-z0-9_@%+=:,./-]*)
		printf "'%s'" "$(printf '%s' "${1}" | sed "s/'/'\\\\''/g")"
		;;
	*)
		printf '%s' "${1}"
		;;
	esac
}

# run <command>...: run a command, or print it under -n.
run() {
	local sep=

	if [ -z "${dry_run}" ]; then
		"${@}"
		return
	fi
	for arg in "${@}"; do
		printf '%s' "${sep}"
		quote "${arg}"
		sep=' '
	done
	echo
}

# rebuild <branch> <base> <topic>...: make <branch> a merge of <base>
# and each topic, in order. A topic must name exactly one commit.
rebuild() {
	local branch="${1}" onto="-o ${2}"
	shift 2

	for topic in "${@}"; do
		onto="${onto} -o exactly(${topic},1)"
	done
	# shellcheck disable=SC2086 # onto is split on purpose
	run jj --quiet rebase -s "${branch}" ${onto}
	run jj --quiet simplify-parents -r "${branch}"
}

# check <topic>...: print each topic that next does not contain, marked
# M if it merges into next by itself and C if it conflicts, one per
# line in no order. An M line ends with the topic's short commit ID. The trial merges are jj commits, which the caller
# drops. They are not made with git merge-tree, which needs a .git
# directory that a jj workspace lacks.
check() {
	local n=0 rev trial result

	for topic in "${@}"; do
		rev="exactly(${topic},1)"
		[ -z "$(jj log --no-graph -r "${rev} & ::next" -T '"1"')" ] ||
			continue
		n=$((n + 1))
		jj --quiet new --no-edit -m "cook: trial ${n}" next "${rev}"
		trial="children(next) & description(exact:\"cook: trial ${n}\n\")"
		result=$(jj log --no-graph -r "${trial}" \
		    -T 'if(conflict, "C", "M")')
		if [ "${result}" = C ]; then
			printf 'C %s\n' "${topic}"
		else
			printf 'M %s %s\n' "${topic}" "$(jj log --no-graph \
			    -r "${rev}" -T 'commit_id.short(8)')"
		fi
	done
}

dry_run=
verbose=
while getopts nv opt; do
	case "${opt}" in
	n) dry_run=1 ;;
	v) verbose=1 ;;
	*) usage ;;
	esac
done
shift $((OPTIND - 1))
[ $# -eq 0 ] || usage

next_topics=
seen_topics=
hold_topics=
in_cook=
line=0
while IFS= read -r text; do
	line=$((line + 1))
	# shellcheck disable=SC2086 # split into fields on purpose
	set -- ${text%%#*}
	keyword="${1:-}" ref="${2:-}"
	if [ -z "${in_cook}" ]; then
		if [ "${keyword}" = "[cook]" ] && [ -z "${ref}" ]; then
			in_cook=1
		fi
		continue
	fi
	case "${keyword}" in
	"") continue ;;
	next | seen | hold) ;;
	*) die "line ${line}: unknown keyword: ${keyword}" ;;
	esac
	[ -n "${ref}" ] || die "line ${line}: ${keyword} needs a ref"
	[ $# -le 2 ] || die "line ${line}: too many fields"
	case "${keyword}" in
	next) next_topics="${next_topics} ${ref}" ;;
	seen) seen_topics="${seen_topics} ${ref}" ;;
	hold) hold_topics="${hold_topics} ${ref}" ;;
	esac
done <<-EOF
$(jj log --no-graph -r next -T description)
EOF
[ -n "${in_cook}" ] || die "next has no [cook] line"

has_hold=$(jj log --no-graph -r 'bookmarks(exact:"hold")' -T '"1"')
[ -n "${has_hold}" ] || [ -z "${hold_topics}" ] ||
	die "hold topics need a hold bookmark"

# Undo every rebase if any step fails, so that the branches move together
# or not at all.
if [ -z "${dry_run}" ]; then
	op=$(jj op log -n 1 --no-graph -T id)
	trap 'jj --quiet op restore "${op}"; echo "${PROGNAME}: rolled back" >&2' EXIT
fi

# shellcheck disable=SC2086 # topic lists are split on purpose
rebuild next 'trunk()' ${next_topics}
# shellcheck disable=SC2086
rebuild seen next ${seen_topics}
if [ -n "${has_hold}" ]; then
	# shellcheck disable=SC2086
	rebuild hold 'trunk()' ${hold_topics}
fi
trap - EXIT

# The trial merges are only for show, so drop them by restoring the
# operation from before them, which keeps the rebuild.
if [ -n "${verbose}" ]; then
	op=$(jj op log -n 1 --no-graph -T id)
	trap 'jj --quiet op restore "${op}"' EXIT
	# shellcheck disable=SC2086
	lines=$(check ${seen_topics})
	# M sorts after C, so reverse the first field to list M first.
	[ -z "${lines}" ] || printf '%s\n' "${lines}" | sort -k1,1r -k2
fi
