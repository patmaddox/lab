#!/bin/sh
# shellcheck disable=SC3043 # FreeBSD sh has local
# cook: rebuild the next and seen merge branches from the topics
# listed in next's description. See cook(1).

set -eu
# Topic lists are split on whitespace, and must not glob.
set -f

readonly PROGNAME="${0##*/}"

die() {
	echo "${PROGNAME}: ${*}" >&2
	exit 1
}

usage() {
	echo "usage: ${PROGNAME} [-n]" >&2
	exit 2
}

# quote <arg>: print an argument quoted for the shell, if it needs it.
quote() {
	case "${1}" in
	'' | *[!A-Za-z0-9_@%+=:,./-]*)
		printf "'%s'" "$(printf '%s' "${1}" | sed "s/'/'\\\\''/g")"
		;;
	*)
		printf '%s' "${1}"
		;;
	esac
}

# run <command>...: run a command, or print it under -n.
run() {
	local sep=

	if [ -z "${dry_run}" ]; then
		"${@}"
		return
	fi
	for arg in "${@}"; do
		printf '%s' "${sep}"
		quote "${arg}"
		sep=' '
	done
	echo
}

# rebuild <branch> <base> <topic>...: make <branch> a merge of <base>
# and each topic, in order.
rebuild() {
	local branch="${1}" onto=
	shift

	for rev in "${@}"; do
		onto="${onto} -o ${rev}"
	done
	# shellcheck disable=SC2086 # onto is split on purpose
	run jj --quiet rebase -s "${branch}" ${onto}
	run jj --quiet simplify-parents -r "${branch}"
}

dry_run=
while getopts n opt; do
	case "${opt}" in
	n) dry_run=1 ;;
	*) usage ;;
	esac
done
shift $((OPTIND - 1))
[ $# -eq 0 ] || usage

next_topics=
seen_topics=
in_cook=
line=0
while read -r keyword ref extra; do
	line=$((line + 1))
	if [ -z "${in_cook}" ]; then
		if [ "${keyword}" = "[cook]" ] && [ -z "${ref}" ]; then
			in_cook=1
		fi
		continue
	fi
	case "${keyword}" in
	"") continue ;;
	next | seen) ;;
	*) die "line ${line}: unknown keyword: ${keyword}" ;;
	esac
	[ -n "${ref}" ] || die "line ${line}: ${keyword} needs a ref"
	[ -z "${extra}" ] || die "line ${line}: too many fields"
	case "${keyword}" in
	next) next_topics="${next_topics} ${ref}" ;;
	seen) seen_topics="${seen_topics} ${ref}" ;;
	esac
done <<-EOF
$(jj log --no-graph -r next -T description)
EOF
[ -n "${in_cook}" ] || die "next has no [cook] line"

# shellcheck disable=SC2086 # topic lists are split on purpose
rebuild next 'trunk()' ${next_topics}
# shellcheck disable=SC2086
rebuild seen next ${seen_topics}
