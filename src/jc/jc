#!/bin/sh

set -eu
set -o pipefail

readonly PROGNAME="${0##*/}"
readonly CONF="jc.conf"
readonly REPO="default.jj"

err() {
	echo "${PROGNAME}: E: ${*}" >&2
}

die() {
	err "${@}"
	exit 1
}

main() {
	local fresh=0

	[ -f "${CONF}" ] || die "cannot read ${CONF}: No such file or directory"
	require_default_workspace
	if [ ! -d "${REPO}/.jj" ]; then
		fresh=1
	fi
	ensure_repo
	ensure_remotes
	fetch_remotes
	track_bookmarks
	if [ "${fresh}" -eq 1 ]; then
		position_default_workspace
	fi
	ensure_workspaces
	ensure_push_repo
}

require_default_workspace() {
	if [ -z "$(workspace_index default)" ]; then
		die "no workspace named \"default\" in ${CONF}"
	fi
}

ensure_repo() {
	if [ ! -d "${REPO}/.jj" ]; then
		jj git init --colocate "${REPO}"
	fi
}

ensure_remotes() {
	local n i name src
	n="$(cfg ".remotes|length")"
	i=0
	while [ "${i}" -lt "${n}" ]; do
		name="$(cfg ".remotes.${i}.name")"
		src="$(cfg ".remotes.${i}.src")"
		if ! remote_exists "${name}"; then
			jj -R "${REPO}" git remote add "${name}" "${src}"
		fi
		i=$((i + 1))
	done
}

fetch_remotes() {
	if [ "$(cfg ".remotes|length")" -gt 0 ]; then
		jj -R "${REPO}" git fetch --all-remotes
	fi
}

track_bookmarks() {
	local n i bookmark remote
	n="$(cfg ".workspaces|length")"
	i=0
	while [ "${i}" -lt "${n}" ]; do
		bookmark="$(ws_field "${i}" bookmark)"
		remote="$(ws_field "${i}" remote)"
		if [ -n "${bookmark}" ] && [ -n "${remote}" ] \
		    && ! bookmark_tracked "${bookmark}" "${remote}"; then
			jj -R "${REPO}" bookmark track "${bookmark}@${remote}"
		fi
		i=$((i + 1))
	done
}

# On first provision, move the default workspace off jj's initial
# empty change onto a new change atop its configured base.
position_default_workspace() {
	local i base
	i="$(workspace_index default)"
	base="$(workspace_base "${i}" default)"
	if [ -n "${base}" ]; then
		jj -R "${REPO}" new "${base}"
	fi
}

ensure_workspaces() {
	local n i name
	n="$(cfg ".workspaces|length")"
	i=0
	while [ "${i}" -lt "${n}" ]; do
		name="$(cfg ".workspaces.${i}.name")"
		if [ "${name}" != "default" ] && ! workspace_exists "${name}"; then
			add_workspace "${i}" "${name}"
		fi
		i=$((i + 1))
	done
}

add_workspace() {
	local i="${1}"; shift
	local name="${1}"; shift
	local base

	base="$(workspace_base "${i}" "${name}")"
	if [ -n "${base}" ]; then
		jj -R "${REPO}" workspace add --name "${name}" \
		    -r "${base}" "${name}.jj"
	else
		jj -R "${REPO}" workspace add --name "${name}" "${name}.jj"
	fi
}

ensure_push_repo() {
	local push
	push="$(cfg ".push_repo")"
	if [ "${push}" = "null" ]; then
		return 0
	fi
	if ! remote_exists "${push}"; then
		die "push_repo \"${push}\" is not a configured remote"
	fi
	jj -R "${REPO}" config set --repo git.push "${push}"
}

# The revset a workspace's working copy is created atop: its
# configured bookmark, else a local bookmark matching its name,
# else empty for jj's default.
workspace_base() {
	local i="${1}"; shift
	local name="${1}"; shift
	local bookmark remote

	bookmark="$(ws_field "${i}" bookmark)"
	remote="$(ws_field "${i}" remote)"
	if [ -n "${bookmark}" ] && [ -n "${remote}" ]; then
		echo "${bookmark}@${remote}"
	elif [ -n "${bookmark}" ]; then
		echo "${bookmark}"
	elif bookmark_exists "${name}"; then
		echo "${name}"
	fi
}

workspace_index() {
	local name="${1}"; shift
	local n i
	n="$(cfg ".workspaces|length")"
	i=0
	while [ "${i}" -lt "${n}" ]; do
		if [ "$(cfg ".workspaces.${i}.name")" = "${name}" ]; then
			echo "${i}"
			return 0
		fi
		i=$((i + 1))
	done
}

ws_field() {
	local i="${1}"; shift
	local key="${1}"; shift
	local val

	val="$(cfg ".workspaces.${i}.${key}")"
	if [ "${val}" != "null" ]; then
		echo "${val}"
	fi
}

remote_exists() {
	local name="${1}"; shift

	jj -R "${REPO}" git remote list | awk '{print $1}' \
	    | grep -Fx "${name}" >/dev/null
}

workspace_exists() {
	local name="${1}"; shift

	jj -R "${REPO}" workspace list -T 'name ++ "\n"' \
	    | grep -Fx "${name}" >/dev/null
}

bookmark_exists() {
	local name="${1}"; shift

	jj -R "${REPO}" bookmark list -T 'name ++ "\n"' \
	    | grep -Fx "${name}" >/dev/null
}

bookmark_tracked() {
	local bookmark="${1}"; shift
	local remote="${1}"; shift

	jj -R "${REPO}" bookmark list --all-remotes \
	    -T 'if(remote, if(tracked, name ++ "@" ++ remote ++ "\n"))' \
	    | grep -Fx "${bookmark}@${remote}" >/dev/null
}

cfg() {
	local key="${1}"; shift

	uclcmd get -q -f "${CONF}" "${key}"
}

main "${@}"
