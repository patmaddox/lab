#!/usr/bin/env atf-sh

atf_init_test_cases() {
	atf_add_test_case no_command
	atf_add_test_case unknown_command
	atf_add_test_case new_no_origin
	atf_add_test_case new_origin_no_slash
	atf_add_test_case new_origin_extra_slash
	atf_add_test_case new_produces_port
	atf_add_test_case new_missing_makefile
	atf_add_test_case new_missing_distinfo
	atf_add_test_case new_empty_file_fails
	atf_add_test_case new_inference_fails
	atf_add_test_case new_passes_origin_and_target
	atf_add_test_case new_passes_stdin_detail
	atf_add_test_case new_writes_into_portsdir
	atf_add_test_case new_model_flags_split
	atf_add_test_case update_no_origin
	atf_add_test_case update_invalid_origin
	atf_add_test_case update_produces_port
	atf_add_test_case update_missing_distinfo
	atf_add_test_case update_passes_origin_and_target
}

setup() {
	PORTIA="$(atf_get_srcdir)/portia"
	mk_model
	export MODEL="${PWD}/model-stub"
}

# Write a fake model command in the current directory. It records its
# argv to model.argv, then stands in for the model: it derives the port
# directory from the prompt - as the real model would from the same
# line - and obeys three env vars that shape the run under test.
#
#   STUB_WRITE  space-separated files to create with content
#   STUB_TOUCH  space-separated files to create empty
#   STUB_FAIL   when 1, exit non-zero without producing anything
mk_model() {
	cat > model-stub <<-'EOF'
	#!/bin/sh
	: > model.argv
	for a in "$@"; do printf '%s\n' "$a" >> model.argv; done
	[ "${STUB_FAIL:-0}" = 1 ] && exit 1
	prompt=; next=
	for a in "$@"; do
		[ "$next" = yes ] && { prompt=$a; break; }
		[ "$a" = -p ] && next=yes
	done
	dir=$(printf '%s\n' "$prompt" \
	    | sed -n 's/^Write the port into: //p')
	for f in ${STUB_WRITE:-}; do printf 'content\n' > "$dir/$f"; done
	for f in ${STUB_TOUCH:-}; do : > "$dir/$f"; done
	exit 0
	EOF
	chmod +x model-stub
}

atf_test_case no_command
no_command_head() {
	atf_set "descr" "portia with no command prints usage and exits 64"
}
no_command_body() {
	setup
	atf_check -s exit:64 -e match:"usage" "${PORTIA}"
}

atf_test_case unknown_command
unknown_command_head() {
	atf_set "descr" "an unknown command prints usage and exits 64"
}
unknown_command_body() {
	setup
	atf_check -s exit:64 -e match:"usage" "${PORTIA}" frobnicate
}

atf_test_case new_no_origin
new_no_origin_head() {
	atf_set "descr" "new without an origin prints usage and exits 64"
}
new_no_origin_body() {
	setup
	atf_check -s exit:64 -e match:"usage" "${PORTIA}" new
}

atf_test_case new_origin_no_slash
new_origin_no_slash_head() {
	atf_set "descr" "an origin without a slash is rejected"
}
new_origin_no_slash_body() {
	setup
	atf_check -s exit:1 -e match:"invalid origin" \
	    -x "'${PORTIA}' new foo </dev/null"
}

atf_test_case new_origin_extra_slash
new_origin_extra_slash_head() {
	atf_set "descr" "an origin with more than one slash is rejected"
}
new_origin_extra_slash_body() {
	setup
	atf_check -s exit:1 -e match:"invalid origin" \
	    -x "'${PORTIA}' new a/b/c </dev/null"
}

atf_test_case new_produces_port
new_produces_port_head() {
	atf_set "descr" "new succeeds when the complete port shape lands"
}
new_produces_port_body() {
	setup
	export STUB_WRITE="Makefile distinfo pkg-descr"
	atf_check -s exit:0 -x "'${PORTIA}' new www/foo </dev/null"
	atf_check test -s www/foo/Makefile
	atf_check test -s www/foo/distinfo
	atf_check test -s www/foo/pkg-descr
}

atf_test_case new_missing_makefile
new_missing_makefile_head() {
	atf_set "descr" "new fails when a required file is absent"
}
new_missing_makefile_body() {
	setup
	export STUB_WRITE="distinfo pkg-descr"
	atf_check -s exit:1 -e match:"no Makefile" \
	    -x "'${PORTIA}' new www/foo </dev/null"
}

atf_test_case new_missing_distinfo
new_missing_distinfo_head() {
	atf_set "descr" "new fails when distinfo is absent"
}
new_missing_distinfo_body() {
	setup
	export STUB_WRITE="Makefile pkg-descr"
	atf_check -s exit:1 -e match:"no distinfo" \
	    -x "'${PORTIA}' new www/foo </dev/null"
}

atf_test_case new_empty_file_fails
new_empty_file_fails_head() {
	atf_set "descr" "an empty required file does not satisfy the check"
}
new_empty_file_fails_body() {
	setup
	export STUB_WRITE="pkg-descr"
	export STUB_TOUCH="Makefile"
	atf_check -s exit:1 -e match:"no Makefile" \
	    -x "'${PORTIA}' new www/foo </dev/null"
}

atf_test_case new_inference_fails
new_inference_fails_head() {
	atf_set "descr" "a failed model invocation is reported and fatal"
}
new_inference_fails_body() {
	setup
	export STUB_FAIL=1
	atf_check -s exit:1 -e match:"inference failed" \
	    -x "'${PORTIA}' new www/foo </dev/null"
}

atf_test_case new_passes_origin_and_target
new_passes_origin_and_target_head() {
	atf_set "descr" "the model is told the origin and the target directory"
}
new_passes_origin_and_target_body() {
	setup
	export STUB_WRITE="Makefile distinfo pkg-descr"
	atf_check -s exit:0 -x "'${PORTIA}' new www/foo </dev/null"
	atf_check grep -qF "Port origin: www/foo" model.argv
	atf_check grep -qF "Write the port into: ./www/foo" model.argv
}

atf_test_case new_passes_stdin_detail
new_passes_stdin_detail_head() {
	atf_set "descr" "detail read from stdin reaches the prompt"
}
new_passes_stdin_detail_body() {
	setup
	export STUB_WRITE="Makefile distinfo pkg-descr"
	atf_check -s exit:0 \
	    -x "printf 'version 1.2.3\n' | '${PORTIA}' new www/foo"
	atf_check grep -qF "version 1.2.3" model.argv
}

atf_test_case new_writes_into_portsdir
new_writes_into_portsdir_head() {
	atf_set "descr" "the port lands under PORTSDIR, not the cwd"
}
new_writes_into_portsdir_body() {
	setup
	export PORTSDIR="tree"
	export STUB_WRITE="Makefile distinfo pkg-descr"
	atf_check -s exit:0 -x "'${PORTIA}' new www/foo </dev/null"
	atf_check test -s tree/www/foo/Makefile
	atf_check test ! -e www/foo/Makefile
}

atf_test_case new_model_flags_split
new_model_flags_split_head() {
	atf_set "descr" "extra words in MODEL split into separate arguments"
}
new_model_flags_split_body() {
	setup
	export MODEL="${PWD}/model-stub --model x"
	export STUB_WRITE="Makefile distinfo pkg-descr"
	atf_check -s exit:0 -x "'${PORTIA}' new www/foo </dev/null"
	atf_check -o match:"^--model$" -o match:"^x$" cat model.argv
}

