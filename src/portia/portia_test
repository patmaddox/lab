setup() {
	PORTIA="$(atf_get_srcdir)/portia"
	mk_model
	export MODEL="${PWD}/model-stub"
}

# Write a fake model command in the current directory. It records its
# argv to model.argv, then stands in for the model: it derives the port
# directory and the commit-message path from the prompt - as the real
# model would from the same lines - and obeys the env vars that shape
# the run under test.
#
#   STUB_WRITE   space-separated files to create with content
#   STUB_TOUCH   space-separated files to create empty
#   STUB_FAIL    when 1, exit non-zero without producing anything
#   STUB_MSG     the commit message to write (default a plausible one)
#   STUB_NOMSG   when 1, write no commit message
mk_model() {
	cat > model-stub <<-'EOF'
	#!/bin/sh
	: > model.argv
	for a in "$@"; do printf '%s\n' "$a" >> model.argv; done
	[ "${STUB_FAIL:-0}" = 1 ] && exit 1
	prompt=; next=
	for a in "$@"; do
		[ "$next" = yes ] && { prompt=$a; break; }
		[ "$a" = -p ] && next=yes
	done
	dir=$(printf '%s\n' "$prompt" \
	    | sed -n 's/^Write the port into: //p')
	msg=$(printf '%s\n' "$prompt" \
	    | sed -n 's/^Write the commit message to: //p')
	for f in ${STUB_WRITE:-}; do printf 'content\n' > "$dir/$f"; done
	for f in ${STUB_TOUCH:-}; do : > "$dir/$f"; done
	if [ -n "$msg" ] && [ "${STUB_NOMSG:-0}" != 1 ]; then
		printf '%s\n' "${STUB_MSG:-www/foo: Add new port}" > "$msg"
	fi
	exit 0
	EOF
	chmod +x model-stub
}

# Make a directory (default the current one) the ports tree: a git
# repository with an identity to commit under. A successful portia run
# commits the port, so every success case needs one.
mk_repo() {
	local dir="${1:-.}"
	mkdir -p "${dir}"
	git init -q "${dir}"
	git -C "${dir}" config user.email portia@example.com
	git -C "${dir}" config user.name "portia test"
}

# Make a directory (default the current one) a jj-managed ports tree.
# Tests that call this skip when the jj binary is unavailable, so the
# suite still runs on a host without jj installed.
mk_jj_repo() {
	local dir="${1:-.}"
	command -v jj >/dev/null 2>&1 || atf_skip "jj is not installed"
	mkdir -p "${dir}"
	jj git init "${dir}" >/dev/null 2>&1 || atf_skip "jj init failed"
	jj -R "${dir}" config set --repo user.email portia@example.com
	jj -R "${dir}" config set --repo user.name "portia test"
}

# Make the current directory a colocated tree: a git repository that jj
# also manages. The two identities are given distinct emails so a commit
# reveals which tool made it.
mk_colocated_repo() {
	command -v jj >/dev/null 2>&1 || atf_skip "jj is not installed"
	git init -q .
	git config user.email git@example.com
	git config user.name "git identity"
	jj git init --colocate . >/dev/null 2>&1 || atf_skip "jj colocate failed"
	jj config set --repo user.email jj@example.com
	jj config set --repo user.name "jj identity"
}

atf_test_case no_command
no_command_head() {
	atf_set "descr" "portia with no command prints usage and exits 64"
}
no_command_body() {
	setup
	atf_check -s exit:64 -e match:"usage" "${PORTIA}"
}

