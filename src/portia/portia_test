	mk_repo
	export STUB_WRITE="Makefile distinfo pkg-descr"
	export STUB_MSG="www/foo: Add new port"
	atf_check -s exit:0 -x "'${PORTIA}' new www/foo </dev/null"
	atf_check -o match:"www/foo: Add new port" git log -1 --format=%s
}

atf_test_case new_commits_port_jj
new_commits_port_jj_head() {
	atf_set "descr" "portia commits into a jj tree with the model's message"
}
new_commits_port_jj_body() {
	setup
	mk_jj_repo
	export STUB_WRITE="Makefile distinfo pkg-descr"
	export STUB_MSG="www/foo: Add new port"
	atf_check -s exit:0 -x "'${PORTIA}' new www/foo </dev/null"
	# The port path was committed and the model's message is the
	# description of the resulting change (now the parent of the
	# working copy).
	atf_check -o match:"www/foo/Makefile" jj -R . diff -r '@-' --name-only
	atf_check -o match:"www/foo: Add new port" \
	    jj -R . log --no-graph -r '@-' -T "description.first_line()"
}

atf_test_case new_prefers_jj
new_prefers_jj_head() {
	atf_set "descr" "with both jj and git present, portia commits with jj"
}
new_prefers_jj_body() {
	setup
	mk_colocated_repo
	export STUB_WRITE="Makefile distinfo pkg-descr"
	atf_check -s exit:0 -x "'${PORTIA}' new www/foo </dev/null"
	# jj made the commit, so its author bears the jj identity, not the
	# git one the git path would have used.
	atf_check -o match:"jj@example.com" \
	    jj -R . log --no-graph -r '@-' -T "author.email()"
}

