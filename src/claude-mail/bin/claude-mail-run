#!/bin/sh
set -e

usage() {
    echo "usage: claude-mail-run [-n count]" >&2
    exit 1
}

count=1

while getopts n: flag; do
    case "$flag" in
        n) count="$OPTARG" ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))

SCRIPT_DIR="$(dirname $(realpath $0))"

notmuch search --output=messages tag:new and to:claude not tag:draft \
    | tail -r | head -n "$count" \
    | while read -r msgid; do
        "${SCRIPT_DIR}/claude-handle-message" "${msgid}" || true
done
