#!/bin/sh
set -e

JAIL_ROOT="/jails/instances/claude"
MSG_ID="$1"
SCRIPT_DIR="$(dirname $(realpath $0))"
SYSTEM_PROMPT_FILE=/tmp/input/system.prompt
WS_HASH=$(printf '%s' "${MSG_ID}" | sha256 | head -c 16)
WORKSPACE="/tmp/claude-ws-mail-${WS_HASH}"
JAIL_WORKSPACE=${JAIL_ROOT}${WORKSPACE}
LOCKFILE="${JAIL_ROOT}/tmp/claude-ws-mail-${WS_HASH}.lock"

# Acquire an exclusive lock; exit immediately if already held.
if [ "${CLAUDE_MAIL_LOCKED:-}" != "${WS_HASH}" ]; then
	CLAUDE_MAIL_LOCKED="${WS_HASH}" \
		exec lockf -t 0 "${LOCKFILE}" "$0" "$@"
fi

log() {
	echo "[claude-handle-message] ${@}"
}

# Extract the first message-id from a named header in an email file.
extract_msgid_from_header() {
	local header file
	header="${1}"
	file="${2}"
	grep -i "^${header}:" "${file}" | head -1 | grep -o '<[^>]*>' | head -1 || true
}

cleanup() {
	_rc=$?
	# Unmount the nullfs mount if it is still active.
	if mount -p | grep -q "${JAIL_WORKSPACE}/tmp/mail"; then
		doas umount "${JAIL_WORKSPACE}/tmp/mail"
	fi
	if [ $_rc -eq 0 ]; then
		rm -rf "${JAIL_WORKSPACE}"
	else
		errdir="${JAIL_ROOT}/tmp/claude-ws-mail-errors"
		mkdir -p "${errdir}"
		mv "${JAIL_WORKSPACE}" "${errdir}/"
		echo "workspace preserved: ${errdir}/$(basename ${JAIL_WORKSPACE})" >&2
	fi
}
trap cleanup EXIT

if [ -d "${JAIL_WORKSPACE}" ]; then
	echo "E: stale workspace ${JAIL_WORKSPACE} exists" >&2
	exit 1
fi

subject=$(notmuch show --format=json --body=false "${MSG_ID}" \
	| jq -r '.. | objects | select(.match == true) | .headers.Subject' | head -1)
log "started ${MSG_ID}"
log "subject ${subject}"
log "workspace ${JAIL_WORKSPACE}"

log "clone repo"
git clone -q --branch trunk "${HOME}/lab/default.jj/.git" "${JAIL_WORKSPACE}"
git -C "${JAIL_WORKSPACE}" config user.name "claude"
git -C "${JAIL_WORKSPACE}" config user.email "claude"
CLONE_HEAD=$(git -C "${JAIL_WORKSPACE}" rev-parse HEAD)

mkdir -p "${JAIL_WORKSPACE}/tmp/input"
mkdir -p "${JAIL_WORKSPACE}/tmp/output-agent"
mkdir -p "${JAIL_WORKSPACE}/tmp/output-script"
cat ${SCRIPT_DIR}/../lib/handle-message.prompt \
    | sed -e "s|%%WORKSPACE%%|${WORKSPACE}|g" \
    > "${JAIL_WORKSPACE}/${SYSTEM_PROMPT_FILE}"
log "get message info"
notmuch show --format=raw "${MSG_ID}" > "${JAIL_WORKSPACE}/tmp/input/input.eml"

# Make the notmuch database available inside the workspace so the
# agent can search and read mail.
NOTMUCH_DB=$(notmuch config get database.path)
JAIL_MAIL_DIR="${JAIL_WORKSPACE}/tmp/mail"
mkdir -p "${JAIL_MAIL_DIR}"
doas mount_nullfs -o ro "${NOTMUCH_DB}" "${JAIL_MAIL_DIR}"

sed -e "s|^path=.*|path=${WORKSPACE}/tmp/mail|" \
    "${JAIL_WORKSPACE}/.notmuch-config" \
    > "${JAIL_WORKSPACE}/tmp/notmuch.conf"

log "prompting claude..."
export CLAUDE_ENV_NOTMUCH_CONFIG="${WORKSPACE}/tmp/notmuch.conf"
echo "act on email @${WORKSPACE}/tmp/input/input.eml" \
	| claude -p --append-system-prompt-file ${WORKSPACE}${SYSTEM_PROMPT_FILE}

# Produce patch series from any new commits
thread_root=$(extract_msgid_from_header "References" \
	"${JAIL_WORKSPACE}/tmp/input/input.eml")
if [ -z "${thread_root}" ]; then
	thread_root=$(extract_msgid_from_header "Message-ID" \
		"${JAIL_WORKSPACE}/tmp/input/input.eml")
fi

# Generate cover letter description from commit log
git -C "${JAIL_WORKSPACE}" log --reverse --format='%s%n%n%b' \
	"${CLONE_HEAD}..HEAD" > "${JAIL_WORKSPACE}/tmp/output-script/cover-description"

commit_count=$(git -C "${JAIL_WORKSPACE}" rev-list --count \
	"${CLONE_HEAD}..HEAD")

cover_args=""
if [ "${commit_count}" -gt 1 ]; then
	cover_args="--cover-letter --cover-from-description=auto --description-file=${JAIL_WORKSPACE}/tmp/output-script/cover-description"
fi

reply_to_args="--in-reply-to=${thread_root}"
if [ -f "${JAIL_WORKSPACE}/tmp/output-agent/new-thread" ]; then
	reply_to_args=""
fi

git -C "${JAIL_WORKSPACE}" format-patch --patience \
	--thread ${cover_args} ${reply_to_args} \
	-o "${JAIL_WORKSPACE}/tmp/output-script" \
	"${CLONE_HEAD}"

# Embed agent reply bodies into patch commentary.
# When the agent produces both a reply .eml and commits, the reply
# body becomes commentary in the first patch (cover letter or sole
# patch) and the .eml is suppressed.
eml_files=$(find "${JAIL_WORKSPACE}/tmp/output-agent" -maxdepth 1 -name '*.eml' -type f 2>/dev/null | sort)
first_patch=$(find "${JAIL_WORKSPACE}/tmp/output-script" -maxdepth 1 -name '*.patch' -type f 2>/dev/null | sort | head -1)
if [ -n "${eml_files}" ] && [ -n "${first_patch}" ]; then
	commentary="${JAIL_WORKSPACE}/tmp/output-script/commentary"
	for eml in ${eml_files}; do
		sed '1,/^$/d' "${eml}" >> "${commentary}"
	done
	awk -v cf="${commentary}" '
		/^---$/ && !done {
			print
			print ""
			while ((getline l < cf) > 0) print l
			done = 1
			next
		}
		{ print }
	' "${first_patch}" > "${first_patch}.tmp"
	mv "${first_patch}.tmp" "${first_patch}"
	rm -f "${commentary}"
	for eml in ${eml_files}; do
		rm "${eml}"
	done
	log "embedded agent reply in ${first_patch##*/}"
fi

# Verify output exists (either a reply .eml or generated .patch files)
replies=$(find "${JAIL_WORKSPACE}/tmp/output-agent" -maxdepth 1 -name '*.eml' -type f 2>/dev/null || true)
patches=$(find "${JAIL_WORKSPACE}/tmp/output-script" -maxdepth 1 -name '*.patch' -type f 2>/dev/null || true)
if [ -z "${replies}" ] && [ -z "${patches}" ]; then
	echo "E: no reply .eml files in tmp/output-agent/ or .patch files in tmp/output-script/" >&2
	exit 1
fi

# Report what files were created in the staging directory.
tree -I 'mail' "${JAIL_WORKSPACE}/tmp"

# Ingest replies directly from the staging dir
log "ingesting replies"
${SCRIPT_DIR}/claude-mail-ingest "${JAIL_WORKSPACE}/tmp/output-agent"
${SCRIPT_DIR}/claude-mail-ingest "${JAIL_WORKSPACE}/tmp/output-script"

# Mark the processed message as handled by removing the new tag.
log "remove new tag from message"
notmuch tag -new -- "${MSG_ID}"

log "done ${MSG_ID}"
