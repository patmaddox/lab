#!/bin/sh
set -e

JAIL_ROOT="/jails/instances/claude"
MSG_ID="$1"
SCRIPT_DIR="$(dirname $(realpath $0))"
SYSTEM_PROMPT_FILE=/tmp/system.prompt
WORKSPACE="/tmp/claude-ws-mail-$(date +%Y%m%d-%H%M%S)"
JAIL_WORKSPACE=${JAIL_ROOT}${WORKSPACE}

# Extract the first message-id from a named header in an email file.
extract_msgid_from_header() {
	local header file
	header="${1}"
	file="${2}"
	grep -i "^${header}:" "${file}" | head -1 | grep -o '<[^>]*>' || true
}

echo ${JAIL_WORKSPACE}

git -c advice.detachedHead=false clone -q "${HOME}/lab/default.jj/.git" "${JAIL_WORKSPACE}"
git -C "${JAIL_WORKSPACE}" config user.name "claude"
git -C "${JAIL_WORKSPACE}" config user.email "claude"
CLONE_HEAD=$(git -C "${JAIL_WORKSPACE}" rev-parse HEAD)

mkdir -p "${JAIL_WORKSPACE}/tmp/claude-messages"
cat ${SCRIPT_DIR}/../lib/handle-message.prompt \
    | sed -e "s|%%WORKSPACE%%|${WORKSPACE}|g" \
    > ${JAIL_WORKSPACE}${SYSTEM_PROMPT_FILE}
notmuch show --format=raw "${MSG_ID}" > "${JAIL_WORKSPACE}/tmp/input.eml"

cat "${JAIL_WORKSPACE}/tmp/input.eml" | claude -p --append-system-prompt-file ${WORKSPACE}${SYSTEM_PROMPT_FILE}

# Produce patch series from any new commits
thread_root=$(extract_msgid_from_header "References" \
	"${JAIL_WORKSPACE}/tmp/input.eml")
if [ -z "${thread_root}" ]; then
	thread_root=$(extract_msgid_from_header "Message-ID" \
		"${JAIL_WORKSPACE}/tmp/input.eml")
fi

# Generate cover letter description from commit log
git -C "${JAIL_WORKSPACE}" log --reverse --format='%s%n%n%b' \
	"${CLONE_HEAD}..HEAD" > "${JAIL_WORKSPACE}/tmp/cover-description"

git -C "${JAIL_WORKSPACE}" format-patch --patience \
	--cover-letter --thread \
	--cover-from-description=auto \
	--description-file="${JAIL_WORKSPACE}/tmp/cover-description" \
	--in-reply-to="${thread_root}" \
	-o "${JAIL_WORKSPACE}/tmp/claude-messages" \
	"${CLONE_HEAD}"

# Verify output exists (either a reply .eml or generated .patch files)
messages=$(find "${JAIL_WORKSPACE}/tmp/claude-messages" -maxdepth 1 -type f \
	\( -name '*.eml' -o -name '*.patch' \))
if [ -z "${messages}" ]; then
	echo "E: no reply or patches in ${JAIL_WORKSPACE}/tmp/claude-messages/" >&2
	exit 1
fi

# Ingest replies directly from the staging dir
${SCRIPT_DIR}/claude-mail-ingest "${JAIL_WORKSPACE}/tmp/claude-messages"
