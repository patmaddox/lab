#!/bin/sh

set -eu
set -o pipefail

readonly PROGNAME="${0##*/}"
readonly CELL=".cell"
readonly BARE="default.git"

err() {
	echo "${PROGNAME}: E: ${*}" >&2
}

die() {
	err "${@}"
	exit 1
}

usage() {
	echo "usage: ${PROGNAME} init <src>" >&2
	echo "       ${PROGNAME} new <name>" >&2
	echo "       ${PROGNAME} resume <name>" >&2
	exit 64
}

# Walk up from the current directory to the nearest ancestor holding a
# .cell directory. Its hidden, distinctive name means a plain
# containment check suffices, so cell can run from anywhere below the
# directory that holds .cell.
find_cell_dir() {
	local d
	d="$(pwd -P)"
	while :; do
		if [ -d "${d}/${CELL}" ]; then
			echo "${d}/${CELL}"
			return 0
		fi
		[ "${d}" = "/" ] && return 1
		d="$(dirname "${d}")"
	done
}

# Bare-clone <src> into the shared .cell default.git as a standalone
# repo with no relationship to its source: the clone records src as
# origin, so we drop it. The result is the bare repo that cells push
# to and fetch from, wholly disconnected from the repo it was seeded
# from.
cmd_init() {
	[ "${#}" -eq 1 ] || usage
	local src="${1}"
	local dst="${CELL}/${BARE}"

	[ ! -e "${dst}" ] || die "destination already exists: ${dst}"
	git clone --bare "${src}" "${dst}"
	git -C "${dst}" remote remove origin
}

# Clone the shared .cell default.git into a sibling colocated jj+git
# checkout named <name>.jj, with origin pointing back at default.git.
# A cell pushes its work to a branch named for the cell, so <name>
# must not collide with a branch already in default.git: a cell can be
# pushed and its checkout removed, leaving the branch behind, so the
# on-disk <name>.jj check alone would let the name be reused.
cmd_new() {
	[ "${#}" -eq 1 ] || usage
	local name="${1}"
	local cells bare dest

	cells="$(find_cell_dir)" \
	    || die "no ${CELL} directory found from $(pwd -P)"
	bare="${cells}/${BARE}"
	[ -d "${bare}" ] || die "${cells} has no ${BARE}"
	dest="${cells}/${name}.jj"
	[ ! -e "${dest}" ] || die "cell \"${name}\" already exists: ${dest}"
	! git -C "${bare}" show-ref --quiet --verify "refs/heads/${name}" \
	    || die "branch \"${name}\" already exists in ${BARE};" \
	           "resume it with ${PROGNAME} resume ${name}"
	jj git clone --colocate "${bare}" "${dest}"
}

# Clone the shared .cell default.git into a sibling colocated jj+git
# checkout named <name>.jj and set its working copy on the existing
# branch <name>, resuming a cell whose checkout was removed after its
# work was pushed. Unlike new, resume requires the branch to exist.
cmd_resume() {
	[ "${#}" -eq 1 ] || usage
	local name="${1}"
	local cells bare dest

	cells="$(find_cell_dir)" \
	    || die "no ${CELL} directory found from $(pwd -P)"
	bare="${cells}/${BARE}"
	[ -d "${bare}" ] || die "${cells} has no ${BARE}"
	dest="${cells}/${name}.jj"
	[ ! -e "${dest}" ] || die "cell \"${name}\" already exists: ${dest}"
	git -C "${bare}" show-ref --quiet --verify "refs/heads/${name}" \
	    || die "no branch \"${name}\" in ${BARE}"
	jj git clone --colocate "${bare}" "${dest}"
	jj -R "${dest}" bookmark track "${name}@origin"
	jj -R "${dest}" new "${name}"
}

main() {
	[ "${#}" -ge 1 ] || usage
	local cmd="${1}"; shift
	case "${cmd}" in
	init)	cmd_init "${@}" ;;
	new)	cmd_new "${@}" ;;
	resume)	cmd_resume "${@}" ;;
	*)	usage ;;
	esac
}

main "${@}"
