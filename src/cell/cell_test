atf_test_case new_branch_exists
new_branch_exists_head() {
	atf_set "descr" "cell new fails when default.git already has the <name> branch"
}
new_branch_exists_body() {
	setup
	mk_cells
	# A pushed cell q1 would leave a q1 branch behind.
	git -C .cell/default.git branch q1 main
	atf_check -s exit:1 \
	    -e match:'branch "q1" already exists' \
	    -e match:'cell resume q1' \
	    "${CELL}" new q1
}

