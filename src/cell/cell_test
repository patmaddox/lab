setup() {
	cat > jjconfig.toml <<-EOF
	[user]
	name = "Test"
	email = "test@example.com"
	EOF
	export JJ_CONFIG="${PWD}/jjconfig.toml"
	CELL="$(atf_get_srcdir)/cell"
}

# Create a plain git repo at ${PWD}/src with one commit on branch main,
# to stand in for the repo a cell is seeded from via its .git.
mk_src() {
	git init -q -b main src
	echo "hello" > src/file.txt
	git -C src add file.txt
	git -C src -c user.name=t -c user.email=t@t commit -qm init
}

# Create a .cell directory at ${PWD}/.cell holding a default.git
# bare repo with one commit on branch main.
mk_cells() {
	mkdir .cell
	git init -q --bare -b main .cell/default.git
	git clone -q .cell/default.git seed 2>/dev/null
	echo "hello" > seed/file.txt
	git -C seed add file.txt
	git -C seed -c user.name=t -c user.email=t@t commit -qm init
	git -C seed push -q origin main
	rm -rf seed
}

# Push a branch <name> to .cell/default.git carrying an extra file
# work.txt, standing in for a cell that pushed work and was removed.
mk_branch() {
	local name="${1}"
	git clone -q .cell/default.git seed 2>/dev/null
	git -C seed checkout -q -b "${name}"
	echo "resumed" > seed/work.txt
	git -C seed add work.txt
	git -C seed -c user.name=t -c user.email=t@t commit -qm work
	git -C seed push -q origin "${name}"
	rm -rf seed
}

atf_test_case no_args
no_args_head() {
	atf_set "descr" "cell with no arguments prints usage and exits 64"
}
no_args_body() {
	setup
	atf_check -s exit:64 -e match:"usage" "${CELL}"
}

atf_test_case unknown_command
unknown_command_head() {
	atf_set "descr" "cell with an unknown subcommand prints usage and exits 64"
}
unknown_command_body() {
	setup
	atf_check -s exit:64 -e match:"usage" "${CELL}" bogus
}

