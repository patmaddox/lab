}
new_runs_from_subdir_body() {
	setup
	mk_cells
	mkdir -p default.jj/src
	atf_check -s exit:0 -e ignore \
	    sh -c 'cd default.jj/src && "$1" new q1' _ "${CELL}"
	atf_check test -d .cell/q1.jj/.jj
}

