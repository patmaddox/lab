#!/usr/bin/env atf-sh

atf_init_test_cases() {
	atf_add_test_case no_args
	atf_add_test_case empty_inbox
	atf_add_test_case answers_message
	atf_add_test_case quiet_update
	atf_add_test_case passes_prompt_and_id
	atf_add_test_case drains_oldest_first
	atf_add_test_case stuck_message
	atf_add_test_case creates_workspace
	atf_add_test_case leaves_trunk_working_copy
	atf_add_test_case silent_without_notify_url
	atf_add_test_case rebases_work_onto_trunk
	atf_add_test_case rebases_work_onto_base
	atf_add_test_case follows_rewritten_base
	atf_add_test_case keeps_work_on_its_prerequisite
	atf_add_test_case syncs_the_list
	atf_add_test_case reads_the_lab_mail_profile
	atf_add_test_case skips_unknown_senders
	atf_add_test_case takes_approved_senders_from_env
}

# Build a small lab in the current directory: an upstream repo with
# trunk and a mail list that share no history, and a trunk workspace
# cloned from it. Stubs stand in for claude, notmuch, mbsync, and curl;
# see mk_stubs.
setup() {
	PROCESS_MAIL="$(atf_get_srcdir)/lab-process-mail"
	export LAB_PROCESS_MAIL_PROMPT="$(atf_get_srcdir)/prompt.md"
	export TRUNK_WORKSPACE="${PWD}/default.jj"
	export WORK_WORKSPACE="${PWD}/work.jj"
	unset NOTIFY_URL LAB_BASE_BRANCH LAB_PROCESS_MAIL_SENDERS \
	    NOTMUCH_PROFILE

	export JJ_CONFIG="${PWD}/jj.toml"
	cat > jj.toml <<-'EOF'
	[user]
	name = "Me"
	email = "me@example.org"
	EOF

	mk_stubs
	export PATH="${PWD}/bin:${PATH}"

	git init -q --bare upstream.git 2>/dev/null
	jj git init seed.jj >/dev/null 2>&1
	(
		cd seed.jj
		jj config set --repo user.email pat@example.org
		echo one > file
		jj commit -m 'trunk: one'
		jj bookmark create trunk -r @-
		jj new 'root()'
		mkdir maildir
		touch maildir/.gitkeep
		jj commit -m 'mail: start the list'
		jj bookmark create mail -r @-
		jj git remote add upstream ../upstream.git
		jj git push --remote upstream --bookmark trunk \
		    --bookmark mail
	) >/dev/null 2>&1 || atf_fail "cannot build upstream"

	jj git clone --remote upstream upstream.git default.jj \
	    >/dev/null 2>&1 || atf_fail "cannot clone upstream"
	(
		cd default.jj
		jj bookmark track mail@upstream
		jj new trunk@upstream
	) >/dev/null 2>&1 || atf_fail "cannot build workspaces"
}

# Stub commands, each logging what it was asked to do.
#
# claude records its working directory and argv in claude.log, one
# pass per line group. With STUB_ANSWER=1 it answers the message: it
# takes the id from the last line of the prompt and removes it from
# the inbox. With STUB_MOVE=1 it moves its working copy to root().
#
# notmuch reads the inbox from the file inbox, one "id subject" per
# line, oldest first, all from approved senders. Inbox mail from
# anyone else is in the file unknown, one "id from" per line. It
# answers only the queries lab-process-mail makes, and logs each
# query's NOTMUCH_PROFILE to notmuch.log.
#
# mbsync and curl append their argv to mbsync.log and curl.log.
mk_stubs() {
	mkdir bin
	: > inbox
	: > unknown
	stubdir="${PWD}"

	cat > bin/claude <<-EOF
	#!/bin/sh
	echo "cwd \${PWD}" >> "${stubdir}/claude.log"
	for a in "\$@"; do printf 'arg %s\n' "\$a" >> "${stubdir}/claude.log"; done
	[ "\${STUB_MOVE:-0}" = 1 ] && jj new 'root()' >/dev/null 2>&1
	if [ "\${STUB_ANSWER:-0}" = 1 ]; then
		for a in "\$@"; do last="\$a"; done
		id="\$(printf '%s\n' "\${last}" | tail -n 1 |
		    sed -e 's/^The message to answer is //' -e 's/\.\$//')"
		grep -v "^\${id} " "${stubdir}/inbox" > "${stubdir}/inbox.new" || :
		mv "${stubdir}/inbox.new" "${stubdir}/inbox"
	fi
	EOF

	cat > bin/notmuch <<-EOF
	#!/bin/sh
	inbox="${stubdir}/inbox"
	unknown="${stubdir}/unknown"
	echo "profile \${NOTMUCH_PROFILE:-}" >> "${stubdir}/notmuch.log"
	echo "\$*" >> "${stubdir}/notmuch.log"
	for a in "\$@"; do last="\$a"; done
	case "\$1" in
	new)
		;;
	search)
		case "\${last}" in
		"tag:inbox and not ("*)
			cut -d ' ' -f 1 "\${unknown}"
			;;
		"tag:inbox and ("*)
			head -n 1 "\${inbox}" | cut -d ' ' -f 1
			;;
		*)
			subject="\$(grep "^\${last} " "\${inbox}" | cut -d ' ' -f 2-)"
			echo "thread:1 today [1/1] Pat; \${subject} (inbox)"
			;;
		esac
		;;
	show)
		echo "From: \$(grep "^\${last} " "\${unknown}" | cut -d ' ' -f 2-)"
		;;
	count)
		case "\$2" in
		"tag:inbox and ("*)
			grep -c . "\${inbox}" || :
			;;
		*)
			id="\${2%% and tag:inbox}"
			grep -c "^\${id} " "\${inbox}" || :
			;;
		esac
		;;
	*)
		echo "notmuch stub: \$*" >&2
		exit 1
		;;
	esac
	EOF

	cat > bin/mbsync <<-EOF
	#!/bin/sh
	echo "\$*" >> "${stubdir}/mbsync.log"
	EOF

	cat > bin/curl <<-EOF
	#!/bin/sh
	echo "\$*" >> "${stubdir}/curl.log"
	EOF

	chmod +x bin/*
}

# Push a new trunk commit upstream, as Pat would.
advance_trunk() {
	(
		cd seed.jj
		jj new trunk
		echo two > file
		jj commit -m 'trunk: two'
		jj bookmark set trunk -r @-
		jj git push --remote upstream --bookmark trunk
	) >/dev/null 2>&1 || atf_fail "cannot advance trunk"
}

# Push a staging branch b/dev upstream, one commit off trunk, as Pat
# would. Run again after advance_trunk, it rebuilds b/dev on the new
# trunk, leaving the old b/dev commit behind.
publish_dev() {
	(
		cd seed.jj
		jj new trunk
		echo staged > staged
		jj commit -m 'dev: staged'
		jj bookmark set b/dev --allow-backwards -r @-
		jj git push --remote upstream --bookmark b/dev
	) >/dev/null 2>&1 || atf_fail "cannot publish b/dev"
}

# Print the description of rev's parent in the trunk workspace.
parent_of() {
	jj -R default.jj log --no-graph -T 'description.first_line()' \
	    -r "${1}-"
}

atf_test_case no_args
no_args_body() {
	setup
	atf_check -s exit:1 -e match:"usage" "${PROCESS_MAIL}" extra
}

atf_test_case empty_inbox
empty_inbox_body() {
	setup
	atf_check -s exit:0 -o empty -e ignore "${PROCESS_MAIL}"
	atf_check -s exit:1 test -e claude.log
}

atf_test_case answers_message
answers_message_body() {
	setup
	echo 'id:a@x Hello there' > inbox
	export STUB_ANSWER=1 NOTIFY_URL=https://ntfy.example/topic
	atf_check -s exit:0 \
	    -o inline:"lab-process-mail: inbox 1: id:a@x (Hello there)\n" \
	    -e ignore "${PROCESS_MAIL}"
	atf_check -o match:"answered: Hello there \\(inbox 0\\)" cat curl.log
	atf_check -o match:"https://ntfy.example/topic" cat curl.log
}

atf_test_case quiet_update
quiet_update_head() {
	atf_set descr "Getting up to date prints nothing"
}
quiet_update_body() {
	setup
	echo 'id:a@x Hello there' > inbox
	export STUB_ANSWER=1
	atf_check -s exit:0 -o ignore -e ignore "${PROCESS_MAIL}"
	echo 'id:b@x Again' > inbox
	atf_check -s exit:0 \
	    -o inline:"lab-process-mail: inbox 1: id:b@x (Again)\n" \
	    -e empty "${PROCESS_MAIL}"
}

atf_test_case passes_prompt_and_id
passes_prompt_and_id_body() {
	setup
	echo 'id:a@x Hello there' > inbox
	export STUB_ANSWER=1
	atf_check -s exit:0 -o ignore -e ignore "${PROCESS_MAIL}"
	atf_check -o match:"^cwd ${WORK_WORKSPACE}\$" cat claude.log
	atf_check -o match:"^arg # Process one lab-devel message" cat claude.log
	atf_check -o match:"^Your workspace is ${WORK_WORKSPACE}\\.\$" cat claude.log
	atf_check -o match:'^Your base is trunk\(\)\.$' cat claude.log
	atf_check -o match:"^The message to answer is id:a@x\.\$" \
	    tail -n 1 claude.log
}

atf_test_case drains_oldest_first
drains_oldest_first_body() {
	setup
	printf 'id:a@x First\nid:b@x Second\n' > inbox
	export STUB_ANSWER=1
	printf '%s\n' 'lab-process-mail: inbox 2: id:a@x (First)' \
	    'lab-process-mail: inbox 1: id:b@x (Second)' > expout
	atf_check -s exit:0 -o file:expout -e ignore "${PROCESS_MAIL}"
	atf_check -o inline:"2\n" grep -c '^cwd ' claude.log
}

atf_test_case stuck_message
stuck_message_body() {
	setup
	printf 'id:a@x First\nid:b@x Second\n' > inbox
	export NOTIFY_URL=https://ntfy.example/topic
	atf_check -s exit:1 \
	    -o inline:"lab-process-mail: inbox 2: id:a@x (First)\n" \
	    -e match:"id:a@x is still in the inbox" "${PROCESS_MAIL}"
	atf_check -o inline:"1\n" grep -c '^cwd ' claude.log
	atf_check -o match:"stuck: First \\(inbox 2\\)" cat curl.log
}

atf_test_case silent_without_notify_url
silent_without_notify_url_body() {
	setup
	echo 'id:a@x Hello there' > inbox
	export STUB_ANSWER=1
	atf_check -s exit:0 -o ignore -e ignore "${PROCESS_MAIL}"
	atf_check -s exit:1 test -e curl.log
}

atf_test_case creates_workspace
creates_workspace_body() {
	setup
	atf_check -s exit:0 -o ignore -e ignore "${PROCESS_MAIL}"
	atf_check -o match:"^work: " jj -R default.jj workspace list
	atf_check -o inline:"trunk: one" jj -R work.jj log --no-graph \
	    -T 'description.first_line()' -r '@-'
}

atf_test_case leaves_trunk_working_copy
leaves_trunk_working_copy_body() {
	setup
	echo 'id:a@x Hello there' > inbox
	before="$(jj -R default.jj log --no-graph -T change_id -r @)"
	export STUB_ANSWER=1 STUB_MOVE=1
	atf_check -s exit:0 -o ignore -e ignore "${PROCESS_MAIL}"
	atf_check -o inline:"${before}" \
	    jj -R default.jj log --no-graph -T change_id -r @
}

atf_test_case rebases_work_onto_trunk
rebases_work_onto_trunk_body() {
	setup
	(
		cd default.jj
		echo mine > mine
		jj commit -m 'work: mine'
	) >/dev/null 2>&1
	advance_trunk
	atf_check -s exit:0 -o ignore -e ignore "${PROCESS_MAIL}"
	atf_check_equal "trunk: two" \
	    "$(parent_of 'description(substring:"work: mine")')"
}

atf_test_case rebases_work_onto_base
rebases_work_onto_base_body() {
	setup
	(
		cd default.jj
		echo mine > mine
		jj commit -m 'work: mine'
	) >/dev/null 2>&1
	publish_dev
	export LAB_BASE_BRANCH=b/dev@upstream
	atf_check -s exit:0 -o ignore -e ignore "${PROCESS_MAIL}"
	atf_check_equal "dev: staged" \
	    "$(parent_of 'description(substring:"work: mine")')"
}

atf_test_case follows_rewritten_base
follows_rewritten_base_body() {
	setup
	publish_dev
	jj -R default.jj git fetch >/dev/null 2>&1
	(
		cd default.jj
		jj new b/dev@upstream
		echo mine > mine
		jj commit -m 'work: mine'
	) >/dev/null 2>&1
	advance_trunk
	publish_dev
	export LAB_BASE_BRANCH=b/dev@upstream
	atf_check -s exit:0 -o ignore -e ignore "${PROCESS_MAIL}"
	new="$(jj -R default.jj log --no-graph -T commit_id -r b/dev@upstream)"
	atf_check_equal "${new}" "$(jj -R default.jj log --no-graph \
	    -T commit_id -r 'description(substring:"work: mine")-')"
	# The old b/dev commit is dropped, not carried along as a copy.
	atf_check_equal "x" "$(jj -R default.jj log --no-graph -T '"x"' \
	    -r 'description(substring:"dev: staged")')"
}

atf_test_case keeps_work_on_its_prerequisite
keeps_work_on_its_prerequisite_body() {
	setup
	(
		cd default.jj
		echo theirs > theirs
		jj commit -m 'list: theirs'
		jj metaedit --author 'Pat <pat@example.org>' -r @-
		echo mine > mine
		jj commit -m 'work: mine'
	) >/dev/null 2>&1
	advance_trunk
	atf_check -s exit:0 -o ignore -e ignore "${PROCESS_MAIL}"
	atf_check_equal "list: theirs" \
	    "$(parent_of 'description(substring:"work: mine")')"
	atf_check_equal "trunk: two" \
	    "$(parent_of 'description(substring:"list: theirs")')"
}

atf_test_case syncs_the_list
syncs_the_list_head() {
	atf_set descr "Each pass starts from a sync of the list"
}
syncs_the_list_body() {
	setup
	printf 'id:a@x First\nid:b@x Second\n' > inbox
	export STUB_ANSWER=1
	atf_check -s exit:0 -o ignore -e ignore "${PROCESS_MAIL}"
	# One sync before each pass, and one that finds the inbox empty.
	atf_check -o inline:"-q lab-mail\n-q lab-mail\n-q lab-mail\n" \
	    cat mbsync.log
}

atf_test_case reads_the_lab_mail_profile
reads_the_lab_mail_profile_body() {
	setup
	echo 'id:a@x Hello there' > inbox
	export STUB_ANSWER=1
	atf_check -s exit:0 -o ignore -e ignore "${PROCESS_MAIL}"
	atf_check -o not-match:"^profile \$" -o match:"^profile lab-mail\$" \
	    cat notmuch.log
}

atf_test_case skips_unknown_senders
skips_unknown_senders_head() {
	atf_set descr "Inbox mail from an unknown sender is logged once" \
	    "and never answered"
}
skips_unknown_senders_body() {
	setup
	echo 'id:u@x Eve <eve@example.org>' > unknown
	printf 'id:a@x First\nid:b@x Second\n' > inbox
	export STUB_ANSWER=1
	atf_check -s exit:0 -o ignore \
	    -e inline:"W: lab-process-mail: skipping id:u@x from unknown sender Eve <eve@example.org>\n" \
	    "${PROCESS_MAIL}"
	atf_check -o inline:"2\n" grep -c '^cwd ' claude.log
	atf_check -s exit:1 grep -q 'u@x' claude.log
}

atf_test_case takes_approved_senders_from_env
takes_approved_senders_from_env_body() {
	setup
	echo 'id:a@x Hello there' > inbox
	export STUB_ANSWER=1 LAB_PROCESS_MAIL_SENDERS="a@example.org b@example.org"
	atf_check -s exit:0 -o ignore -e ignore "${PROCESS_MAIL}"
	atf_check -o match:'^search .*tag:inbox and \(from:"a@example.org" or from:"b@example.org"\)$' \
	    cat notmuch.log
}
