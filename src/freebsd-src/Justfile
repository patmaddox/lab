ninja := "ninja -C $(jj root)"
src_root := "src/freebsd-src"

help:
  @just -l

# Show ccache status
ccache +args:
  CCACHE_CONFIGPATH=$(realpath ccache.conf) ccache {{args}}

# Refresh ccache stats every {wait} seconds
ccache-watch wait='5':
  while true; do clear; just ccache -s; sleep {{wait}}; done

# Clone the git repository
clone:
  if [ ! -d main.jj ]; then jj git clone --colocate https://github.com/freebsd/freebsd-src.git main.jj; fi

# Build every config
# build-all *args:
#   {{ninja}} {{args}} freebsd-src:build-all

# Build and release every config
#release-all *args:
#  {{ninja}} {{args}} freebsd-src:release-all

# DWIM build - from scratch if needed, fast if possible
build config:
  {{ninja}} freebsd-src/{{config}}

# Clean everything with the config (cleanworld)
clean config:
  ./scripts/build.sh clean config/{{config}}.conf
  {{ninja}} -t clean freebsd-src/{{config}}

# Build release tarballs (base.txz kernel.txz etc)
release config:
  {{ninja}} freebsd-src/{{config}}:release

# Clean release tarballs
clean-release config:
  ./scripts/build.sh clean-release config/{{config}}.conf
  {{ninja}} -t clean freebsd-src/{{config}}:release

# print .OBJDIR for the build
objdir config:
  ./scripts/build.sh objdir config/{{config}}.conf

# print .OBJDIR/release for the build
objdir-release config:
  ./scripts/build.sh objdir-release config/{{config}}.conf

# Print the command list in markdown table format
command-table:
  just -l -u | awk '/#/ {match($0, /#.*/); printf("| `just %s`!| %s!|\n", $1, substr($0, RSTART + 2)) }' | column -t -s '!' | sed -e 's/  |/ |/g'

# List all release assets (base.txz kernel.txz etc)
ls-releases:
  ls _build/*/amd64.amd64/release

# List all of the configs
ls-configs:
  @for c in $(ls config/*.conf); do basename ${c} .conf; done

[no-cd]
format-patch change="":
  #!/bin/sh
  set -eu
  commit=$(jj -R ../../repos/freebsd-src.jj show {{change}} -T 'commit_id ++ "\n"' -s | head -n 1)
  git -C ../../repos/freebsd-src.jj format-patch -o $(pwd)/patches -U99999 ${commit}^..${commit}
