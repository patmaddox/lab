src_root = src/freebsd-src
build_sh = ./scripts/build.sh
out_dir = ${ninja_out}/freebsd-src

rule build-freebsd
  command = ninja_root=$$(pwd) && cd ${src_root} && ${build_sh} ls-files config/${config}.conf | awk -v src_root=${src_root} -v stampfile=${out} '{printf("%s: %s/%s\n", stampfile, src_root, $$1)}' > $${ninja_root}/${depfile} && ${build_sh} build config/${config}.conf && cd $${ninja_root} && touch ${out}
  depfile = $out.d
  deps = gcc
  pool = console

rule release-freebsd
  command = curdir=$$(pwd) && cd ${src_root} && ${build_sh} release config/${config}.conf && cd $${curdir} && for f in $out; do cp ${src_root}/_build/${config}/amd64.amd64/release/$$(basename $${f}) ${out_dir}/${config}/; done
  pool = console

# auto-generated from config/*.conf

# these hide all of the specific versions... disable for now
# build freebsd-src$:build-all: phony freebsd-src/15.0-STABWEEK-2025-03 freebsd-src/15.0-CURRENT freebsd-src/14.2-STABLE freebsd-src/14.2-RELEASE 
# build freebsd-src$:release-all: phony freebsd-src/15.0-STABWEEK-2025-03$:release freebsd-src/15.0-CURRENT$:release freebsd-src/14.2-STABLE$:release freebsd-src/14.2-RELEASE$:release 


## 14.2-RELEASE

build src/freebsd-src/_build/14.2-RELEASE.build: build-freebsd | src/freebsd-src/config/14.2-RELEASE.conf src/freebsd-src/scripts/build.sh
  config = 14.2-RELEASE
build freebsd-src/14.2-RELEASE: phony src/freebsd-src/_build/14.2-RELEASE.build

build ninja-out/freebsd-src/14.2-RELEASE/MANIFEST ninja-out/freebsd-src/14.2-RELEASE/base.txz ninja-out/freebsd-src/14.2-RELEASE/kernel.txz ninja-out/freebsd-src/14.2-RELEASE/src.txz ninja-out/freebsd-src/14.2-RELEASE/tests.txz: release-freebsd | src/freebsd-src/_build/14.2-RELEASE.build
  config = 14.2-RELEASE
build freebsd-src/14.2-RELEASE$:release: phony ninja-out/freebsd-src/14.2-RELEASE/MANIFEST ninja-out/freebsd-src/14.2-RELEASE/base.txz ninja-out/freebsd-src/14.2-RELEASE/kernel.txz ninja-out/freebsd-src/14.2-RELEASE/src.txz ninja-out/freebsd-src/14.2-RELEASE/tests.txz

