build_sh = ./scripts/build.sh
ninja_out = ninja-out

rule build-freebsd
  command = jj -R ${config}.jj file list | awk -v stampfile=$out '{printf("%s: %s\n", stampfile, $$1)}' > ${depfile} && ${build_sh} build config/${config}.conf && touch ${out}
  depfile = $out.d
  deps = gcc
  pool = console

rule release-freebsd
  command = ${build_sh} release config/${config}.conf && for f in $out; do cp _build/${config}/amd64.amd64/release/$$(basename $${f}) ${ninja_out}/${config}/; done
  pool = console

# auto-generated from config/*.conf

## 14.2-RELEASE

build _build/14.2-RELEASE.build: build-freebsd | config/14.2-RELEASE.conf scripts/build.sh
  config = 14.2-RELEASE
build 14.2-RELEASE: phony _build/14.2-RELEASE.build

build ninja-out/14.2-RELEASE/MANIFEST ninja-out/14.2-RELEASE/base.txz ninja-out/14.2-RELEASE/kernel.txz ninja-out/14.2-RELEASE/src.txz ninja-out/14.2-RELEASE/tests.txz: release-freebsd | _build/14.2-RELEASE.build
  config = 14.2-RELEASE
build 14.2-RELEASE/txz: phony ninja-out/14.2-RELEASE/MANIFEST ninja-out/14.2-RELEASE/base.txz ninja-out/14.2-RELEASE/kernel.txz ninja-out/14.2-RELEASE/src.txz ninja-out/14.2-RELEASE/tests.txz

