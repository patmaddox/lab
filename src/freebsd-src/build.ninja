build_sh = ./scripts/build.sh

rule build-freebsd
  command = jj -R ${config}.jj file list | awk -v stampfile=$out '{printf("%s: %s\n", stampfile, $$1)}' > ${depfile} && ${build_sh} build config/${config}.conf && touch ${out}
  depfile = $out.d
  deps = gcc
  pool = console

rule release-freebsd
  command = ${build_sh} release config/${config}.conf && touch ${out}
  pool = console

# auto-generated from config/*.conf

## 14.2-RELEASE

build _build/14.2-RELEASE.build: build-freebsd | config/14.2-RELEASE.conf scripts/build.sh
  config = 14.2-RELEASE
build 14.2-RELEASE: phony _build/14.2-RELEASE.build

build _build/14.2-RELEASE.release: release-freebsd | _build/14.2-RELEASE.build
  config = 14.2-RELEASE
build 14.2-RELEASE/txz: phony _build/14.2-RELEASE.release

## 14.2-STABLE

build _build/14.2-STABLE.build: build-freebsd | config/14.2-STABLE.conf scripts/build.sh
  config = 14.2-STABLE
build 14.2-STABLE: phony _build/14.2-STABLE.build

build _build/14.2-STABLE.release: release-freebsd | _build/14.2-STABLE.build
  config = 14.2-STABLE
