build_sh = ./scripts/build.sh
ninja_out = ninja-out

rule build-freebsd
  command = jj -R ${config}.jj file list | awk -v stampfile=$out '{printf("%s: %s\n", stampfile, $$1)}' > ${depfile} && ${build_sh} build config/${config}.conf && touch ${out}
  depfile = $out.d
  deps = gcc
  pool = console

rule release-freebsd
  command = ${build_sh} release config/${config}.conf && for f in $out; do cp _build/${config}/amd64.amd64/release/$$(basename $${f}) ${ninja_out}/${config}/; done
  pool = console
