src_root = src/freebsd-src
build_sh = ./scripts/build.sh
out_dir = ${ninja_out}/freebsd-src

rule build-freebsd
  command = ninja_root=$$(pwd) && cd ${src_root} && ${build_sh} ls-files config/${config}.conf | awk -v src_root=${src_root} -v stampfile=${out} '{printf("%s: %s/%s\n", stampfile, src_root, $$1)}' > $${ninja_root}/${depfile} && ${build_sh} build config/${config}.conf && cd $${ninja_root} && touch ${out}
  depfile = $out.d
  deps = gcc
  pool = console

rule release-freebsd
  command = curdir=$$(pwd) && cd ${src_root} && ${build_sh} release config/${config}.conf && cd $${curdir} && for f in $out; do cp ${src_root}/_build/${config}/amd64.amd64/release/$$(basename $${f}) ${out_dir}/${config}/; done
  pool = console

# auto-generated from config/*.conf

#build mod.freebsd.build: phony mod.freebsd.build.15-STABLE mod.freebsd.build.15-CURRENT mod.freebsd.build.14.2-RELEASE mod.freebsd.build.14-STABLE 
#build freebsd.build: phony mod.freebsd.build

build mod.freebsd.release: phony mod.freebsd.release.15-STABLE mod.freebsd.release.15-CURRENT mod.freebsd.release.14.2-RELEASE mod.freebsd.release.14-STABLE 
#build freebsd.release: phony mod.freebsd.release
build freebsd.all: phony mod.freebsd.release


## 14-STABLE

build src/freebsd-src/_build/14-STABLE.build: build-freebsd | src/freebsd-src/config/14-STABLE.conf src/freebsd-src/scripts/build.sh
  config = 14-STABLE
build mod.freebsd.build.14-STABLE: phony src/freebsd-src/_build/14-STABLE.build
#build freebsd.build.14-STABLE: phony mod.freebsd.build.14-STABLE

build ninja-out/freebsd-src/14-STABLE/MANIFEST ninja-out/freebsd-src/14-STABLE/base.txz ninja-out/freebsd-src/14-STABLE/kernel.txz ninja-out/freebsd-src/14-STABLE/src.txz ninja-out/freebsd-src/14-STABLE/tests.txz: release-freebsd | mod.freebsd.build.14-STABLE
  config = 14-STABLE
build mod.freebsd.release.14-STABLE: phony ninja-out/freebsd-src/14-STABLE/MANIFEST ninja-out/freebsd-src/14-STABLE/base.txz ninja-out/freebsd-src/14-STABLE/kernel.txz ninja-out/freebsd-src/14-STABLE/src.txz ninja-out/freebsd-src/14-STABLE/tests.txz
#build freebsd.release.14-STABLE: phony mod.freebsd.release.14-STABLE
build freebsd.14-STABLE: phony mod.freebsd.release.14-STABLE

