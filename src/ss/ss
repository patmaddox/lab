#!/bin/sh
set -eu
set -o pipefail

targets=""
deps=""
deps_dir=${TMPDIR}/ss

target() {
	local t
	t=${1}; shift
	targets="${t} ${targets}"

	if [ $# -gt 0 ]; then
		set_build_function ${t} ${1}
	fi
}

needs() {
	deps="${@} ${deps}"
}

sanitize_target() {
	echo "${1}" | sed -e "s/\./__DOT__/g"
}

set_build_function() {
	eval "__build_$(sanitize_target ${1})=${2}"
}

get_build_function() {
	local _fn
	eval "_fn=\${__build_$(sanitize_target ${1}):-${1}}"
	echo "$_fn"
}

write_depsum() {
	mkdir -p "$(dirname "${2}")"
	md5 -q "${1}" > "${2}"
}

any_is_ood() {
	local t
	for t in "${@}"; do
		if is_ood ${t}; then return 0; fi
	done
	return 1
}

is_ood() {
	local t
	t=${1}
	if [ ! -f ${t} ]; then return 0; fi

	local sum_file
	sum_file=${deps_dir}/${t}
	if [ ! -f ${sum_file} ]; then return 0; fi

	[ "$(md5 -q ${t})" != "$(cat ${sum_file})" ]
}

build_targets() {
	local target
	for target in ${targets}; do
		maybe_build_target ${target}
	done
}

maybe_build_target() {
	if any_is_ood ${target} ${deps}; then
		echo ${target} >&2
		build_fn=$(get_build_function ${target})
		${build_fn}

		for t in ${target} ${deps}; do
			write_depsum ${t} ${deps_dir}/${t}
		done
	fi
}

mkdir -p ${deps_dir}
. all.ss
build_targets
