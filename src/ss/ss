#!/bin/sh
set -eu
set -o pipefail

readonly PROGNAME="${0##*/}"

usage() {
	cat <<EOF
Usage:
  ${PROGNAME} help
  ${PROGNAME} ls
  ${PROGNAME} clean [target ...]
  ${PROGNAME} [-d] [-o outdir] [target ...]
EOF
}

main() {
	built=""
	cur_target=""
	debug=false
	deps_dir=${TMPDIR:-/tmp}/ss/$(pwd)
	outdir=""
	targets=""

	mkdir -p "${deps_dir}"

	while getopts ":do:" _opt; do
		case "${_opt}" in
			d) debug=true ;;
			o) outdir="${OPTARG}" ;;
			\?) die "unknown option: -${OPTARG}" ;;
		esac
	done
	shift $((OPTIND - 1))

	local cmd="${1:-}"
	case "${cmd}" in
		help | ls)
			cmd::${cmd}
			;;
		clean)
			shift
			cmd::clean "${@}"
			;;
		"")
			cmd::build
			;;
		*)
			cmd::build "${@}"
			;;
	esac
}

cmd::build() {
	load_targets "${@}"
	if [ ${#} -gt 0 ]; then
		local _arg _rt _resolved
		_resolved=""
		for _arg in "${@}"; do
			_rt=$(resolve_target "${_arg}") || die "unknown target: ${_arg}"
			_resolved="${_resolved:+${_resolved} }${_rt}"
			if [ "${_rt}" != "${_arg}" ]; then
				append_prop req_produces "${_rt}" "${_arg}"
			fi
		done
		targets="${_resolved}"
	fi
	trap write_checksums EXIT
	build_targets ${targets}
}

cmd::clean() {
	load_targets
	local _clean_targets
	if [ ${#} -gt 0 ]; then
		_clean_targets=$(resolve_targets "${@}") || exit ${?}
	else
		_clean_targets="${targets}"
	fi
	local _t _p
	for _t in ${_clean_targets}; do
		for _p in $(get_prop produces "${_t}"); do
			rm -f "${_p}"
		done
	done
}

cmd::help() {
	usage
}

cmd::ls() {
	load_targets
	local _t _produces _pp
	for _t in ${targets}; do
		echo "${_t}"
		_produces=$(get_prop produces "${_t}")
		for _pp in ${_produces}; do
			if [ "${_pp}" != "${_t}" ]; then
				echo "  ${_pp}"
			fi
		done
	done
}

# --- Registration ---

add_deps() {
	local _t _which _d
	_t=${1}; shift
	_which="exp"
	for _d in "${@}"; do
		if [ "${_d}" = ":" ]; then
			_which="imp"
			continue
		fi
		local _name="" _dep="${_d}"
		case "${_d}" in
			*=*)
				_name="${_d%%=*}"
				_dep="${_d#*=}"
				;;
		esac
		append_prop "${_which}_deps" "${_t}" "${_dep}"
		if [ -n "${_name}" ]; then
			append_prop named_inputs "${_t}" "${_name}=${_dep}"
		fi
	done
}

needs() {
	add_deps "${cur_target}" "${@}"
}

out-of-tree() {
	if [ -n "${outdir}" ]; then
		local _cur_produces
		_cur_produces=$(get_prop produces "${cur_target}")
		if [ "${_cur_produces}" = "${cur_target}" ]; then
			produces "${outdir}/${cur_target}"
		fi
	fi
}

produces() {
	set_prop produces "${cur_target}" "${*}"
}

stamp() {
	target "${@}"
	mark_stamp "${cur_target}"
}

target() {
	local _t
	_t=${1}; shift
	cur_target="${_t}"
	targets="${targets:+${targets} }${_t}"
	set_prop build "${_t}" "${1:-${_t}}"
	produces "${_t}"
}

# --- Resolution ---

load_targets() {
	if [ ${#} -eq 0 ]; then
		. ./all.ss
	else
		local _need_all _arg
		_need_all=false
		for _arg in "${@}"; do
			if [ -f "./${_arg}.ss" ]; then
				. "./${_arg}.ss"
			else
				_need_all=true
			fi
		done
		if ${_need_all}; then
			. ./all.ss
		fi
	fi
}

resolve_path() {
	local _p
	_p=$(get_prop produces "${1}")
	_p="${_p%% *}"
	echo "${_p:-${1}}"
}

resolve_target() {
	local _arg _t _produces _pp
	_arg=${1}
	case " ${targets} " in
		*" ${_arg} "*) echo "${_arg}"; return 0 ;;
	esac
	for _t in ${targets}; do
		_produces=$(get_prop produces "${_t}")
		for _pp in ${_produces}; do
			if [ "${_pp}" = "${_arg}" ]; then
				echo "${_t}"
				return 0
			fi
		done
	done
	return 1
}

resolve_targets() {
	local _arg _resolved _rt
	_resolved=""
	for _arg in "${@}"; do
		_rt=$(resolve_target "${_arg}") || die "unknown target: ${_arg}"
		_resolved="${_resolved:+${_resolved} }${_rt}"
	done
	echo "${_resolved}"
}

# --- Execution ---

any_is_ood() {
	local t
	for t in "${@}"; do
		if is_ood "${t}"; then return 0; fi
	done
	return 1
}

build_targets() {
	local target
	for target in "${@}"; do
		maybe_build_target "${target}"
	done
}

exec_build_target() {
	local deps _d
	deps=""
	for _d in ${exp_deps}; do
		deps="${deps:+${deps} }$(resolve_path "${_d}")"
	done
	local _produces outfile _pp
	_produces=$(get_prop produces "${target}")
	outfile="${_produces%% *}"
	set_named_input_vars "${target}"
	for _pp in ${_produces}; do
		mkdir -p "$(dirname "${_pp}")"
	done
	dbg_target "build"
	set +e
	${build_fn}
	local _rc=${?}
	set -e
	if [ "${_rc}" -ne 0 ]; then
		err "${target}"
		exit ${_rc}
	fi
	local _req _check_paths
	_req=$(get_prop req_produces "${target}")
	_check_paths="${_req:-${_produces}}"
	for _pp in ${_check_paths}; do
		if [ ! -f "${_pp}" ]; then
			die "${target}: build did not produce ${_pp}"
		fi
	done
	dbg_target "built"
	built="${built:+${built} }${exp_deps} ${imp_deps} ${target}"
}

is_ood() {
	local _t _produces _p
	_t=${1}
	_produces=$(get_prop produces "${_t}")
	_p="${_produces%% *}"
	_p="${_p:-${_t}}"
	if [ ! -f "${_p}" ]; then return 0; fi

	local _req _check _pp
	_req=$(get_prop req_produces "${_t}")
	_check="${_req:-${_produces}}"
	for _pp in ${_check}; do
		if [ ! -f "${_pp}" ]; then return 0; fi
	done

	local _sum_file
	_sum_file=${deps_dir}/${_t}
	if [ ! -f "${_sum_file}" ]; then return 0; fi

	local _cur_sum _saved_sum
	dbg "checksum ${_p}"
	_cur_sum=$(md5 -q "${_p}")
	_saved_sum=$(cat "${_sum_file}")
	[ "${_cur_sum}" != "${_saved_sum}" ]
}

maybe_build_target() {
	local target exp_deps imp_deps
	target=${1}

	if is_in_progress "${target}"; then
		die "cycle: ${target}"
	fi
	if is_visited "${target}"; then return 0; fi

	local build_fn
	build_fn=$(get_prop build "${target}")
	if [ -z "${build_fn}" ]; then
		if [ ! -f "${target}" ]; then
			die "missing source: ${target}"
		fi
		return 0
	fi

	mark_in_progress "${target}"
	mark_visited "${target}"

	exp_deps=$(get_prop exp_deps "${target}")
	imp_deps=$(get_prop imp_deps "${target}")

	build_targets ${exp_deps} ${imp_deps}

	if is_stamp "${target}" || any_is_ood "${target}" ${exp_deps} ${imp_deps}; then
		exec_build_target
	fi
	clear_in_progress "${target}"
}

set_named_input_vars() {
	local _ni _pair _n _v
	_ni=$(get_prop named_inputs "${1}")
	for _pair in ${_ni}; do
		_n="${_pair%%=*}"
		_v="${_pair#*=}"
		eval "${_n}=\"$(resolve_path "${_v}")\""
	done
}

write_checksums() {
	local _t _p _sumfile
	for _t in $(printf '%s\n' ${built} | sort -u); do
		_p=$(resolve_path "${_t}")
		if [ -f "${_p}" ]; then
			dbg "checksum ${_p}"
			_sumfile="${deps_dir}/${_t}"
			mkdir -p "$(dirname "${_sumfile}")"
			md5 -q "${_p}" > "${_sumfile}"
		fi
	done
}

# --- Utilities ---

dbg() {
	if ${debug}; then
		echo "${PROGNAME}: ${*}" >&2
	fi
}

dbg_target() {
	if [ "${outfile}" = "${target}" ]; then
		dbg "${1} ${target}"
	else
		dbg "${1} ${target} -> ${outfile}"
	fi
}

die() {
	err "${@}"
	exit 1
}

err() {
	echo "${PROGNAME}: E: ${*}" >&2
}

append_prop() {
	local _cur
	_cur=$(get_prop "${1}" "${2}")
	set_prop "${1}" "${2}" "${_cur:+${_cur} }${3}"
}

get_prop() {
	local _val
	eval "_val=\${__${1}_$(sanitize_target "${2}"):-}"
	echo "${_val}"
}

has_prop() {
	local _val
	eval "_val=\${__${1}_$(sanitize_target "${2}"):-0}"
	[ "${_val}" = "1" ]
}

clear_in_progress() { set_prop inprog "${1}" 0; }
is_in_progress()    { has_prop inprog "${1}"; }
is_stamp()          { has_prop stamp "${1}"; }
is_visited()        { has_prop visited "${1}"; }
mark_in_progress()  { set_prop inprog "${1}"; }
mark_stamp()        { set_prop stamp "${1}"; }
mark_visited()      { set_prop visited "${1}"; }

sanitize_target() {
	case "${1}" in
		*[.:/\-]*) echo "${1}" | sed -e "s/\./__DOT__/g" -e "s/:/__COLON__/g" -e "s|/|__SLASH__|g" -e "s/-/__DASH__/g" ;;
		*) echo "${1}" ;;
	esac
}

set_prop() {
	eval "__${1}_$(sanitize_target "${2}")=\"${3:-1}\""
}

main "${@}"
