#!/bin/sh
set -eu
set -o pipefail

readonly PROGNAME="${0##*/}"

err() {
	echo "${PROGNAME}: E: ${*}" >&2
}

die() {
	err "${@}"
	exit 1
}

dbg() {
	if ${debug}; then
		echo "${PROGNAME}: ${*}" >&2
	fi
}

dbg_target() {
	if [ "${outfile}" = "${target}" ]; then
		dbg "${1} ${target}"
	else
		dbg "${1} ${target} -> ${outfile}"
	fi
}

usage() {
	cat <<EOF
Usage:
  ${PROGNAME} help
  ${PROGNAME} ls
  ${PROGNAME} clean [target ...]
  ${PROGNAME} [-d] [-o outdir] [target ...]
EOF
}

main() {
	built=""
	cur_target=""
	debug=false
	deps_dir=${TMPDIR:-/tmp}/ss/$(pwd)
	outdir=""
	targets=""

	mkdir -p "${deps_dir}"

	while getopts ":do:" _opt; do
		case "${_opt}" in
			d) debug=true ;;
			o) outdir="${OPTARG}" ;;
			\?) die "unknown option: -${OPTARG}" ;;
		esac
	done
	shift $((OPTIND - 1))

	local cmd="${1:-}"
	case "${cmd}" in
		help | ls)
			cmd::${cmd}
			;;
		clean)
			shift
			cmd::clean "${@}"
			;;
		"")
			cmd::build
			;;
		*)
			cmd::build "${@}"
			;;
	esac
}

cmd::help() {
	usage
}

load_targets() {
	if [ ${#} -eq 0 ]; then
		. ./all.ss
	else
		local _need_all _arg
		_need_all=false
		for _arg in "${@}"; do
			if [ -f "./${_arg}.ss" ]; then
				. "./${_arg}.ss"
			else
				_need_all=true
			fi
		done
		if ${_need_all}; then
			. ./all.ss
		fi
	fi
}

cmd::ls() {
	load_targets
	local _t _produces _pp
	for _t in ${targets}; do
		echo "${_t}"
		_produces=$(get_produces "${_t}")
		for _pp in ${_produces}; do
			if [ "${_pp}" != "${_t}" ]; then
				echo "  ${_pp}"
			fi
		done
	done
}

cmd::clean() {
	load_targets
	local _clean_targets
	if [ ${#} -gt 0 ]; then
		_clean_targets=$(resolve_targets "${@}") || exit ${?}
	else
		_clean_targets="${targets}"
	fi
	local _t _p
	for _t in ${_clean_targets}; do
		for _p in $(get_produces "${_t}"); do
			if [ -f "${_p}" ]; then
				rm "${_p}"
			fi
		done
	done
}

cmd::build() {
	load_targets "${@}"
	if [ ${#} -gt 0 ]; then
		set_requested_produces "${@}"
		targets=$(resolve_targets "${@}") || exit ${?}
	fi
	trap write_checksums EXIT
	build_targets
}

build_targets() {
	local target
	for target in ${targets}; do
		maybe_build "${target}"
	done
}

write_checksums() {
	local _t _p
	for _t in $(echo "${built}" | tr ' ' '\n' | sort -u); do
		_p=$(resolve_path "${_t}")
		if [ -f "${_p}" ]; then
			write_depsum "${_p}" "${deps_dir}/${_t}"
		fi
	done
}

maybe_build() {
	local target exp_deps imp_deps
	target=${1}; shift

	if is_in_progress "${target}"; then
		die "cycle: ${target}"
	fi
	if is_visited "${target}"; then return 0; fi

	mark_in_progress "${target}"
	mark_visited "${target}"

	exp_deps=$(get_deps exp "${target}")
	imp_deps=$(get_deps imp "${target}")

	local d
	for d in ${exp_deps} ${imp_deps}; do
		maybe_build "${d}"
	done

	local _d _dp
	for _d in ${exp_deps} ${imp_deps}; do
		_dp=$(resolve_path "${_d}")
		if [ ! -f "${_dp}" ] && [ -z "$(get_build_function "${_d}")" ]; then
			die "${target}: missing dep: ${_d}"
		fi
	done

	local build_fn deps
	build_fn=$(get_build_function "${target}")

	if [ -n "${build_fn}" ] && { is_stamp "${target}" || any_is_ood "${target}" ${exp_deps} ${imp_deps}; }; then
		local _d
		deps=""
		for _d in ${exp_deps}; do
			deps="${deps:+${deps} }$(resolve_path "${_d}")"
		done
		local outfile
		outfile=$(resolve_path "${target}")
		set_named_input_vars "${target}"
		local _pp
		for _pp in $(get_produces "${target}"); do
			mkdir -p "$(dirname "${_pp}")"
		done
		dbg_target "build"
		set +e
		${build_fn}
		local _rc=${?}
		set -e
		if [ "${_rc}" -ne 0 ]; then
			err "${target}"
			exit ${_rc}
		fi
		local _check_paths
		_check_paths=$(get_check_produces "${target}")
		for _pp in ${_check_paths}; do
			if [ ! -f "${_pp}" ]; then
				die "${target}: build did not produce ${_pp}"
			fi
		done
		dbg_target "built"
		built="${built:+${built} }${exp_deps} ${imp_deps} ${target}"
	fi
	clear_in_progress "${target}"
}

any_is_ood() {
	local t
	for t in "${@}"; do
		if is_ood "${t}"; then return 0; fi
	done
	return 1
}

is_ood() {
	local t p
	t=${1}
	p=$(resolve_path "${t}")
	if [ ! -f "${p}" ]; then return 0; fi

	local _check_produces _pp
	_check_produces=$(get_check_produces "${t}")
	for _pp in ${_check_produces}; do
		if [ ! -f "${_pp}" ]; then return 0; fi
	done

	local sum_file
	sum_file=${deps_dir}/${t}
	if [ ! -f "${sum_file}" ]; then return 0; fi

	local cur_sum saved_sum
	dbg "checksum ${p}"
	cur_sum=$(md5 -q "${p}")
	saved_sum=$(cat "${sum_file}")
	[ "${cur_sum}" != "${saved_sum}" ]
}

write_depsum() {
	dbg "checksum ${1}"
	mkdir -p "$(dirname "${2}")"
	md5 -q "${1}" > "${2}"
}

resolve_path() {
	local _produces
	_produces=$(get_produces "${1}")
	if [ -n "${_produces}" ]; then
		echo "${_produces%% *}"
	else
		echo "${1}"
	fi
}

get_produces() {
	local _p
	eval "_p=\${__produces_$(sanitize_target "${1}"):-}"
	echo "${_p}"
}

get_check_produces() {
	local _t _req
	_t=$(sanitize_target "${1}")
	eval "_req=\${__req_produces_${_t}:-}"
	if [ -n "${_req}" ]; then
		echo "${_req}"
	else
		get_produces "${1}"
	fi
}

resolve_target() {
	local _arg _t _produces _pp
	_arg=${1}
	case " ${targets} " in
		*" ${_arg} "*) echo "${_arg}"; return 0 ;;
	esac
	for _t in ${targets}; do
		_produces=$(get_produces "${_t}")
		for _pp in ${_produces}; do
			if [ "${_pp}" = "${_arg}" ]; then
				echo "${_t}"
				return 0
			fi
		done
	done
	return 1
}

resolve_targets() {
	local _arg _resolved _rt
	_resolved=""
	for _arg in "${@}"; do
		_rt=$(resolve_target "${_arg}") || die "unknown target: ${_arg}"
		_resolved="${_resolved:+${_resolved} }${_rt}"
	done
	echo "${_resolved}"
}

set_requested_produces() {
	local _arg _rt _st _existing
	for _arg in "${@}"; do
		_rt=$(resolve_target "${_arg}") || continue
		if [ "${_rt}" != "${_arg}" ]; then
			_st=$(sanitize_target "${_rt}")
			eval "_existing=\${__req_produces_${_st}:-}"
			eval "__req_produces_${_st}=\"${_existing:+${_existing} }${_arg}\""
		fi
	done
}

target() {
	local t
	t=${1}; shift
	cur_target="${t}"
	targets="${targets:+${targets} }${t}"
	set_build_function "${t}" "${1:-${t}}"
	produces "${t}"
}

stamp() {
	target "${@}"
	mark_stamp "${cur_target}"
}

needs() {
	add_deps "${cur_target}" "${@}"
}

produces() {
	eval "__produces_$(sanitize_target "${cur_target}")=\"${*}\""
}

out-of-tree() {
	if [ -n "${outdir}" ]; then
		local _cur_produces
		_cur_produces=$(get_produces "${cur_target}")
		if [ "${_cur_produces}" = "${cur_target}" ]; then
			produces "${outdir}/${cur_target}"
		fi
	fi
}

add_deps() {
	local t which_deps d _existing
	t=${1}; shift
	which_deps="exp"
	t=$(sanitize_target "${t}")
	for d in "${@}"; do
		if [ "${d}" = ":" ]; then
			which_deps="imp"
			continue
		fi
		local _name="" _dep="${d}"
		case "${d}" in
			*=*)
				_name="${d%%=*}"
				_dep="${d#*=}"
				;;
		esac
		_existing=$(get_deps "${which_deps}" "${t}")
		eval "__${which_deps}_deps_${t}=\"${_existing:+${_existing} }${_dep}\""
		if [ -n "${_name}" ]; then
			local _ni
			eval "_ni=\${__named_inputs_${t}:-}"
			eval "__named_inputs_${t}=\"${_ni:+${_ni} }${_name}=${_dep}\""
		fi
	done
}

get_deps() {
	local which_deps t deps
	which_deps=${1}; shift
	t=${1}; shift
	t=$(sanitize_target "${t}")
	eval "deps=\${__${which_deps}_deps_${t}:-}"
	echo "${deps}"
}

get_named_inputs() {
	local _t _ni
	_t=$(sanitize_target "${1}")
	eval "_ni=\${__named_inputs_${_t}:-}"
	echo "${_ni}"
}

set_named_input_vars() {
	local _ni _pair _n _v
	_ni=$(get_named_inputs "${1}")
	for _pair in ${_ni}; do
		_n="${_pair%%=*}"
		_v="${_pair#*=}"
		eval "${_n}=\"$(resolve_path "${_v}")\""
	done
}

set_build_function() {
	eval "__build_$(sanitize_target "${1}")=${2}"
}

get_build_function() {
	local _fn
	eval "_fn=\${__build_$(sanitize_target "${1}"):-}"
	echo "${_fn}"
}

set_prop() {
	eval "__${1}_$(sanitize_target "${2}")=${3:-1}"
}

has_prop() {
	local _val
	eval "_val=\${__${1}_$(sanitize_target "${2}"):-0}"
	[ "${_val}" = "1" ]
}

is_stamp()          { has_prop stamp "${1}"; }
is_visited()        { has_prop visited "${1}"; }
is_in_progress()    { has_prop inprog "${1}"; }
mark_stamp()        { set_prop stamp "${1}"; }
mark_visited()      { set_prop visited "${1}"; }
mark_in_progress()  { set_prop inprog "${1}"; }
clear_in_progress() { set_prop inprog "${1}" 0; }

sanitize_target() {
	case "${1}" in
		*[.:/\-]*) echo "${1}" | sed -e "s/\./__DOT__/g" -e "s/:/__COLON__/g" -e "s|/|__SLASH__|g" -e "s/-/__DASH__/g" ;;
		*) echo "${1}" ;;
	esac
}

main "${@}"
