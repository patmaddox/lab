@comment Each file and symlink the package installs, from dist/. They
@comment belong to root:wheel, with the mode set here.
@mode 0644
/usr/local/etc/claude-code/.claude/skills/code-sync/SKILL.md
/usr/local/etc/claude-code/.claude/skills/commit-message/SKILL.md
/usr/local/etc/claude-code/CLAUDE.md
/usr/local/etc/claude-code/managed-settings.d/eat.json
/usr/local/etc/claude-code/managed-settings.d/git-identity.json
/usr/local/etc/claude-code/managed-settings.d/permissions.json
/usr/local/etc/claude-code/managed-settings.d/prefs.json
/usr/local/etc/gitconfig
/usr/local/etc/profile.d/claude-code.sh
@comment Claude Code reads its managed settings only from
@comment /etc/claude-code, so point that at them.
/etc/claude-code
@comment goredo installs only itself, and runs as each redo command
@comment through a symlink of that name. Listing the links that
@comment goredo -symlinks makes here, rather than running it from a
@comment script, has pkg remove them with the package.
/usr/local/bin/redo
/usr/local/bin/redo-affects
/usr/local/bin/redo-always
/usr/local/bin/redo-cleanup
/usr/local/bin/redo-dep2rec
/usr/local/bin/redo-depfix
/usr/local/bin/redo-dot
/usr/local/bin/redo-ifchange
/usr/local/bin/redo-ifcreate
/usr/local/bin/redo-inode
/usr/local/bin/redo-log
/usr/local/bin/redo-ood
/usr/local/bin/redo-sources
/usr/local/bin/redo-stamp
/usr/local/bin/redo-targets
/usr/local/bin/redo-whichdo
@comment The hook runs, so it needs the execute bit.
@(root,wheel,0755) /usr/local/etc/claude-code/hooks/keep-git-identity
@comment The directories of its files, which pkg removes once they are
@comment empty. @mode does not suit them, so they set their own.
@dir(root,wheel,0755) /usr/local/etc/claude-code/.claude/skills/code-sync
@dir(root,wheel,0755) /usr/local/etc/claude-code/.claude/skills/commit-message
@dir(root,wheel,0755) /usr/local/etc/claude-code/.claude/skills
@dir(root,wheel,0755) /usr/local/etc/claude-code/.claude
@dir(root,wheel,0755) /usr/local/etc/claude-code/hooks
@dir(root,wheel,0755) /usr/local/etc/claude-code/managed-settings.d
@dir(root,wheel,0755) /usr/local/etc/claude-code
@dir(root,wheel,0755) /usr/local/etc/profile.d
