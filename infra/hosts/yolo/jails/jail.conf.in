# %NAME%: a jail cloned from the %TEMPLATE% template, from the
# yolo-jails package. Edit jail.conf.in in lab's
# infra/hosts/yolo/jails, not this file.
%NAME% {
  path = "/jails/instances/${name}";
  host.hostname = "${name}.p7x.dev";

  # Clone the jail from its template the first time it starts.
  exec.prepare = "/usr/local/libexec/yolo-jail-clone ${name} %TEMPLATE%";

  # A ZFS dataset of its own, <name>/data under the jail's, so it goes
  # when the jail is reset. It is made on the first start, with jailed
  # on, so yolo never mounts it, and zfs.dataset gives it to the jail
  # as it starts. The jail may make, mount, snapshot, and destroy
  # datasets under it, and no others, so poudriere there can use ZFS.
  allow.mount.zfs;
  exec.prepare += "/sbin/zfs list -H zroot/jails/instances/${name}/data >/dev/null 2>&1 || /sbin/zfs create -o jailed=on -o mountpoint=none zroot/jails/instances/${name}/data";
  zfs.dataset = "zroot/jails/instances/${name}/data";

  # Its repo, read-only at the same path as on yolo, so it clones but
  # never writes it. Its own repos, read-write at /git/agent, where
  # beastie fetches them. jail(8) refuses a mountpoint with a symlink
  # below the jail's path, so the jail cannot point a mount out of it.
  exec.prepare += "/usr/local/libexec/yolo-jail-git ${name} %REPO%";
  mount += "/git/%REPO%.git ${path}/git/%REPO%.git nullfs ro 0 0";
  mount += "/git/jails/${name} ${path}/git/agent nullfs rw 0 0";

  # The jail has its own network stack, on one end of an epair, and a
  # /24 of its own, 10.200.%HOST%.0/24. yolo is .1 on the other end and
  # routes it; the jail is .2.
  vnet;
  vnet.interface = "epair%HOST%b";
  exec.prestart = "/sbin/ifconfig epair%HOST% create";
  exec.prestart += "/sbin/ifconfig epair%HOST%a inet 10.200.%HOST%.1/24 up";
  exec.poststop = "/sbin/ifconfig epair%HOST%a destroy";

  # The jail sets its own address, so clones of a template stay alike
  # and the host never writes into a jail's root.
  exec.start = "/sbin/ifconfig epair%HOST%b inet 10.200.%HOST%.2/24 up";
  exec.start += "/sbin/route add default 10.200.%HOST%.1";
  exec.start += "/sbin/zfs mount -a";
  exec.start += "/bin/sh /etc/rc";
  exec.stop = "/bin/sh /etc/rc.shutdown jail";
  exec.clean;

  # Ruleset 10, from yolo's /etc/devfs.rules, shows a VNET jail's
  # devices and bhyve's.
  mount.devfs;
  devfs_ruleset = 10;
  allow.raw_sockets;

  # Each jail is an agent's workstation, where it has root, so it may do
  # what a host's root may, short of what reaches past the jail: setting
  # yolo's clock, its quotas, serving NFS from its kernel, or reading the
  # kernel's messages, which carry other jails'.
  enforce_statfs = 1;
  allow.mount;
  allow.mount.devfs;
  allow.mount.fdescfs;
  allow.mount.fusefs;
  allow.mount.nullfs;
  allow.mount.procfs;
  allow.mount.tmpfs;
  allow.chflags;
  allow.extattr;
  allow.mlock;
  allow.reserved_ports;
  allow.set_hostname;
  allow.socket_af;
  allow.unprivileged_proc_debug;
  allow.vmm;

  # SysV IPC of its own, as PostgreSQL and others need.
  sysvmsg = new;
  sysvsem = new;
  sysvshm = new;

  # Jails of its own, as poudriere makes one per builder. jail(8) has
  # no unlimited, so allow more than any build will want.
  children.max = 1000;
}
