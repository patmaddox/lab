#!/bin/sh
set -eu

# yolo-jail-clone name template: clone a jail from its template's
# @ready snapshot, unless the jail already exists. jail.conf runs this
# as exec.prepare. Only the admin destroys a jail, to start it over.

[ ${#} -eq 2 ] || { echo "usage: yolo-jail-clone name template" >&2; exit 64; }

readonly dataset=zroot/jails/instances/${1}

if zfs list -H -o name ${dataset} >/dev/null 2>&1; then
	exit 0
fi
exec zfs clone zroot/jails/templates/${2}@ready ${dataset}
