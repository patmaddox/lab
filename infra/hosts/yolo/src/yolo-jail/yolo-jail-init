#!/bin/sh
set -eu

# yolo-jail-init name: set up a jail, as the yolo-jails package's
# instances lists it, so that it starts with nothing left to make. It
# makes its root, with base and its template's package, the
# mountpoints for what jail.conf mounts there, the dataset the jail
# runs itself, the dataset for the jail's own git repos, and those for
# what it keeps across resets. Run it as root on yolo before the jail's
# first start.
#
# It makes only what is missing, so running it again on a jail that
# exists gives the jail whatever a newer yolo-jail adds.

readonly instances=/usr/local/share/yolo-jails/instances
readonly libexec=/usr/local/libexec

usage() {
	echo "usage: yolo-jail-init name" >&2
	exit 64
}

[ ${#} -eq 1 ] || usage
readonly name=${1}

case ${name} in
.*|*[!A-Za-z0-9_-]*) usage ;;
?*) ;;
*) usage ;;
esac

# Each line of instances: jail, template, number, and one or more repos.
line=$(awk -v name=${name} '!/^#/ && $1 == name' ${instances})
if [ -z "${line}" ]; then
	echo "E: no jail ${name} in ${instances}" >&2
	exit 1
fi
# The repos are the rest of the line: one or more.
read -r _ template _ repos <<EOL
${line}
EOL
if [ -z "${repos}" ]; then
	echo "E: jail ${name} has no repo in ${instances}" >&2
	exit 1
fi

# The jail writes its root while it runs, so a directory there could
# turn into a symlink between yolo-jail-create-mountpoints' check and
# its mkdir.
if jls -j ${name} jid >/dev/null 2>&1; then
	echo "E: jail ${name} is running; stop it first" >&2
	exit 1
fi

# The jail's own repos first, since it refuses unless the repos it
# clones exist, and the root takes a while to make.
${libexec}/yolo-jail-git ${name} ${repos}
${libexec}/yolo-jail-data ${name}
${libexec}/yolo-jail-create ${name} ${template}
mountpoints="pkg/yolo git/agent home/agent/.claude"
for repo in ${repos}; do
	mountpoints="${mountpoints} git/${repo}.git"
done
${libexec}/yolo-jail-create-mountpoints ${name} ${mountpoints}

# The ZFS dataset the jail runs itself, under its own, so a reset
# destroys it. jailed is on, so yolo never mounts it.
readonly data=zroot/jails/instances/${name}/data
zfs list -H -o name ${data} >/dev/null 2>&1 ||
    zfs create -o jailed=on -o mountpoint=none ${data}
