#!/bin/sh
set -eu

# Build a jail template: a dataset under zroot/jails/templates with the
# base system, the template's packages and users, and a snapshot @ready
# that jails are cloned from. Run as root on yolo.

readonly share=/usr/local/share/yolo-jail
readonly zroot=zroot/jails
readonly keys=/usr/share/keys/pkgbase-15

usage() {
	echo "usage: yolo-jail-template name" >&2
	exit 64
}

[ ${#} -eq 1 ] || usage
readonly name=${1}
readonly conf=${share}/templates/${name}.conf
readonly dataset=${zroot}/templates/${name}

if [ ! -f ${conf} ]; then
	echo "E: no template ${name} in ${share}/templates" >&2
	exit 1
fi

# The template's conf sets these.
packages=""
users=""
. ${conf}

exists() {
	zfs list -H -o name ${1} >/dev/null 2>&1
}

# Jails are clones of the template's snapshot, so it cannot be rebuilt
# in place while any exist.
if exists ${dataset}; then
	echo "E: ${dataset} exists; destroy it and its clones to rebuild" >&2
	exit 1
fi

# jail.conf finds the jails under /jails/instances.
exists ${zroot} || zfs create -o mountpoint=/jails ${zroot}
exists ${zroot}/templates || zfs create ${zroot}/templates
exists ${zroot}/instances || zfs create ${zroot}/instances
zfs create ${dataset}
root=$(zfs get -H -o value mountpoint ${dataset})
readonly root

trap 'umount ${root}/dev 2>/dev/null || true' EXIT

# Base goes in with --rootdir, from yolo's own repository config. pkg
# reads the signing keys relative to the root, so they go in first.
mkdir -p ${root}${keys}
cp -R ${keys}/ ${root}${keys}/
pkg --rootdir ${root} -o ASSUME_ALWAYS_YES=yes \
    install -r FreeBSD-base FreeBSD-set-base-jail

# The jail tracks the same repositories as yolo and uses its resolvers.
mkdir -p ${root}/usr/local/etc/pkg/repos
cp /usr/local/etc/pkg/repos/FreeBSD.conf ${root}/usr/local/etc/pkg/repos/
cp /etc/resolv.conf ${root}/etc/resolv.conf

# Ports go in with --chroot, so their install scripts run against the
# jail's own tools and accounts.
if [ -n "$(echo ${packages})" ]; then
	mount -t devfs devfs ${root}/dev
	pkg --chroot ${root} -o ASSUME_ALWAYS_YES=yes \
	    install -r FreeBSD-ports ${packages}
	pkg --chroot ${root} clean -q -a -y
	umount ${root}/dev
fi

# The template's own files, from templates/<name>.files, go over the
# root as they are, after the packages so none replaces them.
if [ -d ${share}/templates/${name}.files ]; then
	cp -R ${share}/templates/${name}.files/ ${root}/
fi

# users: one user:uid per line. Each gets a group of the same name and
# id, and unrestricted doas.
echo "${users}" | while IFS=: read -r user uid; do
	[ -n "${user}" ] || continue
	pw -R ${root} groupadd -n ${user} -g ${uid}
	pw -R ${root} useradd -n ${user} -u ${uid} -g ${user} -m -s /bin/sh
	echo "permit nopass keepenv ${user}" >> ${root}/usr/local/etc/doas.conf
done

zfs snapshot ${dataset}@ready
echo "${dataset}@ready"
