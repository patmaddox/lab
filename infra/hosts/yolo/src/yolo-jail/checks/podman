#!/bin/sh
set -eu

# A FreeBSD container, run by podman, on podman's default network, with
# yolo's ocijail. Its run must print nothing to stderr, where ocijail
# reports a mount it could not unmount. It skips a jail whose agent has
# not given podman its storage yet, and pulls the image the first time.

image=docker.io/freebsd/freebsd-runtime:15.1
if ! command -v podman >/dev/null; then
	echo "podman is not installed"
	exit 1
fi
if [ "$(pkg annotate -Sq ocijail repository)" != yolo ]; then
	echo "ocijail is not yolo's"
	exit 1
fi
if ! mount -p 2>/dev/null | awk '$2 == "/var/db/containers" { found = 1 } END { exit !found }'; then
	echo "podman's storage, /var/db/containers, is not set up"
	exit 3
fi
podman pull -q "${image}" >/dev/null
err=$(mktemp)
trap 'rm -f "${err}"' EXIT
out=$(podman run --rm "${image}" /bin/echo yolo-jail-check 2>"${err}")
if [ "${out}" != yolo-jail-check ]; then
	echo "a container printed ${out}"
	exit 1
fi
if [ -s "${err}" ]; then
	echo "a container's run reported:"
	cat "${err}"
	exit 1
fi
