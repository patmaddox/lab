#!/bin/sh
set -eu

# yolo-jail-git name repo ...: make the dataset that holds a jail's own
# git repos, unless it exists. yolo-jail-create-mountpoints makes the
# jail's mountpoints for them. Each repo is <owner>/<repo>, an upstream
# repo /git/<owner>/<repo>.git that the jail clones, which
# yolo-git-init makes. yolo-jail-init runs this.

readonly zroot=zroot/git/jails
# The agent user of the coding-agent template, from its conf.
readonly agent=15000

usage() {
	echo "usage: yolo-jail-git name owner/repo ..." >&2
	exit 64
}

[ ${#} -ge 2 ] || usage
readonly name=${1}
shift

for repo in "${@}"; do
	# jails is where the jails' own repos go, so no owner may take it.
	case ${repo} in
	jails/*|.*|*/.*|*/*/*|*[!A-Za-z0-9._/-]*) usage ;;
	?*/?*) ;;
	*) usage ;;
	esac
	if [ ! -d /git/${repo}.git ]; then
		echo "E: no /git/${repo}.git; make it with yolo-git-init" >&2
		exit 1
	fi
done

exists() {
	zfs list -H -o name ${1} >/dev/null 2>&1
}

exists ${zroot} || zfs create ${zroot}
exists ${zroot}/${name} || zfs create ${zroot}/${name}

# The jail mounts /git/jails/<name> as its /git/agent, where its agent
# makes its repos. Unless the dataset is mounted, that is the root-owned
# directory beneath it, and the agent cannot write there. Check both on
# every run, so running yolo-jail-init again repairs a dataset that was
# made but never mounted or given to the agent. -h, so a symlink is
# never followed, though the jail cannot replace a mountpoint.
[ "$(zfs get -H -o value mounted ${zroot}/${name})" = yes ] ||
    zfs mount ${zroot}/${name}
chown -h ${agent}:${agent} /git/jails/${name}
