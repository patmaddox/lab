#!/bin/sh
set -eu

# yolo-jail-git name repo: make the dataset that holds a jail's own git
# repos, unless it exists, and the jail's mountpoints for its repos.
# repo is <owner>/<repo>, the upstream repo /git/<owner>/<repo>.git
# that the jail clones, which yolo-git-init makes. jail.conf runs this
# as exec.prepare, after the jail is cloned and before jail(8) mounts
# anything.

readonly zroot=zroot/git/jails
# The agent user of the coding-agent template, from its conf.
readonly agent=15000

usage() {
	echo "usage: yolo-jail-git name owner/repo" >&2
	exit 64
}

[ ${#} -eq 2 ] || usage
readonly name=${1} repo=${2}

# jails is where the jails' own repos go, so no owner may take it.
case ${repo} in
jails/*|.*|*/.*|*/*/*|*[!A-Za-z0-9._/-]*) usage ;;
?*/?*) ;;
*) usage ;;
esac

if [ ! -d /git/${repo}.git ]; then
	echo "E: no /git/${repo}.git; make it with yolo-git-init" >&2
	exit 1
fi

exists() {
	zfs list -H -o name ${1} >/dev/null 2>&1
}

exists ${zroot} || zfs create ${zroot}
if ! exists ${zroot}/${name}; then
	zfs create ${zroot}/${name}
	chown ${agent}:${agent} /git/jails/${name}
fi

root=$(zfs get -H -o value mountpoint zroot/jails/instances/${name})
readonly root

# mountpoint path: make path under the jail's root, and each directory
# on the way that is missing. The jail's root writes there, so a
# directory may have become a symlink, and mkdir would follow it out of
# the jail. Refuse those. The jail is not running, so nothing changes
# between the check and the mkdir.
mountpoint() {
	dir=${root}
	for part in $(echo ${1} | tr / ' '); do
		dir=${dir}/${part}
		if [ -L ${dir} ]; then
			echo "E: ${dir} is a symbolic link" >&2
			exit 1
		fi
		[ -d ${dir} ] || mkdir ${dir}
	done
}

mountpoint git/${repo}.git
mountpoint git/agent
