# List the recipes
help:
  just -l

# Build yolo's packages: one per tool in src/, and the jail configs
pkg:
  redo-ifchange $(ls src/*/all.do | sed 's/\.do$//') jails/all

# Packages from elsewhere in lab that the templates depend on
template_deps := "../../../src/claude-repo-docs/claude-repo-docs.pkg"

# Build all packages, templates and their deps too, and sync them to
# /pkg/yolo on yolo
push-pkg: pkg
  redo-ifchange templates/all {{template_deps}}
  ./tools/push-pkg.sh src/*/*.pkg jails/*.pkg templates/*.pkg {{template_deps}}

# Run push-pkg, then install or upgrade yolo's own packages on yolo
install-pkg: push-pkg
  ssh yolo.p7x.dev doas pkg install -y -r yolo $(for p in src/*/*.pkg jails/*.pkg; do pkg query -F $p %n; done)

# Build the BE, import it on yolo, and boot it once at the next reboot
deploy-be:
  redo-ifchange yolo.be.zfs
  ./tools/deploy-be.sh yolo.conf yolo.be.zfs

# Make the upstream repos that repos lists on yolo, and set their branches
git-init:
  ssh yolo.p7x.dev doas yolo-git-init $(awk '!/^#/ && NF { print $1 ":" $2 }' repos)

# Once per yolo, make /pkg/yolo and install yolo's packages from it
pkg-init: pkg && install-pkg
  #!/bin/sh
  set -eu
  if ! ssh yolo.p7x.dev pkg info -q -e yolo-pkg; then
    scp src/yolo-pkg/yolo-pkg.pkg yolo.p7x.dev:/tmp/yolo-pkg.pkg
    ssh yolo.p7x.dev 'doas pkg add /tmp/yolo-pkg.pkg && rm /tmp/yolo-pkg.pkg'
  fi
  ssh yolo.p7x.dev doas yolo-pkg-init

# Upgrade a running jail's template package, or with -a all its packages
upgrade-jail name *flags:
  ssh yolo.p7x.dev doas yolo-jail-upgrade {{flags}} {{name}}

# Upgrade every running jail in jails/instances as upgrade-jail does
upgrade-jails *flags:
  ./tools/upgrade-jails.sh {{flags}}

# Set up a stopped jail, or give it what a newer yolo-jail adds
init-jail name:
  ssh yolo.p7x.dev doas yolo-jail-init {{name}}
