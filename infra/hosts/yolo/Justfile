help:
  just -l

# Build yolo's packages: one per tool in src/, and the jail configs
pkg:
  redo-ifchange $(ls src/*/all.do | sed 's/\.do$//') jails/all

# Copy yolo's packages to /tmp on yolo, named for their versions
push-pkg: pkg
  ./tools/push-pkg.sh src/*/*.pkg jails/*.pkg

# Import the BE on yolo as yolo-<release>-<date>-new, and activate -t it
deploy-be:
  redo-ifchange yolo.be.zfs
  ./tools/deploy-be.sh yolo.conf yolo.be.zfs

# Make the repos that repos lists on yolo, those that are missing, as
# the user you sign in to yolo as, and set their default branches
git-init:
  ssh yolo.p7x.dev doas yolo-git-init $(awk '!/^#/ && NF { print $1 ":" $2 }' repos)
