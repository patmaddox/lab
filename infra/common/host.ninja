src_root = infra/hosts/${host_name}
build_dir = ${src_root}/_build

sync_pw = ./src/sync-pw/sync-pw
build_be_sh = ./infra/scripts/build-be.sh
deploy_sh = ./infra/scripts/deploy.sh

rule packages
  command = ssh -t root@poudriere "poudriere bulk -j ${jail} -p main -f ~/lab.jj/${src_root}/ports" && touch ${out}
  pool = console

rule build-be
  command = ${build_be_sh} ${host_name} ${jail} ~/lab.jj/${src_root}/ports ${out}
  pool = console

build ${build_dir}/packages.${jail}.done: packages | ${src_root}/ports
  jail = ${jail}

build ${ninja_out}/${src_root}/${host_name}.be.zfs: build-be | ${build_dir}/packages.${jail}.done ${build_be_sh}
  jail = ${jail}
