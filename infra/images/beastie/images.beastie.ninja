image_name = beastie
src_root = infra/images/${image_name}
build_dir = ${src_root}/_build
root_dir = ${build_dir}/root
jail = 142
sync_pw = ./src/sync-pw/sync-pw

rule packages
  command = ssh -t root@poudriere "poudriere bulk -j ${jail} -f ~/lab.jj/${src_root}/${image_name}.ports" && touch ${out}
  pool = console

rule build-be
  command = ./${src_root}/scripts/build-be.sh ${image_name} ${jail} ~/lab.jj/${src_root}/${image_name}.ports ${out}
  pool = console

build ${build_dir}/packages.done: packages | ${src_root}/${image_name}.ports
build ${ninja_out}/images/${image_name}-${jail}.be.zfs: build-be | ${build_dir}/packages.done ${src_root}/scripts/build-be.sh

build mod.images.${image_name}: phony ${ninja_out}/images/${image_name}-${jail}.be.zfs

rule deploy
  command = doas env TOOL_SYNC_PW=${sync_pw} ./${src_root}/scripts/deploy.sh ${image_name} ${in} ${tz}
  pool = console

build run.${image_name}.deploy: deploy ${ninja_out}/images/${image_name}-${jail}.be.zfs ${src_root}/dist/dist.mtree ${src_root}/dist/data.mtree
  tz = US/Pacific
