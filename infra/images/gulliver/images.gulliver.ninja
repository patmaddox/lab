image_name = gulliver
src_root = infra/images/${image_name}
build_dir = ${src_root}/_build
root_dir = ${build_dir}/root
sync_pw = ./src/sync-pw/sync-pw

rule packages
  command = ssh -t root@poudriere "poudriere bulk -j ${jail} -f ~/lab.jj/${src_root}/${image_name}.ports" && touch ${out}
  pool = console

rule build-be
  command = ./${src_root}/scripts/build-be.sh ${image_name} ${jail} ~/lab.jj/${src_root}/${image_name}.ports ${out}
  pool = console

rule deploy
  command = doas env TOOL_SYNC_PW=${sync_pw} ./${src_root}/scripts/deploy.sh ${image_name} ${in} ${tz}
  pool = console

# 14.2

build ${build_dir}/packages.142.done: packages | ${src_root}/${image_name}.ports
  jail = 142
  
build ${ninja_out}/images/${image_name}-142.be.zfs: build-be | ${build_dir}/packages.142.done ${src_root}/scripts/build-be.sh
  jail = 142

build mod.images.${image_name}-142: phony ${ninja_out}/images/${image_name}-142.be.zfs

build run.${image_name}-142.deploy: deploy ${ninja_out}/images/${image_name}-142.be.zfs ${src_root}/dist/dist.mtree ${src_root}/dist/data.mtree
  tz = US/Pacific

