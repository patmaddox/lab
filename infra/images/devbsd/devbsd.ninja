src_root = infra/images/devbsd
build_dir = ${src_root}/_build
root_dir = ${build_dir}/root
efi_dir = ${build_dir}/efistage
revision = 15-CURRENT
image_name = devbsd

rule image
     command = cp ${src_root}/_build/${image_name}.zfs ${out}

rule zfs
  command = set -o pipefail && curdir=$$(pwd) && jj file list ${src_root}/dist/zroot | sed -e "s|^|${out}: |" > ${out}.d && cd ${src_root} && ./scripts/build-zfs.sh $${curdir}/${ninja_out}/freebsd-src/${revision} $${curdir}/${out}
  depfile = ${out}.d
  deps = gcc

rule mkdir
  command = mkdir ${out}

rule untar-file
  command = tar -C ${build_dir} -xf ${in} ${file} && mv ${build_dir}/${file} ${out} && touch ${out}

# This is used as the mountpoint for the zfs image
build ${build_dir}/imgroot: mkdir

build ${build_dir}/${image_name}.zfs: zfs | ${src_root}/scripts/build-zfs.sh ${build_dir}/imgroot ${ninja_out}/freebsd-src/${revision}/base.txz ${ninja_out}/freebsd-src/${revision}/kernel.txz
  freebsd_txz = ${ninja_out}/freebsd-src/${revision}

build ${ninja_out}/images/${image_name}-${revision}.zfs: image | ${src_root}/_build/${image_name}.zfs

build mod.images.${image_name}: phony ${ninja_out}/images/${image_name}-${revision}.zfs
build images.${image_name}: phony mod.images.${image_name}
