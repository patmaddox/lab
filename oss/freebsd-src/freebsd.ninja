src_root = src/freebsd-src
out_dir = ${ninja_out}/freebsd-src
git_main = ${src_root}/main.jj
git_tmp = ${src_root}/_build/ninja.tmp.git
build_sh = GIT_MAIN=$${ninja_root}/${git_main} GIT_TMP=$${ninja_root}/${git_tmp} ./scripts/build.sh

rule build-freebsd
  command = ninja_root=$$(pwd) && rm -f ${stampfile} && cd ${src_root} && mkdir -p _build && ${build_sh} ls-files config/${config}.conf | awk -v src_root=${src_root} -v stampfile=${stampfile} '{printf("%s: %s/%s\n", stampfile, src_root, $$1)}' > $${ninja_root}/${depfile} && ${build_sh} build config/${config}.conf && cd $${ninja_root} && for f in ${out}; do cp ${src_root}/_build/${config}/amd64.amd64/release/$$(basename $${f}) ${out_dir}/${config}/; done
  depfile = ${stampfile}.d
  deps = gcc
  pool = console

# auto-generated from config/*.conf

build mod.pkg.freebsd: phony mod.freebsd.main mod.freebsd.15.0 mod.freebsd.14.3 mod.freebsd.14.2 


## 14.2

build ninja-out/freebsd-src/14.2/MANIFEST ninja-out/freebsd-src/14.2/base.txz ninja-out/freebsd-src/14.2/kernel.txz ninja-out/freebsd-src/14.2/src.txz ninja-out/freebsd-src/14.2/tests.txz: build-freebsd | src/freebsd-src/config/14.2.conf src/freebsd-src/scripts/build.sh src/freebsd-src/src.conf
  config = 14.2
  stampfile = src/freebsd-src/_build/14.2.build
build mod.freebsd.14.2: phony ninja-out/freebsd-src/14.2/MANIFEST ninja-out/freebsd-src/14.2/base.txz ninja-out/freebsd-src/14.2/kernel.txz ninja-out/freebsd-src/14.2/src.txz ninja-out/freebsd-src/14.2/tests.txz
build freebsd.14.2: phony mod.freebsd.14.2

