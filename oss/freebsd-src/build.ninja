src_root = oss/freebsd-src
out_dir = ${ninja_out}/${src_root}
git_main = ${src_root}/main.jj
freebsd_src_ninja = ${src_root}/freebsd-src.ninja

rule build-freebsd
  command = CCACHE_CONFIGPATH=${src_root}/ccache.conf GIT_MAIN=${git_main} KERNCONF=${kernconf} SRCCONF=${src_root}/src.conf ${src_root}/scripts/build.sh ${target} ${config} ${src_root}/${tree} ${out_dir}/${config}
  pool = console

# current
config = current
tree = main.jj
kernconf = GENERIC-NODEBUG
include ${freebsd_src_ninja}

# 16.0 - stabweek
config = 16.0
tree = stable-16.jj
kernconf = GENERIC-NODEBUG
include ${freebsd_src_ninja}

# 15.0
config = 15.0
tree = releng-15.0.jj
kernconf = GENERIC
include ${freebsd_src_ninja}
