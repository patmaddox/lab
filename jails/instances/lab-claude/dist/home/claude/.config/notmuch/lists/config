# notmuch profile for the list mail fetched from lab-mail. Use it with
# NOTMUCH_PROFILE=lists; the default profile stays on the jj maildir.
# The database path is explicit, so pointing NOTMUCH_CONFIG here can
# never index this mail into the default profile's database.

[database]
mail_root=/home/claude/mail
path=/home/claude/.local/share/notmuch/lists

[user]
name=claude
primary_email=claude@p7x.dev

[new]
ignore=.uidvalidity;.mbsyncstate;.mbsyncstate.journal;.mbsyncstate.new;.mbsyncstate.lock

[maildir]
synchronize_flags=false
