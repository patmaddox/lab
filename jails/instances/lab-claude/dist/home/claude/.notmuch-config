# .notmuch-config - see notmuch-config(1)
#
# The maildir is the list itself, committed to jj, so notmuch must
# never rename or delete its files.  The database lives outside the
# workspace and flag sync is off.

[database]
mail_root=/home/claude/lab/mail.jj/maildir
path=/home/claude/.notmuch

[user]
name=claude
primary_email=claude@p7x.dev

[new]
tags=new

[search]
exclude_tags=deleted

[maildir]
synchronize_flags=false
