#!/bin/sh
# Pull new list mail from Fastmail into Dovecot.
#
# cron sends the output to the fetch log. mbsync warns on every run
# that it logs in to Dovecot without TLS, which is by design on
# loopback, and prints a line of counts for each run. The job keeps
# the counts only when something moved, and every error.
set -u

readonly creds=/data/secrets/mail-creds

# mbsync would log in with whatever the file holds, so an empty line
# stops the fetch before it starts.
if [ -z "$(sed -n 1p ${creds})" ] || [ -z "$(sed -n 2p ${creds})" ]; then
	echo "${creds} needs the login on line 1 and the password on line 2"
	exit 1
fi

out=$(/usr/local/bin/mbsync -c /usr/local/etc/mbsyncrc list 2>&1)
rc=${?}

printf '%s\n' "${out}" | grep -v \
    -e '^\*\*\* IMAP Warning \*\*\* Password is being sent in the clear$' \
    -e '^$' \
    -e '^Channels: .* Far: +0 \*0 #0 -0 *Near: +0 \*0 #0 -0$'

if [ ${rc} -ne 0 ]; then
	echo "mbsync failed with exit status ${rc}"
else
	# The check reads this file's age to see that fetching works,
	# even while the list is quiet.
	touch /data/mail/mbsync/last-fetch
fi

exit ${rc}
