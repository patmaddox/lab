# Sourced by rc.subr(8) as root when smtprelay starts. The remote
# carries the Fastmail login, so it is built from mail-creds here and
# handed to smtprelay in its environment, never written to a file.
#
# mail-creds holds the login on line 1 and the password on line 2.
# Both are percent-encoded, since an "@", ":", "/" or "#" in them
# would otherwise end its field in the URL. jq is named in full: at
# boot, rc(8) runs with a PATH that leaves out /usr/local/bin.
_login="$(sed -n 1p /data/secrets/mail-creds)"
_password="$(sed -n 2p /data/secrets/mail-creds)"
if [ -z "${_login}" ] || [ -z "${_password}" ]; then
	err 1 "/data/secrets/mail-creds needs the login on line 1" \
	    "and the password on line 2"
fi
SMTPRELAY_REMOTES="smtps://\
$(printf '%s\n' "${_login}" | /usr/local/bin/jq -Rr @uri):\
$(printf '%s\n' "${_password}" | /usr/local/bin/jq -Rr @uri)\
@smtp.fastmail.com:465"
unset _login _password
