readonly name=$(basename $(pwd))
readonly zroot="zroot/jails"
readonly wroot="${zroot}/instances/${name}"

# service(8) finds a jail's config by name in /etc/jail.conf.d.
# install writes it there; start, stop and status drive it from there.
readonly confdir="/etc/jail.conf.d"
readonly installed_conf="${confdir}/${name}.conf"

_is_running() {
	jls -c -j ${name}
}

# Copy the instance config into /etc/jail.conf.d so service(8) can find
# it by name. Nothing else is written: the shared defaults are the
# operator's, in ${confdir}/defaults.conf, and each jail.conf includes
# them itself.
_jail_install() {
	doas cp jail.conf ${installed_conf}
}

# onestart and onestop drive the jail without jail_enable in rc.conf,
# so a jail runs whether or not the operator lists it for boot.
_jail_start() {
	doas service jail onestart ${name}
}

_jail_stop() {
	doas service jail onestop ${name}
}

_jail_status() {
	if _is_running >/dev/null 2>&1; then
		echo "${name}: running"
	else
		echo "${name}: stopped"
	fi
}

_jail_exec() {
	doas jexec -l ${name} "${@}"
}
