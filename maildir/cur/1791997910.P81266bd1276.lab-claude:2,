 .claude/skills/process-email/SKILL.md |  3 +++
 Justfile                              | 16 ++++++++++++++++
 2 files changed, 19 insertions(+)

diff --git a/.claude/skills/process-email/SKILL.md b/.claude/skills/process-email/SKILL.md
index 4a15ea9..172bc32 100644
--- a/.claude/skills/process-email/SKILL.md
+++ b/.claude/skills/process-email/SKILL.md
@@ -28,6 +28,9 @@ Nobody reads your stdout. The result of a pass is what lands on the
 list: a commit on your bookmark, pushed to `submissions`. Put every
 answer, question, and caveat in mail.
 
+Do not notify the operator either. `just process-email` does that after
+each pass, from whether the message left the inbox.
+
 ## Layout
 
 - `~/lab/default.jj` - trunk workspace, where patches are developed.
diff --git a/Justfile b/Justfile
index 3c34602..81b0144 100644
--- a/Justfile
+++ b/Justfile
@@ -88,12 +88,28 @@ process-email:
     just get-up-to-date
     id="$(just get-oldest-inbox-message)"
     [ -n "${id}" ] || break
+    subject="$(notmuch search "${id}" |
+      sed -e 's/^[^;]*; //' -e 's/ ([^()]*)$//')"
     echo "process-email: ${id}"
     claude --permission-mode auto -p "/process-email ${id}" \
       </dev/null >/dev/null
     notmuch new --quiet
     if [ "$(notmuch count "${id} and tag:inbox")" -ne 0 ]; then
       echo "E: process-email: ${id} is still in the inbox" >&2
+      just notify "stuck: ${subject}"
       exit 1
     fi
+    just notify "answered: ${subject}"
   done
+
+# post a message to the operator's ntfy topic, if one is configured
+[positional-arguments]
+notify +message:
+  #!/bin/sh
+  url="${NOTIFY_URL:-}"
+  if [ -z "${url}" ] && [ -r /data/secrets/notify-url ]; then
+    url="$(head -n 1 /data/secrets/notify-url)"
+  fi
+  [ -n "${url}" ] || exit 0
+  curl -fsS -m 10 -o /dev/null -H "Title: process-email" -d "$*" "${url}" ||
+    echo "W: notify: could not post to ntfy" >&2
