new file mode 100644
index 0000000..7e9f1ae
--- /dev/null
+++ b/jails/instances/lab-claude/dist/usr/local/etc/doas.conf
@@ -0,0 +1,3 @@
+# claude may install packages from FreeBSD-ports, and nothing else, as
+# root; see /usr/local/sbin/pkg-install-ports.
+permit nopass claude as root cmd /usr/local/sbin/pkg-install-ports
diff --git a/jails/instances/lab-claude/dist/usr/local/sbin/pkg-install-ports b/jails/instances/lab-claude/dist/usr/local/sbin/pkg-install-ports
new file mode 100755
index 0000000..eeab29d
--- /dev/null
+++ b/jails/instances/lab-claude/dist/usr/local/sbin/pkg-install-ports
@@ -0,0 +1,20 @@
+#!/bin/sh
+#
+# pkg-install-ports -- install packages from the FreeBSD-ports repo.
+#
+# doas runs this as root for the claude user. doas matches a command's
+# arguments exactly, so it cannot permit "pkg install" with arbitrary
+# package names but nothing else. This script is the one command doas
+# allows: it only ever installs from FreeBSD-ports, and "--" keeps the
+# names from being read as pkg options.
+#
+#     doas pkg-install-ports python3 py311-requests
+
+set -eu
+
+if [ "${#}" -eq 0 ]; then
+	echo "usage: ${0##*/} package ..." >&2
+	exit 64
+fi
+
+exec /usr/sbin/pkg install -y -r FreeBSD-ports -- "${@}"
