+# Print the Message-ID of the first version of the series whose cover
+# letter, or only patch, is ${1}. A revision replies to the first
+# version, so follow In-Reply-To up from each revision until reaching
+# a version with no "vN" in its subject. A revision posted as a
+# thread of its own, with no patch above it, is as far as it goes.
+first_version() {
+	local id file parent
+
+	id="$(bare_id "${1}")"
+	while :; do
+		file="$(notmuch search --output=files --duplicate=1 "id:${id}")"
+		[ -n "${file}" ] || die "id:${id}: no such message"
+		is_revision "${file}" || break
+		parent="$(bare_id "$(header in-reply-to "${file}")")"
+		[ -n "${parent}" ] || break
+		file="$(notmuch search --output=files --duplicate=1 \
+		    "id:${parent}")"
+		[ -n "${file}" ] && is_patch "${file}" || break
+		id="${parent}"
+	done
+	echo "${id}"
+}
+
 # Strip id: and angle brackets from a Message-ID.
 bare_id() {
 	local id
@@ -118,6 +142,29 @@ bare_id() {
 	echo "${id%%>*}"
 }
 
+# Print header ${1}, lowercase, of message file ${2}, unfolded.
+header() {
+	awk -v name="${1}:" '
+		/^$/ { exit }
+		/^[ \t]/ { if (on) value = value $0; next }
+		{
+			on = tolower(substr($0, 1, length(name))) == name
+			if (on) value = substr($0, length(name) + 1)
+		}
+		END { sub(/^[ \t]+/, "", value); print value }
+	' "${2}"
+}
+
+# Whether message file ${1} is a patch or cover, "[PATCH ...] ...".
+is_patch() {
+	header subject "${1}" | grep -q '^\['
+}
+
+# Whether message file ${1} is a revision, "[PATCH v2 ...] ...".
+is_revision() {
+	header subject "${1}" | grep -Eq '^\[[^]]* v[0-9]+[] ]'
+}
