@@ -51,6 +74,7 @@ same_sender() {
 }
 
 main() {
+	preflight
 	check "~/.mbsyncrc exists" test -r "${HOME}/.mbsyncrc"
 	check "mbsync logs in to lab-mail and lists ${folders}" lists_folders
 	check "the mail root exists" \
