diff --git a/dotfiles/notmuch/check b/dotfiles/notmuch/check
index 338ae76b..2f0c23b4 100755
--- a/dotfiles/notmuch/check
+++ b/dotfiles/notmuch/check
@@ -8,6 +8,8 @@ set -u
 
 export NOTMUCH_PROFILE=lab-mail
 readonly folders="INBOX Next Later Archive"
+# The commands the checks run, each with the port that installs it.
+readonly commands="mbsync:mail/isync msmtp:mail/msmtp notmuch:mail/notmuch"
 
 failed=0
 
@@ -23,6 +25,27 @@ check() {
 	fi
 }
 
+# preflight: report each command the checks run, and stop if any is
+# missing. Every later check would then fail with its output hidden,
+# which says nothing about the cause.
+preflight() {
+	local c cmd port missing=""
+	for c in ${commands}; do
+		cmd="${c%%:*}" port="${c#*:}"
+		if command -v "${cmd}" >/dev/null 2>&1; then
+			echo "ok ${cmd} is installed"
+		else
+			echo "FAIL ${cmd} is installed (${port})"
+			missing="${missing} ${port##*/}"
+		fi
+	done
+	if [ -n "${missing}" ]; then
+		echo "Install the missing packages and run the check again:" >&2
+		echo "    pkg install${missing}" >&2
+		exit 1
+	fi
+}
+
 # mbsync -l lists the folders the channel would sync, which logs in
 # with the configured password.
