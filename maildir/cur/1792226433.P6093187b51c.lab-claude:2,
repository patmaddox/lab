+#!/usr/bin/awk -f
+# An smtpd-filters(7) filter that refuses, at the end of DATA, a
+# message that is not well formed:
+# - a header line that is neither a field nor the continuation of one;
+# - headers that are not ended by an empty line;
+# - anything other than exactly one From, one Subject, and one
+#   Message-ID.
+#
+# smtpd.conf runs it for every session on the listener. It echoes each
+# line of the message back unchanged, and keeps what it learns about
+# the header in arrays keyed by session.
+
+BEGIN {
+	FS = "|"
+}
+
+$1 == "config" && $2 == "ready" {
+	print "register|filter|smtp-in|data"
+	print "register|filter|smtp-in|data-line"
+	print "register|filter|smtp-in|commit"
+	print "register|report|smtp-in|link-disconnect"
+	print "register|ready"
+	fflush()
+	next
+}
+
+$1 == "report" && $5 == "link-disconnect" {
+	forget($6)
+	next
+}
+
+$1 != "filter" {
+	next
+}
+
+{
+	session = $6
+	token = $7
+}
+
+# A new message: start a fresh header.
+$5 == "data" {
+	forget(session)
+	inheader[session] = 1
+	result(session, token, "proceed")
+	next
+}
+
+$5 == "data-line" {
+	line = payload()
+	print "filter-dataline|" session "|" token "|" line
+	fflush()
+
+	if (line == ".") {
+		if (inheader[session] && fault[session] == "")
+			fault[session] = "the header is not ended by an empty line"
+		inheader[session] = 0
+		next
+	}
+	if (!inheader[session])
+		next
+
+	# The lines arrive dot-escaped.
+	if (line ~ /^\./)
+		line = substr(line, 2)
+
+	if (line == "") {
+		inheader[session] = 0
+	} else if (line ~ /^[ \t]/) {
+		if (!fields[session] && fault[session] == "")
+			fault[session] = "a continuation line comes before any field"
+	} else if (match(line, /^[!-9;-~]+:/)) {
+		fields[session]++
+		name = tolower(substr(line, 1, RLENGTH - 1))
+		count[session, name]++
+	} else if (fault[session] == "") {
+		fault[session] = "a header line is neither a field nor a continuation"
+	}
+	next
+}
+
+$5 == "commit" {
+	why = fault[session]
+	if (why == "")
+		why = once(session, "from", "From")
+	if (why == "")
+		why = once(session, "subject", "Subject")
+	if (why == "")
+		why = once(session, "message-id", "Message-ID")
+	forget(session)
+
+	if (why == "")
+		result(session, token, "proceed")
+	else
+		result(session, token, "reject|550 5.6.0 Malformed message: " why)
+	next
+}
+
+# The data-line payload is the rest of the line after the seventh "|",
+# and may itself hold "|".
+function payload(	s, n) {
+	s = $0
+	for (n = 0; n < 7; n++)
+		s = substr(s, index(s, "|") + 1)
+	return s
+}
+
+function once(s, name, shown,	n) {
+	n = count[s, name] + 0
+	if (n != 1)
+		return "it has " n " " shown " fields, not one"
+	return ""
+}
+
+function result(s, t, decision) {
+	print "filter-result|" s "|" t "|" decision
+	fflush()
+}
+
+function forget(s,	k) {
+	delete inheader[s]
+	delete fields[s]
+	delete fault[s]
+	for (k in count)
+		if (index(k, s SUBSEP) == 1)
+			delete count[k]
+}
