@@ -19,3 +19,14 @@ push:
   jj --quiet git push -b mail --remote jails
   jj --quiet git push -b mail --remote github
   jj --quiet git export
+
+# move mail tagged archive into maildir/archive/
+archive:
+  #!/bin/sh
+  set -eu
+  mkdir -p maildir/archive
+  notmuch search --output=files 'tag:archive and not path:archive/**' |
+  while IFS= read -r f; do
+    mv "${f}" maildir/archive/
+  done
+  notmuch new --quiet

