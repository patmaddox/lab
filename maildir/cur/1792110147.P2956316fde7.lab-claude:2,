@@ -0,0 +1,125 @@
+#!/bin/sh
+
+# PROVIDE: signoz_otel_collector
+# REQUIRE: LOGIN
+# KEYWORD: shutdown
+#
+# Add the following lines to /etc/rc.conf.local or /etc/rc.conf
+# to enable this service:
+#
+# signoz_otel_collector_enable (bool)
+#     Set it to YES to enable signoz_otel_collector
+#     Set to NO by default
+# signoz_otel_collector_user (string)
+#     Set user that signoz_otel_collector will run under
+#     Default is "signoz"
+# signoz_otel_collector_group (string)
+#     Set group that owns signoz_otel_collector files
+#     Default is "signoz"
+# signoz_otel_collector_config (string)
+#     Set full path to the collector config file
+#     Default is "%%ETCDIR%%/config.yaml"
+# signoz_otel_collector_manager_config (string)
+#     Set full path to the OpAMP config file, through which SigNoz
+#     manages the collector
+#     Default is "%%ETCDIR%%/opamp.yaml"
+#     Set to "" to run signoz_otel_collector_config unmanaged
+# signoz_otel_collector_copy_path (string)
+#     Set full path to the copy of the config that SigNoz manages
+#     Default is "/var/db/signoz-otel-collector/config.yaml"
+# signoz_otel_collector_clickhouse_dsn (string)
+#     Set the ClickHouse DSN that the migrate command uses
+#     Default is "tcp://localhost:9000"
+# signoz_otel_collector_pidfile (string)
+#     Set full path to pid file
+#     Default is "/var/run/signoz_otel_collector.pid"
+# signoz_otel_collector_syslog_output_enable (bool)
+#     Set it to NO to disable syslog output
+#     Set to YES by default
+# signoz_otel_collector_syslog_output_tag (str)
+#     Set syslog tag if syslog enabled
+#     Default is "signoz_otel_collector"
+# signoz_otel_collector_syslog_output_priority (string)
+#     Set syslog priority if syslog enabled
+#     Default is "info"
+# signoz_otel_collector_syslog_output_facility (string)
+#     Set syslog facility if syslog enabled
+#     Default is "daemon"
+# signoz_otel_collector_env (string)
+#     Set environment variables used with signoz_otel_collector and its
+#     migrate command, e.g.
+#     "SIGNOZ_OTEL_COLLECTOR_CLICKHOUSE_REPLICATION=false"
+#     Default is ""
+# signoz_otel_collector_args (string)
+#     Set additional command line arguments
+#     Default is ""
+#
+# "service signoz_otel_collector migrate" creates or upgrades the SigNoz
+# schema in ClickHouse.
+
+. /etc/rc.subr
+
+name=signoz_otel_collector
+rcvar=signoz_otel_collector_enable
+
+load_rc_config $name
+
+: ${signoz_otel_collector_enable:="NO"}
+: ${signoz_otel_collector_user:="signoz"}
+: ${signoz_otel_collector_group:="signoz"}
+: ${signoz_otel_collector_config:="%%ETCDIR%%/config.yaml"}
+: ${signoz_otel_collector_manager_config="%%ETCDIR%%/opamp.yaml"}
+: ${signoz_otel_collector_copy_path:="/var/db/signoz-otel-collector/config.yaml"}
+: ${signoz_otel_collector_clickhouse_dsn:="tcp://localhost:9000"}
+: ${signoz_otel_collector_pidfile:="/var/run/signoz_otel_collector.pid"}
+: ${signoz_otel_collector_syslog_output_enable:="YES"}
+: ${signoz_otel_collector_syslog_output_priority:="info"}
+: ${signoz_otel_collector_syslog_output_facility:="daemon"}
+
+if checkyesno signoz_otel_collector_syslog_output_enable; then
+	signoz_otel_collector_syslog_output_flags="-T ${signoz_otel_collector_syslog_output_tag:-${name}} \
+	    -s ${signoz_otel_collector_syslog_output_priority} \
+	    -l ${signoz_otel_collector_syslog_output_facility}"
+fi
+
+required_files="${signoz_otel_collector_config} ${signoz_otel_collector_manager_config}"
+if [ -n "${signoz_otel_collector_manager_config}" ]; then
+	signoz_otel_collector_manager_flags="--manager-config ${signoz_otel_collector_manager_config} \
+	    --copy-path ${signoz_otel_collector_copy_path}"
+fi
+
+pidfile="${signoz_otel_collector_pidfile}"
+procname="%%PREFIX%%/bin/signoz-otel-collector"
+command="/usr/sbin/daemon"
+command_args="-f ${signoz_otel_collector_syslog_output_flags} -p ${pidfile} -t ${name} \
+	/usr/bin/env ${signoz_otel_collector_env} ${procname} \
+	--config ${signoz_otel_collector_config} \
+	${signoz_otel_collector_manager_flags} ${signoz_otel_collector_args}"
+
+start_precmd="signoz_otel_collector_start_precmd"
+extra_commands="migrate"
+migrate_cmd="signoz_otel_collector_migrate"
+
+signoz_otel_collector_start_precmd()
+{
+	if [ ! -e "${pidfile}" ]; then
+		install -m 0600 -o "${signoz_otel_collector_user}" -g "${signoz_otel_collector_group}" /dev/null "${pidfile}"
+	fi
+}
+
+# The steps of upstream's installation guide, in order. ready checks that
+# ClickHouse, its cluster, and ZooKeeper answer; the others skip what is
+# already done.
+signoz_otel_collector_migrate()
+{
+	local _step
+
+	for _step in ready bootstrap "sync up" "async up"; do
+		su -m "${signoz_otel_collector_user}" -c \
+		    "/usr/bin/env ${signoz_otel_collector_env} ${procname} \
+		    migrate ${_step} \
+		    --clickhouse-dsn ${signoz_otel_collector_clickhouse_dsn}" || return 1
+	done
+}
+
+run_rc_command "$1"
