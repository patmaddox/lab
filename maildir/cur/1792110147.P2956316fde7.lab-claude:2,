+PORTNAME=	signoz-otel-collector
+DISTVERSIONPREFIX=	v
+DISTVERSION=	0.144.14
+CATEGORIES=	net-mgmt
+# :sonic_patch is not extracted; post-patch applies it to the sonic tuple.
+MASTER_SITES+=	https://github.com/bytedance/sonic/commit/:sonic_patch
+DISTFILES+=	${SONIC_PATCH}:sonic_patch
+EXTRACT_ONLY=	${_DISTFILES:N*.mod:N${SONIC_PATCH}}
+
+MAINTAINER=	patmaddox@FreeBSD.org
+COMMENT=	SigNoz distribution of the OpenTelemetry Collector
+WWW=		https://github.com/SigNoz/signoz-otel-collector
+
+LICENSE=	AGPLv3
+LICENSE_FILE=	${WRKSRC}/LICENSE
+
+USES=		go:modules
+USE_GITHUB=	nodefault
+# replaces the vendored sonic v1.14.1, which does not build with Go 1.26+
+GH_TUPLE=	bytedance:sonic:v1.15.4:sonic
+USE_RC_SUBR=	signoz_otel_collector
+# MAP_ANON with fd -1, which FreeBSD's mmap(2) requires; in no release yet
+SONIC_PATCH=	bf12ab8c1f789cfbbdfa9d6a4cae69ed136ea516.patch
+
+GO_MODULE=	github.com/SigNoz/signoz-otel-collector
+GO_TARGET=	./cmd/signozotelcollector:${PORTNAME}
+
+SUB_FILES=	pkg-message
+
+USERS=		signoz
+GROUPS=		signoz
+
+# after go-post-extract has vendored the modules upstream pins
+pre-patch:
+	${RM} -r ${WRKSRC}/vendor/github.com/bytedance/sonic
+	${LN} -s ${WRKSRC_sonic} ${WRKSRC}/vendor/github.com/bytedance/sonic
+
+post-patch:
+	${PATCH} -d ${WRKSRC_sonic} -p1 < ${DISTDIR}/${DIST_SUBDIR}/${SONIC_PATCH}
+# the _darwin suffix limits the BSD code to darwin despite its build line;
+# opentelemetry-collector-contrib PR 45680 renames it to filestats_bsd.go
+	${CP} ${WRKSRC}/vendor/github.com/open-telemetry/opentelemetry-collector-contrib/receiver/filestatsreceiver/filestats_darwin.go \
+		${WRKSRC}/vendor/github.com/open-telemetry/opentelemetry-collector-contrib/receiver/filestatsreceiver/filestats_freebsd.go
+# no FreeBSD file; the Linux one also builds here, as in net/redpanda-connect
+	${CP} ${WRKSRC}/vendor/github.com/AthenZ/athenz/libs/go/sia/util/os_util_linux.go \
+		${WRKSRC}/vendor/github.com/AthenZ/athenz/libs/go/sia/util/os_util_freebsd.go
+
+post-install:
+	${MKDIR} ${STAGEDIR}${ETCDIR} ${STAGEDIR}/var/db/signoz-otel-collector
+	${INSTALL_DATA} ${FILESDIR}/config.yaml ${STAGEDIR}${ETCDIR}/config.yaml.sample
+	${INSTALL_DATA} ${WRKSRC}/conf/manager.yaml ${STAGEDIR}${ETCDIR}/opamp.yaml.sample
+
+.include <bsd.port.mk>
