+#!/bin/sh
+# Print the login and app password from mail-creds as URL userinfo,
+# login:password, for smtprelay's remote. The line splits at its
+# first space, and the password is the rest of the line. Both are
+# percent-encoded, so any character in them survives the URL.
+set -eu
+
+LC_ALL=C exec awk '
+BEGIN {
+	for (i = 1; i < 256; i++)
+		ord[sprintf("%c", i)] = i
+}
+
+function encode(s,    out, c, i) {
+	out = ""
+	for (i = 1; i <= length(s); i++) {
+		c = substr(s, i, 1)
+		if (c ~ /[A-Za-z0-9._~-]/)
+			out = out c
+		else
+			out = out sprintf("%%%02X", ord[c])
+	}
+	return out
+}
+
+NR == 1 {
+	done = 1
+	n = index($0, " ")
+	if (n == 0) {
+		print "mail-creds: no space after the login" > "/dev/stderr"
+		exit 1
+	}
+	printf "%s:%s\n", encode(substr($0, 1, n - 1)), encode(substr($0, n + 1))
+}
+
+END {
+	if (!done) {
+		print "mail-creds: empty" > "/dev/stderr"
+		exit 1
+	}
+}
+' /data/secrets/mail-creds
