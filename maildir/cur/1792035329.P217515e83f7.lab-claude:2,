@@ -0,0 +1,14 @@
+FreeBSD mmap(2) fails with EINVAL unless fd is -1 for MAP_ANON, so
+signoz panics at startup.
+
+--- vendor/github.com/bytedance/sonic/loader/mmap_unix.go.orig	2026-10-15 00:02:41 UTC
++++ vendor/github.com/bytedance/sonic/loader/mmap_unix.go
+@@ -31,7 +31,7 @@ func mmap(nb int) uintptr {
+ 
+ 
+ func mmap(nb int) uintptr {
+-    if m, _, e := syscall.RawSyscall6(syscall.SYS_MMAP, 0, uintptr(nb), _RW, _AP, 0, 0); e != 0 {
++    if m, _, e := syscall.RawSyscall6(syscall.SYS_MMAP, 0, uintptr(nb), _RW, _AP, ^uintptr(0), 0); e != 0 {
+         panic(e)
+     } else {
+         return m
