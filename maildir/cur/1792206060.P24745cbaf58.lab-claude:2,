+#!/usr/bin/env atf-sh
+
+atf_init_test_cases() {
+	atf_add_test_case no_args
+	atf_add_test_case unknown_command
+	atf_add_test_case sleeps_between_runs
+	atf_add_test_case default_interval
+	atf_add_test_case stops_on_failure
+	atf_add_test_case no_sleep_while_inbox_has_mail
+	atf_add_test_case exports_conf
+	atf_add_test_case starts_under_daemon
+	atf_add_test_case starts_with_clean_env
+	atf_add_test_case stop_when_not_running
+	atf_add_test_case start_status_stop
+}
+
+# Install the daemon into an install root, root/, with stubs beside it
+# in root/bin, each logging its calls to calls.log. lab-process-mail
+# succeeds until its STUB_FAIL_AT'th run, which exits 1, so every run
+# ends, and takes one message from the inbox, a count in the file
+# inbox, which notmuch reports. sleep only logs, unless
+# STUB_REAL_SLEEP is set.
+setup() {
+	stubdir="${PWD}"
+	ROOT="${PWD}/root"
+	DAEMON="${ROOT}/bin/lab-process-maild"
+	unset LAB_PROCESS_MAILD_INTERVAL STUB_FAIL_AT STUB_REAL_SLEEP
+	mkdir -p "${ROOT}/bin" "${ROOT}/etc"
+	cp "$(atf_get_srcdir)/lab-process-maild" "${DAEMON}"
+
+	cat > "${ROOT}/bin/lab-process-mail" <<-EOF
+	#!/bin/sh
+	echo "run \${STUB_VAR:-}" >> "${stubdir}/calls.log"
+	n="\$(grep -c '^run' "${stubdir}/calls.log")"
+	[ "\${n}" -lt "\${STUB_FAIL_AT:-1}" ] || exit 1
+	n="\$(cat "${stubdir}/inbox")"
+	[ "\${n}" -eq 0 ] || echo "\$((n - 1))" > "${stubdir}/inbox"
+	EOF
+
+	echo 0 > inbox
+	cat > "${ROOT}/bin/notmuch" <<-EOF
+	#!/bin/sh
+	[ "\$*" = "count tag:inbox" ] || exit 1
+	cat "${stubdir}/inbox"
+	EOF
+
+	cat > "${ROOT}/bin/sleep" <<-EOF
+	#!/bin/sh
+	echo "sleep \$*" >> "${stubdir}/calls.log"
+	[ -z "\${STUB_REAL_SLEEP:-}" ] || exec /bin/sleep "\$@"
+	EOF
+
+	chmod +x "${ROOT}"/bin/*
+	export PATH="${ROOT}/bin:${PATH}"
+}
+
+# Stand in for daemon(8): log its arguments and environment, one per
+# line, and do nothing.
+stub_daemon() {
+	cat > "${ROOT}/bin/daemon" <<-EOF
+	#!/bin/sh
+	printf '%s\n' "\$@" > "${stubdir}/daemon.args"
+	env > "${stubdir}/daemon.env"
+	EOF
+	chmod +x "${ROOT}/bin/daemon"
+}
+
+atf_test_case no_args
+no_args_body() {
+	setup
+	atf_check -s exit:1 -e match:"usage" "${DAEMON}"
+	atf_check -s exit:1 test -e calls.log
+}
+
+atf_test_case unknown_command
+unknown_command_body() {
+	setup
+	atf_check -s exit:1 -e match:"usage" "${DAEMON}" restart
+}
+
+atf_test_case sleeps_between_runs
+sleeps_between_runs_body() {
+	setup
+	export STUB_FAIL_AT=3 LAB_PROCESS_MAILD_INTERVAL=7
+	atf_check -s exit:1 -e ignore "${DAEMON}" run
+	printf '%s\n' 'run ' 'sleep 7' 'run ' 'sleep 7' 'run ' > expout
+	atf_check -o file:expout cat calls.log
+}
+
+atf_test_case default_interval
