+#!/bin/sh
+#
+# committed.sh -- report on the list each patch that trunk committed.
+#
+#     committed.sh [revision]
+#
+# A patch is committed when a commit in ::<revision>, trunk by default,
+# carries the same diff: git patch-id --stable gives both the same id.
+# The id hashes the diff alone, so a patch still matches after git am,
+# a rebase, or a reworded message.  All of trunk's history is searched,
+# so a patch is found however long ago it landed.  A patch edited
+# before it was committed gets a new id and is not found.
+#
+# Each committed patch gets a reply in maildir/, to everyone on the
+# patch, naming the commit in its body and the patch in a header:
+#
+#     Committed: <message-id of the patch>
+#
+# A patch that any message on the list already names in a Committed
+# header is skipped, so running this again delivers nothing new.
+# Commit the replies with just commit-mail.
+#
+# Run it from the mail workspace, with notmuch indexing that
+# workspace's maildir.
+
+set -eu
+set -o pipefail
+
+readonly PROGNAME="${0##*/}"
+
+gitdir=""
+rev=""
+tmp=""
+
+err() {
+	echo "${PROGNAME}: ${*}" >&2
+}
+
+die() {
+	err "${@}"
+	exit 1
+}
+
+main() {
+	local head id commit
+	[ "${#}" -le 1 ] || die "usage: ${PROGNAME} [revision]"
+	rev="${1:-trunk}"
+
+	head="$(jj log --no-graph -r "${rev}" -T 'commit_id ++ "\n"')"
+	[ "$(printf '%s\n' "${head}" | wc -l)" -eq 1 ] ||
+	    die "${rev}: not a single commit"
+	gitdir="$(jj git root)"
+
+	tmp="$(mktemp -d "${TMPDIR:-/tmp}/${PROGNAME}.XXXXXX")"
+	trap 'rm -rf "${tmp}"' EXIT
+
+	notmuch new --quiet
+	git --git-dir="${gitdir}" log --no-merges --no-color -p "${head}" -- |
+	    git patch-id --stable | LC_ALL=C sort >"${tmp}/commits"
+	reported | LC_ALL=C sort -u >"${tmp}/reported"
+
+	patch_ids | LC_ALL=C sort |
+	    LC_ALL=C join -o 1.2,2.2 - "${tmp}/commits" |
+	    awk '!seen[$1]++' |
+	    while read -r id commit; do
+		grep -qxF "${id}" "${tmp}/reported" && continue
+		reply "${id}" "${commit}" | deliver
+	done
+}
+
+# "<patch-id> <message-id>" for each patch on the list that carries a
+# diff.  A cover letter has none and is left out.
+patch_ids() {
+	local id pid
+	notmuch search --output=messages \
+	    'subject:"[PATCH" and not path:drafts/**' | while read -r id; do
+		pid="$(notmuch show --format=raw "${id}" |
+		    git patch-id --stable | cut -d' ' -f1)"
+		[ -n "${pid}" ] || continue
+		echo "${pid} ${id#id:}"
+	done
+}
+
+# Message-IDs named in a Committed header anywhere on the list.
+reported() {
+	notmuch search --output=files --format=text0 '*' |
+	    xargs -0 -r awk '
+		FNR == 1 { in_header = 1 }
+		!in_header { next }
+		/^$/ { in_header = 0; next }
+		tolower($0) ~ /^committed:/ && match($0, /<[^>]+>/) {
+			print substr($0, RSTART + 1, RLENGTH - 2)
+		}
+	'
+}
+
+# A reply to all on patch <id>, reporting it committed as <commit>.
+# notmuch reply supplies the addresses and threading; its quote of the
+# patch is dropped.
+reply() {
+	local id commit email
+	id="${1}"
+	commit="${2}"
+	email="$(notmuch config get user.primary_email)"
+
+	notmuch reply --reply-to=all "id:${id}" | awk '/^$/ { exit } 1'
+	echo "Date: $(LC_ALL=C date '+%a, %d %b %Y %H:%M:%S %z')"
+	echo "Message-ID: <$(date +%s).$(openssl rand -hex 6)@${email#*@}>"
+	echo "Committed: <${id}>"
+	echo
+	echo "Committed to ${rev} as:"
+	echo
+	git --git-dir="${gitdir}" log -1 --format='    %H%n    %s' "${commit}"
+}
+
+# Deliver the message on stdin into ${MAILDIR}, maildir/ by default, by
+# way of tmp/ so a reader never sees part of it.
+deliver() {
+	local maildir name
+	maildir="${MAILDIR:-maildir}"
+	name="$(date +%s).P$$R$(openssl rand -hex 4).$(hostname -s)"
+	mkdir -p "${maildir}/tmp" "${maildir}/cur" "${maildir}/new"
+	cat >"${maildir}/tmp/${name}"
+	mv "${maildir}/tmp/${name}" "${maildir}/cur/${name}:2,"
+}
+
+main "${@}"

