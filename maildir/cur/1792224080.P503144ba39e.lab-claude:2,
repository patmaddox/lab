From: claude <claude@p7x.dev>
Subject: [PATCH v2 1/3] libexec/mail: Thread each revision under the one
 before
To: Pat Maddox <pat@patmaddox.com>
Cc: lab-devel@p7x.dev
Change-Id: wqvmplynysnvvysqkslmxyzzpnylqzmw
Date: Sat, 17 Oct 2026 08:01:20 +0000

Each revision of a series opened a thread of its own, so following a
series meant collecting its versions from across the list. Posting
each revision as a reply to the version before it keeps every version
and its review in one thread. The versions form a spine down that
thread, each one beneath the review it answers, so a reader can see
which round of review produced which change.

This was git.git's convention until June 2026, and b4 calls it
"send-same-thread = yes". git.git now replies to the first version
instead, to keep threads shallow on lore's web view, where deep
nesting is hard to read on a phone. That concern does not apply to a
list read in notmuch.

format-patch.sh already has the previous version from --previous, so
it passes that as --in-reply-to. Leaving it to whoever formats the
series would let a revision land in a thread of its own.
---
change-id: wqvmplynysnvvysqkslmxyzzpnylqzmw

 libexec/mail/format-patch.sh | 21 ++++++++++++++++++++-
 1 file changed, 20 insertions(+), 1 deletion(-)

diff --git a/libexec/mail/format-patch.sh b/libexec/mail/format-patch.sh
index f7f30e0b..d1332a22 100755
--- a/libexec/mail/format-patch.sh
+++ b/libexec/mail/format-patch.sh
@@ -32,6 +32,12 @@
 # base and compared with a range-diff instead, since an interdiff
 # across two bases would show everything that landed between them. A
 # reroll without --previous is refused.
+#
+# A revision is posted as a reply to the version before it, so every
+# version of a series and its review stay in one thread, and each
+# version sits under the one whose review it answers. --previous names
+# v(N-1), which becomes the cover's --in-reply-to. Pass --in-reply-to
+# yourself to override it.
 
 set -eu
 set -o pipefail
@@ -48,11 +54,12 @@ die() {
 }
 
 main() {
-	local arg file reroll previous want_reroll base range
+	local arg file reroll previous want_reroll base range in_reply_to
 	reroll=1
 	previous=
 	base=
 	want_reroll=
+	in_reply_to=
 
 	# git lists the files it writes, unless told to be quiet.
 	for arg; do
@@ -67,6 +74,7 @@ main() {
 		-v*) reroll="${arg#-v}" ;;
 		--reroll-count=*) reroll="${arg#*=}" ;;
 		--base=*) base="${arg#*=}" ;;
+		--in-reply-to|--in-reply-to=*) in_reply_to=1 ;;
 		--previous=*) previous="${arg#*=}"; continue ;;
 		esac
 		set -- "${@}" "${arg}"
@@ -91,6 +99,9 @@ main() {
 			    "comparing with a range-diff"
 			set -- "${@}" --range-diff="${range}"
 		fi
+		if [ -z "${in_reply_to}" ]; then
+			set -- "${@}" --in-reply-to="$(bare_id "${previous}")"
+		fi
 	fi
 
 	git format-patch "${@}" | while read -r file; do
@@ -99,6 +110,14 @@ main() {
 	done
 }
 
+# Strip id: and angle brackets from a Message-ID.
+bare_id() {
+	local id
+	id="${1#id:}"
+	id="${id#*<}"
+	echo "${id%%>*}"
+}
+
 # Add the change id of the commit a patch file was made from.  git
 # format-patch names that commit on the file's first line, the mbox
 # "From <sha>" separator.  The cover letter is no commit's patch.
