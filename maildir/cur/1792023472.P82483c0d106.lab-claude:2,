diff --git a/dotfiles/notmuch/hooks/mail-tag.sh b/dotfiles/notmuch/hooks/mail-tag.sh
index 269caaf..9f19511 100755
--- a/dotfiles/notmuch/hooks/mail-tag.sh
+++ b/dotfiles/notmuch/hooks/mail-tag.sh
@@ -2,17 +2,23 @@
 #
 # mail-tag.sh -- derive notmuch tags from the contents of the list.
 #
-# The sent, inbox and replied tags are recomputed from the messages on
-# every run, so the database holds no state of its own: rebuild it from
-# the maildir and the same tags come back.
+# The sent, inbox, replied and superseded tags are recomputed from the
+# messages on every run, so the database holds no state of its own:
+# rebuild it from the maildir and the same tags come back.
 #
-#   sent     from the user (notmuch user.primary_email or other_email)
-#   inbox    from someone else, and the user has not replied to it
-#   replied  from someone else, and the user has replied to it
+#   sent        from the user (notmuch user.primary_email or other_email)
+#   inbox       from someone else, and the user has not replied to it
+#   replied     from someone else, and the user has replied to it
+#   superseded  every message in a series a later version replaces
 #
 # "Replied to" means a message from the user names it in In-Reply-To.
 # Drafts get none of these tags.
 #
+# "Replaces" means the cover letter or lone patch of a revised series
+# names the previous version on a line of its own, outside any quote,
+# as "- Link to vN: id:<message-id>". That message's whole thread is
+# superseded.
+#
 # Runs from the notmuch post-new hook, so notmuch new applies it.
 
 set -eu
@@ -25,12 +31,16 @@ main() {
 	me="$(me_query)"
 
 	{
+		echo "-superseded -- *"
 		echo "-sent -inbox -replied -- ${drafts}"
 		echo "+sent -inbox -replied -- (${me}) and not ${drafts}"
 		echo "-sent +inbox -replied -- not (${me}) and not ${drafts}"
 		replied_ids "${me}" | while read -r id; do
 			echo "+replied -inbox -- id:\"${id}\" and not (${me}) and not ${drafts}"
 		done
+		link_ids | while read -r id; do
+			echo "+superseded -- thread:{id:\"${id}\"} and not ${drafts}"
+		done
 	} | notmuch tag --batch
 }
 
@@ -68,6 +78,23 @@ replied_ids() {
 	' | sort -u
 }
 
+# The Message-ID on each "Link to vN" line, naming the version a
+# revised series replaces. The body is read decoded, so any transfer
+# encoding is undone.
+link_ids() {
+	notmuch search --output=messages "body:\"link to\" and not ${drafts}" |
+	    while read -r id; do
+		notmuch show --format=raw --part=1 "${id}"
+	done | awk '
+		/^[ \t]*-?[ \t]*Link to v[0-9]+[^:]*:[ \t]*id:[^ \t]/ {
+			match($0, /id:[^ \t]+/)
+			id = substr($0, RSTART + 3, RLENGTH - 3)
+			gsub(/^<|>$/, "", id)
+			print id
+		}
+	' | sort -u
+}
+
 die() {
 	echo "${0##*/}: ${*}" >&2
 	exit 1

