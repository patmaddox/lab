+++ b/jails/instances/lab-mail/dist/usr/local/etc/dovecot/dovecot.conf
@@ -48,8 +48,8 @@ passdb {
 }
 
 # Every login, and every LMTP delivery, is the same user, vmail, which
-# owns the maildir. The indexes, the UID lists, and INBOX, where LMTP
-# delivers each post, live in a directory of vmail's own.
+# owns the maildir. The indexes, the UID lists, and an empty INBOX,
+# which IMAP requires, live in a directory of vmail's own.
 userdb {
   driver = static
   args = uid=vmail gid=vmail home=/data/mail/dovecot allow_all_users=yes
@@ -83,8 +83,16 @@ plugin {
   acl_globals_only = yes
 }
 
-# LMTP delivers each posted message to INBOX. The ACL governs IMAP
-# logins, not delivery: only vmail can reach the LMTP socket. Dovecot
-# adds Return-Path and Delivered-To, and no Received header of its
-# own; OpenSMTPD's is enough.
+# A posted message is filed into lists by a Sieve script, since LMTP
+# alone delivers only to INBOX. The ACL governs IMAP logins, not
+# delivery: only vmail can reach the LMTP socket. Dovecot adds
+# Return-Path and Delivered-To, and no Received header of its own;
+# OpenSMTPD's is enough.
+protocol lmtp {
+  mail_plugins = sieve
+}
 lmtp_add_received_header = no
+
+plugin {
+  sieve_before = file:/usr/local/etc/dovecot/lists.sieve;bindir=/data/mail/dovecot/sieve-bin
+}
