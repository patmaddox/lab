@@ -0,0 +1,146 @@
+#!/bin/sh
+#
+# lab-process-maild -- keep the lab-devel inbox answered.
+#
+#	lab-process-maild start		run in the background
+#	lab-process-maild stop		finish the pass in progress and exit
+#	lab-process-maild status	say whether it is running
+#
+# start runs this script's run command under daemon(8), which owns
+# detaching, the log, and the pidfile. run calls lab-process-mail,
+# sleeps, and calls it again, in the foreground, so another supervisor
+# can use it too. lab-process-maild(8) describes the settings.
+#
+# A failed run stops the daemon. When a message is stuck it is still
+# the oldest in the inbox, so running again would only retry it every
+# interval; lab-process-mail has already posted the notice, and the
+# operator starts the daemon again once it is dealt with.
+
+set -eu
+
+readonly PROGNAME="${0##*/}"
+
+err() {
+	echo "E: ${PROGNAME}: ${*}" >&2
+}
+
+die() {
+	err "${@}"
+	exit 1
+}
+
+usage() {
+	die "usage: ${PROGNAME} start | stop | status | run"
+}
+
+running() {
+	pgrep -q -L -F "${pidfile}" 2>/dev/null
+}
+
+start() {
+	! running || die "already running as pid $(cat "${pidfile}")"
+	mkdir -p "$(dirname -- "${logfile}")" "$(dirname -- "${pidfile}")"
+	env -i HOME="${HOME}" USER="${me}" LOGNAME="${me}" \
+	    PATH="${localbase}/bin:/sbin:/bin:/usr/sbin:/usr/bin:/usr/local/sbin:/usr/local/bin" \
+	    daemon -f -H -o "${logfile}" -P "${pidfile}" -t "${PROGNAME}" \
+	    "${self}" run
+}
+
+# daemon(8) passes SIGTERM on to run, which lets the pass in progress
+# finish, so no reply is left half sent.
+stop() {
+	running || die "not running"
+	pkill -L -F "${pidfile}"
+	echo "${PROGNAME}: stopping after the current pass"
+}
+
+status() {
+	running || die "not running"
+	echo "${PROGNAME}: running as pid $(cat "${pidfile}")"
+}
+
+# Wait for a background job to exit, through any signals that interrupt
+# the wait, and return its status.
+reap() {
+	local pid status
+
+	pid="${1}"
+	while :; do
+		status=0
+		wait "${pid}" || status="${?}"
+		kill -0 "${pid}" 2>/dev/null || return "${status}"
+	done
+}
+
+# Run a command in the environment the conf asks for.
+# ${lab_process_maild_env} is split into words, as rc.subr(8) splits
+# ${name}_env, so a value cannot hold a space.
+with_env() {
+	set -f
+	env ${lab_process_maild_env} "${@}"
+	set +f
+}
+
+run() {
+	local status pid stopping
+
+	stopping=
+	trap 'stopping=1' HUP INT TERM
+	while [ -z "${stopping}" ]; do
+		with_env lab-process-mail &
+		status=0
+		reap "${!}" || status="${?}"
+		[ "${status}" -eq 0 ] ||
+		    die "lab-process-mail exited ${status}; stopping"
+		[ -z "${stopping}" ] || break
+
+		sleep "${lab_process_maild_interval}" &
+		pid="${!}"
+		wait "${pid}" || kill "${pid}" 2>/dev/null || :
+	done
+}
+
+# Read the rc.conf(5)-style settings from etc/ under LOCALBASE, the
+# parent of this script's bin/, and fill in the defaults. The log and
+# pidfile go under /var for root and under ${HOME} for anyone else, so
+# both work without a conf.
+configure() {
+	local bindir conf
+
+	bindir="$(CDPATH= cd -- "$(dirname -- "${0}")" && pwd)"
+	self="${bindir}/${PROGNAME}"
+	localbase="$(CDPATH= cd -- "${bindir}/.." && pwd)"
+	localbase="${localbase%/}"
+	me="$(id -un)"
+
+	lab_process_maild_env=
+	lab_process_maild_interval=60
+	if [ "$(id -u)" -eq 0 ]; then
+		lab_process_maild_logfile="/var/log/${PROGNAME}.log"
+		lab_process_maild_pidfile="/var/run/${PROGNAME}.pid"
+	else
+		lab_process_maild_logfile="${HOME}/log/${PROGNAME}.log"
+		lab_process_maild_pidfile="${HOME}/var/run/${PROGNAME}.pid"
+	fi
+
+	conf="${localbase}/etc/${PROGNAME}.conf"
+	[ ! -e "${conf}" ] || . "${conf}"
+
+	logfile="${lab_process_maild_logfile}"
+	pidfile="${lab_process_maild_pidfile}"
+}
+
+main() {
+	[ "${#}" -eq 1 ] || usage
+	case "${1}" in
+	start|stop|status|run)
+		configure
+		"${1}"
+		;;
+	*)
+		usage
+		;;
+	esac
+}
+
+main "${@}"
