+.Dd October 17, 2026
+.Dt LAB-PROCESS-MAILD 8
+.Os
+.Sh NAME
+.Nm lab-process-maild
+.Nd keep the lab-devel inbox answered
+.Sh SYNOPSIS
+.Nm
+.Cm start | stop | status | run
+.Sh DESCRIPTION
+.Nm
+runs
+.Ic lab-process-mail
+over and over, so mail on the lab-devel list is answered without an
+operator running it by hand.
+After each run it sleeps for
+.Va lab_process_maild_interval
+seconds and runs it again.
+.Pp
+The commands are:
+.Bl -tag -width status
+.It Cm start
+Run
+.Nm
+.Cm run
+in the background under
+.Xr daemon 8 ,
+which detaches it, writes its output to the log, and keeps the
+pidfile.
+It creates the directories of the log and the pidfile if they are
+missing.
+The daemon starts from an empty environment, less
+.Ev HOME ,
+.Ev USER ,
+.Ev LOGNAME ,
+and a
+.Ev PATH
+that begins with
+.Pa bin/
+under
+.Va LOCALBASE ,
+so it behaves the same whichever shell started it.
+.It Cm stop
+Let the pass in progress finish, then exit, so a reply is never left
+half sent.
+.It Cm status
+Say whether
+.Nm
+is running, and its pid.
+.It Cm run
+Do the work in the foreground, for
+.Cm start
+or any other supervisor.
+.El
+.Pp
+A run of
+.Ic lab-process-mail
+that fails stops
+.Nm .
+A message that is stuck stays the oldest in the inbox, so running again
+would only retry it every interval.
+.Ic lab-process-mail
+has already sent its notice, and the operator starts
+.Nm
+again once the message is dealt with.
+.Sh CONFIGURATION
+.Nm
+reads its settings from
+.Pa etc/lab-process-maild.conf
+under
+.Va LOCALBASE ,
+the directory above the
+.Pa bin/
+that holds
+.Nm .
+After
+.Ql pkg -r ~/local
+that is
+.Pa ~/local/etc/lab-process-maild.conf .
+The file is optional.
+.Pp
+Like
+.Xr rc.conf 5 ,
+it is a
+.Xr sh 1
+script that sets variables, and those variables are not exported.
+.Bl -tag -width indent
+.It Va lab_process_maild_env
+Environment variables for
+.Ic lab-process-mail ,
+as space-separated
+.Ar name Ns = Ns Ar value
+pairs, like
+.Va ${name}_env
+in
+.Xr rc.subr 8 .
+A value cannot contain a space.
+Default: empty.
+.It Va lab_process_maild_interval
+Seconds to sleep between runs.
+Default: 60.
+.It Va lab_process_maild_logfile
+Where
+.Xr daemon 8
+writes the output of every run.
+Default:
+.Pa /var/log/lab-process-maild.log
+for root, and
+.Pa ~/log/lab-process-maild.log
+for anyone else.
+.It Va lab_process_maild_pidfile
+Where
+.Xr daemon 8
+writes its pid.
+Default:
+.Pa /var/run/lab-process-maild.pid
+for root, and
+.Pa ~/var/run/lab-process-maild.pid
+for anyone else.
+.El
+.Pp
+The log is opened with
+.Fl H ,
+so
+.Xr newsyslog 8
+can rotate it.
+.Sh FILES
+.Bl -tag -width indent
+.It Pa ${LOCALBASE}/etc/lab-process-maild.conf
+Settings.
+.El
+.Sh EXAMPLES
+A conf for an operator who stages work on b/dev and wants a
+notification after each pass:
+.Bd -literal -offset indent
+lab_process_maild_env="LAB_BASE_BRANCH=b/dev@upstream \e
+    NOTIFY_URL=https://ntfy.sh/my-topic"
+.Ed
+.Pp
+Anything else
+.Ic lab-process-mail
+or claude needs from the environment, such as
+.Ev ANTHROPIC_API_KEY ,
+goes in
+.Va lab_process_maild_env
+too.
+.Sh SEE ALSO
+.Xr rc.conf 5 ,
+.Xr daemon 8 ,
+.Xr newsyslog 8 ,
+.Xr rc.subr 8
diff --git a/src/lab-process-mail/lab-process-maild_test b/src/lab-process-mail/lab-process-maild_test
new file mode 100755
index 0000000..7c274ec
--- /dev/null
+++ b/src/lab-process-mail/lab-process-maild_test
@@ -0,0 +1,194 @@
+#!/usr/bin/env atf-sh
+
+atf_init_test_cases() {
+	atf_add_test_case no_args
+	atf_add_test_case unknown_command
+	atf_add_test_case sleeps_between_runs
+	atf_add_test_case default_interval
+	atf_add_test_case stops_on_failure
+	atf_add_test_case env_from_conf
+	atf_add_test_case conf_not_exported
+	atf_add_test_case starts_under_daemon
+	atf_add_test_case files_from_conf
+	atf_add_test_case starts_with_clean_env
+	atf_add_test_case stop_when_not_running
+	atf_add_test_case start_status_stop
+}
+
+# Install the daemon into LOCALBASE, local/, with stubs beside it in
+# local/bin, each logging its calls to calls.log. lab-process-mail
+# succeeds until its STUB_FAIL_AT'th run, which exits 1, so every run
+# ends. sleep only logs, unless the file real-sleep exists. HOME is
+# home/, so the default log and pidfile land there.
+setup() {
+	stubdir="${PWD}"
+	LOCALBASE="${PWD}/local"
+	DAEMON="${LOCALBASE}/bin/lab-process-maild"
+	CONF="${LOCALBASE}/etc/lab-process-maild.conf"
+	export HOME="${PWD}/home"
+	unset STUB_FAIL_AT STUB_VAR
+	mkdir -p "${LOCALBASE}/bin" "${LOCALBASE}/etc" "${HOME}"
+	cp "$(atf_get_srcdir)/lab-process-maild" "${DAEMON}"
+
+	cat > "${LOCALBASE}/bin/lab-process-mail" <<-EOF
+	#!/bin/sh
+	echo "run \${STUB_VAR:-}" >> "${stubdir}/calls.log"
+	n="\$(grep -c '^run' "${stubdir}/calls.log")"
+	[ "\${n}" -lt "\${STUB_FAIL_AT:-1}" ] || exit 1
+	EOF
+
+	cat > "${LOCALBASE}/bin/sleep" <<-EOF
+	#!/bin/sh
+	echo "sleep \$*" >> "${stubdir}/calls.log"
+	[ ! -e "${stubdir}/real-sleep" ] || exec /bin/sleep "\$@"
+	EOF
+
+	chmod +x "${LOCALBASE}"/bin/*
+	export PATH="${LOCALBASE}/bin:${PATH}"
+}
+
+# Stand in for daemon(8): log its arguments and environment, one per
+# line, and do nothing.
+stub_daemon() {
+	cat > "${LOCALBASE}/bin/daemon" <<-EOF
+	#!/bin/sh
+	printf '%s\n' "\$@" > "${stubdir}/daemon.args"
+	env > "${stubdir}/daemon.env"
+	EOF
+	chmod +x "${LOCALBASE}/bin/daemon"
+}
+
+atf_test_case no_args
+no_args_body() {
+	setup
+	atf_check -s exit:1 -e match:"usage" "${DAEMON}"
+	atf_check -s exit:1 test -e calls.log
+}
+
+atf_test_case unknown_command
+unknown_command_body() {
+	setup
+	atf_check -s exit:1 -e match:"usage" "${DAEMON}" restart
+}
+
+atf_test_case sleeps_between_runs
+sleeps_between_runs_body() {
+	setup
+	echo 'lab_process_maild_interval=7' > "${CONF}"
+	export STUB_FAIL_AT=3
+	atf_check -s exit:1 -e ignore "${DAEMON}" run
+	printf '%s\n' 'run ' 'sleep 7' 'run ' 'sleep 7' 'run ' > expout
+	atf_check -o file:expout cat calls.log
+}
+
+atf_test_case default_interval
+default_interval_body() {
+	setup
+	export STUB_FAIL_AT=2
+	atf_check -s exit:1 -e ignore "${DAEMON}" run
+	atf_check -o match:"^sleep 60\$" cat calls.log
+}
+
+atf_test_case stops_on_failure
+stops_on_failure_body() {
+	setup
+	atf_check -s exit:1 -e match:"lab-process-mail exited 1; stopping" \
+	    "${DAEMON}" run
+	atf_check -o inline:"run \n" cat calls.log
+}
+
+atf_test_case env_from_conf
+env_from_conf_body() {
+	setup
+	echo 'lab_process_maild_env="STUB_VAR=from-conf STUB_FAIL_AT=2"' \
+	    > "${CONF}"
+	atf_check -s exit:1 -e ignore "${DAEMON}" run
+	printf '%s\n' 'run from-conf' 'sleep 60' 'run from-conf' > expout
+	atf_check -o file:expout cat calls.log
+}
+
+# Like rc.conf(5), the conf sets variables but exports none; only
+# lab_process_maild_env reaches lab-process-mail.
+atf_test_case conf_not_exported
+conf_not_exported_body() {
+	setup
+	echo 'STUB_VAR=from-conf' > "${CONF}"
+	atf_check -s exit:1 -e ignore "${DAEMON}" run
+	atf_check -o inline:"run \n" cat calls.log
+}
+
+atf_test_case starts_under_daemon
+starts_under_daemon_body() {
+	setup
+	stub_daemon
+	atf_check "${DAEMON}" start
+	atf_check test -d "${HOME}/log"
+	atf_check test -d "${HOME}/var/run"
+	printf '%s\n' -f -H -o "${HOME}/log/lab-process-maild.log" \
+	    -P "${HOME}/var/run/lab-process-maild.pid" \
+	    -t lab-process-maild "${DAEMON}" run > expout
+	atf_check -o file:expout cat daemon.args
+}
+
+atf_test_case files_from_conf
+files_from_conf_body() {
+	setup
+	stub_daemon
+	cat > "${CONF}" <<-EOF
+	lab_process_maild_logfile="${PWD}/logs/maild.log"
+	lab_process_maild_pidfile="${PWD}/run/maild.pid"
+	EOF
+	atf_check "${DAEMON}" start
+	atf_check test -d logs
+	atf_check test -d run
+	printf '%s\n' -f -H -o "${PWD}/logs/maild.log" \
+	    -P "${PWD}/run/maild.pid" \
+	    -t lab-process-maild "${DAEMON}" run > expout
+	atf_check -o file:expout cat daemon.args
+}
+
+atf_test_case starts_with_clean_env
+starts_with_clean_env_body() {
+	setup
+	stub_daemon
+	export STUB_VAR=leaked
+	atf_check "${DAEMON}" start
+	atf_check -s exit:1 grep STUB_VAR daemon.env
+	atf_check -o match:"^HOME=${HOME}\$" cat daemon.env
+	atf_check -o match:"^PATH=${LOCALBASE}/bin:" cat daemon.env
+}
+
+atf_test_case stop_when_not_running
+stop_when_not_running_body() {
+	setup
+	atf_check -s exit:1 -e match:"not running" "${DAEMON}" stop
+	atf_check -s exit:1 -e match:"not running" "${DAEMON}" status
+}
+
+# Under the real daemon(8): start, see it run a pass and sleep, and
+# stop it during the sleep.
+atf_test_case start_status_stop
+start_status_stop_body() {
+	setup
+	touch real-sleep
+	echo 'lab_process_maild_env="STUB_FAIL_AT=100"' > "${CONF}"
+	atf_check "${DAEMON}" start
+	wait_for grep -q '^sleep 60$' calls.log
+	atf_check -o match:"running as pid" "${DAEMON}" status
+	atf_check -s exit:1 -e match:"already running" "${DAEMON}" start
+	atf_check -o match:"stopping" "${DAEMON}" stop
+	wait_for test ! -e "${HOME}/var/run/lab-process-maild.pid"
+	atf_check -s exit:1 -e match:"not running" "${DAEMON}" status
+	atf_check -o inline:"run \nsleep 60\n" cat calls.log
+}
+
+wait_for() {
+	local i
+
+	i=0
+	until "${@}"; do
+		i=$((i + 1))
+		[ "${i}" -lt 50 ] || atf_fail "timed out waiting for: ${*}"
+		/bin/sleep 0.2
+	done
+}
