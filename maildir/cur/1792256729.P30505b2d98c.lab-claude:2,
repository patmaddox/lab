+		jj bookmark set mail -r @-
+		jj git push --remote upstream --bookmark mail
+	) >/dev/null 2>&1 || atf_fail "cannot post to the list"
+	export STUB_ANSWER=1 NOTIFY_URL=https://ntfy.example/topic
+	printf '%s\n' 'lab-process-mail: id:q@x (Buy now): quarantined' \
+	    'lab-process-mail: id:a@x (Hello there)' > expout
+	atf_check -s exit:0 -o file:expout -e ignore "${PROCESS_MAIL}"
+	atf_check -o inline:"1\n" grep -c '^cwd ' claude.log
+	atf_check -o match:"answer is id:a@x" tail -n 1 claude.log
+	atf_check -o match:"quarantined: Buy now \\(inbox 1\\)" cat curl.log
+	atf_check -o inline:"spam\n" cat mail.jj/maildir/quarantine/cur/q@x
+	atf_check -s exit:1 test -e mail.jj/maildir/cur/q@x
+	atf_check -o inline:"mail: Quarantine Buy now" \
+	    jj -R mail.jj log --no-graph -T 'description.first_line()' \
+	    -r "${me}@submissions"
+}
