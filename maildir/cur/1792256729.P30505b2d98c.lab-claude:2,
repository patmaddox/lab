+# Whether a message is from an approved sender. Its From must name
+# exactly one address, and that address must be listed in full; case
+# does not matter.
+from_approved_sender() {
+	local from
+	from="$(notmuch address --output=sender --output=address "${1}")"
+	[ -n "${from}" ] && [ "$(printf '%s\n' "${from}" | wc -l)" -eq 1 ] ||
+	    return 1
+	grep -v -e '^#' -e '^[[:space:]]*$' "${senders}" |
+	    grep -Fxiq -e "${from}"
+}
+
+# Move a message's files into the list's quarantine/ maildir, keeping
+# each in its new/ or cur/, and publish the move on the outbox, so the
+# message leaves the inbox for every reader of the list.
+quarantine() {
+	local id="${1}" subject="${2}" f sub
+	notmuch search --output=files "${id}" | while read -r f; do
+		sub="$(basename -- "$(dirname -- "${f}")")"
+		mkdir -p "${mail}/maildir/quarantine/${sub}"
+		mv -- "${f}" "${mail}/maildir/quarantine/${sub}/"
+	done
+	jj --quiet -R "${mail}" commit -m "mail: Quarantine ${subject}"
+	jj --quiet -R "${mail}" bookmark set "${me}" -r @-
+	jj --quiet -R "${mail}" git push --remote submissions \
+	    --bookmark "${me}"
+	notmuch new --quiet
+}
+
