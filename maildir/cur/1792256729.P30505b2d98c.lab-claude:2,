+			    die "${id} is still in the inbox after quarantine"
+			notify "quarantined: ${subject} (inbox $(inbox_count))"
+			continue
+		fi
 		echo "${PROGNAME}: ${id} (${subject})"
 		(cd "${ws}" &&
