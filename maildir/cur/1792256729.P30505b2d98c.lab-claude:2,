 		subject="$(notmuch search "${id}" |
 		    sed -e 's/^[^;]*; //' -e 's/ ([^()]*)$//')"
+		if ! from_approved_sender "${id}"; then
+			echo "${PROGNAME}: ${id} (${subject}): quarantined"
+			quarantine "${id}" "${subject}"
