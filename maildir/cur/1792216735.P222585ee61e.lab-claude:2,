 # pass runs in its own workspace, ${WORK_WORKSPACE}, or ~/lab/work.jj,
@@ -99,8 +100,8 @@ inbox_count() {
 }
 
 # Post to the operator's ntfy topic. A failed or slow post must not
-# stop the inbox from draining, so this gives up after ten seconds and
-# only warns. Without a topic it does nothing.
+# fail the pass, so this gives up after ten seconds and only warns.
+# Without a topic it does nothing.
 notify() {
 	[ -n "${NOTIFY_URL:-}" ] || return 0
 	curl -fsS -m 10 -o /dev/null -H "Title: ${PROGNAME}" -d "${*}" \
@@ -123,28 +124,26 @@ main() {
 	[ -d "${mail}" ] || die "${mail}: no mail workspace"
 	[ -r "${prompt}" ] || die "${prompt}: no prompt"
 
-	while :; do
-		get_up_to_date
-		prepare_workspace
-		id="$(oldest_inbox_message)"
-		[ -n "${id}" ] || break
-		subject="$(notmuch search "${id}" |
-		    sed -e 's/^[^;]*; //' -e 's/ ([^()]*)$//')"
-		echo "${PROGNAME}: ${id} (${subject})"
-		(cd "${ws}" &&
-		    claude --permission-mode auto -p "$(cat "${prompt}")
+	get_up_to_date
+	prepare_workspace
+	id="$(oldest_inbox_message)"
+	[ -n "${id}" ] || exit 0
+	subject="$(notmuch search "${id}" |
+	    sed -e 's/^[^;]*; //' -e 's/ ([^()]*)$//')"
+	echo "${PROGNAME}: ${id} (${subject})"
+	(cd "${ws}" &&
+	    claude --permission-mode auto -p "$(cat "${prompt}")
 
 Your workspace is ${ws}.
 Your base is ${BASE}.
 The message to answer is ${id}." </dev/null >/dev/null)
-		notmuch new --quiet
-		if [ "$(notmuch count "${id} and tag:inbox")" -ne 0 ]; then
-			err "${id} is still in the inbox"
-			notify "stuck: ${subject} (inbox $(inbox_count))"
-			exit 1
-		fi
-		notify "answered: ${subject} (inbox $(inbox_count))"
-	done
+	notmuch new --quiet
+	if [ "$(notmuch count "${id} and tag:inbox")" -ne 0 ]; then
+		err "${id} is still in the inbox"
+		notify "stuck: ${subject} (inbox $(inbox_count))"
+		exit 1
+	fi
+	notify "answered: ${subject} (inbox $(inbox_count))"
 }
 
 main "${@}"
