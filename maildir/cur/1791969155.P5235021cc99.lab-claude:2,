+readonly groups="
+mailcred:15100
+"
diff --git a/jails/instances/lab-mail/jail.conf b/jails/instances/lab-mail/jail.conf
new file mode 100644
index 0000000..8aa53d9
--- /dev/null
+++ b/jails/instances/lab-mail/jail.conf
@@ -0,0 +1,15 @@
+lab-mail {
+  persist;
+  path = "/jails/instances/lab-mail";
+  ip4 = inherit;
+  host.hostname = "${name}.p7x.dev";
+
+  # Fastmail credentials, owned root:15100 (mailcred) on the host.
+  exec.prepare += "mkdir -p ${path}/data/secrets";
+  mount += "/jails/data/lab-mail/secrets ${path}/data/secrets nullfs ro 0 0";
+
+  # Mail state that must survive a rebuild. The operator creates it on
+  # the host, as with the credentials.
+  exec.prepare += "mkdir -p ${path}/data/mail";
+  mount += "/jails/data/lab-mail/mail ${path}/data/mail nullfs rw 0 0";
+}
