--- /dev/null
+++ b/oss/freebsd-ports/scripts/port-make.sh
@@ -0,0 +1,65 @@
+#!/bin/sh
+# Run make on one port without ever building its dependencies.
+#
+# usage: port-make.sh <ports-tree> <category/port> [target ...]
+#
+# Before make runs, the port's direct dependencies for the requested
+# targets are checked against the installed packages. If any are
+# missing, their origins and a pkg install line are printed and the
+# script exits 2 without running make. STRICT_DEPENDS stays set for
+# the run itself, so a dependency the check missed still stops the
+# build instead of being built from source.
+#
+# Exit status: 0 on success, 1 if make fails, 2 if dependencies are
+# missing.
+set -eu
+
+: ${PORT_VARDIR:=/var/tmp}
+
+main() {
+    if [ $# -lt 2 ]; then
+	echo "usage: port-make.sh <ports-tree> <category/port> [target ...]" >&2
+	exit 1
+    fi
+    tree=$(realpath "${1}"); shift
+    origin=${1}; shift
+    [ $# -gt 0 ] || set -- stage check-plist
+
+    missing=$(missing_depends "$@")
+    if [ -n "${missing}" ]; then
+	echo "${origin}: missing dependencies:"
+	echo "${missing}" | sed -e 's/^/    /'
+	echo "install with:"
+	echo "    pkg install" ${missing}
+	exit 2
+    fi
+
+    portmake "$@" || exit 1
+}
+
+portmake() {
+    make -C "${tree}/${origin}" PORTSDIR="${tree}" BATCH=yes \
+	STRICT_DEPENDS=yes \
+	DISTDIR="${PORT_VARDIR}/freebsd-ports-distfiles" \
+	WRKDIRPREFIX="${PORT_VARDIR}/freebsd-ports-work" \
+	PORT_DBDIR="${PORT_VARDIR}/freebsd-ports-db" "$@"
+}
+
+# Print the origins the targets depend on directly that are not
+# installed. Build dependencies are always needed; run and test
+# dependencies only when the targets include test.
+missing_depends() {
+    lists=build-depends-list
+    for t in "$@"; do
+	if [ "${t}" = test ]; then
+	    lists="${lists} run-depends-list test-depends-list"
+	fi
+    done
+    installed=$(pkg info -aoq)
+    portmake ${lists} | sed -e "s|^${tree}/||" | sort -u | \
+	while read -r dep; do
+	    echo "${installed}" | grep -qxF "${dep}" || echo "${dep}"
+	done
+}
+
+main "$@"
