change-id: otwkzmpmqsmtsvzutwtyonkpmnuvwrzv

 .claude/skills/process-email/SKILL.md |  2 ++
 Justfile                              | 16 ++++++++++++++++
 2 files changed, 18 insertions(+)

diff --git a/.claude/skills/process-email/SKILL.md b/.claude/skills/process-email/SKILL.md
index 56e52d1..0d79d54 100644
--- a/.claude/skills/process-email/SKILL.md
+++ b/.claude/skills/process-email/SKILL.md
@@ -276,6 +276,8 @@ the commits differ, the push failed. Fix it before stopping.
 - Loop: `just process-email` runs one pass per message, oldest first,
   each a fresh `claude -p` given the message's id, until the inbox is
   empty. It stops early if a pass leaves its message in the inbox.
+  After each message it notifies the operator with `just notify`; the
+  pass itself sends no notification.
 
 ## Missing dependencies
 - Do not install missing dependencies
diff --git a/Justfile b/Justfile
index 46558d7..bb3bf3e 100644
--- a/Justfile
+++ b/Justfile
@@ -88,12 +88,28 @@ process-email:
     just get-up-to-date
     id="$(just get-oldest-inbox-message)"
     [ -n "${id}" ] || break
+    subject="$(notmuch search "${id}" |
+      sed -e 's/^[^;]*; //' -e 's/ ([^()]*)$//')"
     echo "process-email: ${id}"
     claude --permission-mode auto -p "/process-email ${id}" \
       </dev/null >/dev/null
     notmuch new --quiet
     if [ "$(notmuch count "${id} and tag:inbox")" -ne 0 ]; then
       echo "process-email: ${id} is still in the inbox" >&2
+      just notify "stuck: ${subject}"
       exit 1
     fi
+    just notify "answered: ${subject}"
   done
+
+# post a message to the operator's ntfy topic, if one is configured
+[positional-arguments]
+notify +message:
+  #!/bin/sh
+  url="${NOTIFY_URL:-}"
+  if [ -z "${url}" ] && [ -r /data/secrets/notify-url ]; then
+    url="$(head -n 1 /data/secrets/notify-url)"
+  fi
+  [ -n "${url}" ] || exit 0
+  curl -fsS -m 10 -o /dev/null -H "Title: process-email" -d "$*" "${url}" ||
+    echo "notify: could not post to ntfy" >&2
