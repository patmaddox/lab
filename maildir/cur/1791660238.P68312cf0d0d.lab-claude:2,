diff --git a/libexec/mail/am.sh b/libexec/mail/am.sh
new file mode 100755
index 0000000..9a6c850
--- /dev/null
+++ b/libexec/mail/am.sh
@@ -0,0 +1,93 @@
+#!/bin/sh
+#
+# am.sh -- git am for a jj workspace, with or without a git repo.
+#
+# Reads one message or an mbox of patches on stdin and applies each to
+# the jj workspace the current directory is in, as its own change with
+# the patch's author, date, and message.  It works in a workspace that
+# has no .git, such as ~/lab/mail.jj, so notmuch can pipe a patch to it
+# from either workspace:
+#
+#     notmuch show --format=raw id:<message-id> | am.sh
+#     notmuch show --format=mbox thread:<id> | am.sh
+#
+# A message without a diff, such as a cover letter or a review reply, is
+# skipped, so a whole series thread can be piped at once.
+#
+# Each patch goes into @, which must be empty, and a new empty change is
+# started on top, the way git am leaves HEAD on the last patch with a
+# clean tree.  A patch that does not apply changes nothing, and am.sh
+# stops there; the patches before it stay applied.
+#
+# git does the mail parsing and patching; neither needs a repo.
+
+set -eu
+set -o pipefail
+
+readonly PROGNAME="${0##*/}"
+
+err() {
+	echo "${PROGNAME}: ${*}" >&2
+}
+
+die() {
+	err "${@}"
+	exit 1
+}
+
+tmp=""
+
+main() {
+	local mail
+
+	cd "$(jj workspace root)"
+
+	tmp="$(mktemp -d "${TMPDIR:-/tmp}/am.XXXXXX")"
+	trap 'rm -rf "${tmp}"' EXIT
+
+	mkdir "${tmp}/mail"
+	git mailsplit -b -o"${tmp}/mail" >/dev/null ||
+	    die "no messages on stdin"
+
+	for mail in "${tmp}"/mail/*; do
+		apply "${mail}"
+	done
+}
+
+# Apply one message as a change in @.
+apply() {
+	local mail subject author email date
+	mail="${1}"
+
+	[ "$(jj log --no-graph -r @ -T empty)" = true ] ||
+	    die "@ is not empty; run jj new first"
+
+	git mailinfo "${tmp}/msg" "${tmp}/patch" <"${mail}" >"${tmp}/info"
+	subject="$(sed -n 's/^Subject: //p' "${tmp}/info")"
+	author="$(sed -n 's/^Author: //p' "${tmp}/info")"
+	email="$(sed -n 's/^Email: //p' "${tmp}/info")"
+	date="$(sed -n 's/^Date: //p' "${tmp}/info")"
+
+	if [ ! -s "${tmp}/patch" ]; then
+		echo "Skipped: ${subject}"
+		return 0
+	fi
+	git apply "${tmp}/patch" || die "${subject}: does not apply"
+
+	{
+		echo "${subject}"
+		if [ -s "${tmp}/msg" ]; then
+			echo
+			cat "${tmp}/msg"
+		fi
+	} >"${tmp}/desc"
+
+	jj metaedit --quiet \
+	    -m "$(cat "${tmp}/desc")" \
+	    --author "${author} <${email}>" \
+	    --author-timestamp "${date}"
+	jj new --quiet
+	echo "Applied: ${subject}"
+}
+
+main "${@}"

