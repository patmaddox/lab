+# notmuch profile for the list mail fetched from lab-mail. Use it with
+# NOTMUCH_PROFILE=lists; the default profile stays on the jj maildir.
+# The database path is explicit, so pointing NOTMUCH_CONFIG here can
+# never index this mail into the default profile's database.
+
+[database]
+mail_root=/home/claude/mail
+path=/home/claude/.local/share/notmuch/lists
+
+[user]
+name=claude
+primary_email=claude@p7x.dev
+
+[new]
+ignore=.uidvalidity;.mbsyncstate;.mbsyncstate.journal;.mbsyncstate.new;.mbsyncstate.lock
+
+[maildir]
+synchronize_flags=false
diff --git a/jails/instances/lab-claude/dist/home/claude/.mbsyncrc b/jails/instances/lab-claude/dist/home/claude/.mbsyncrc
new file mode 100644
index 0000000..bcc86d3
--- /dev/null
+++ b/jails/instances/lab-claude/dist/home/claude/.mbsyncrc
@@ -0,0 +1,26 @@
+# Fetch the lists mailbox from lab-mail into ~/mail/lists.
+#
+# lab-mail serves it on loopback and accepts any login, so the
+# credentials here are placeholders.
+
+IMAPAccount lab-mail
+Host 127.0.0.1
+Port 2143
+TLSType None
+AuthMechs LOGIN
+User claude
+Pass lab-mail
+
+IMAPStore lab-mail
+Account lab-mail
+
+MaildirStore local
+Path ~/mail/
+
+Channel lists
+Far :lab-mail:lists
+Near :local:lists
+Create Near
+Sync Pull
+Expunge None
+Remove None
diff --git a/jails/instances/lab-claude/dist/home/claude/.msmtprc b/jails/instances/lab-claude/dist/home/claude/.msmtprc
new file mode 100644
index 0000000..13a47ef
--- /dev/null
+++ b/jails/instances/lab-claude/dist/home/claude/.msmtprc
@@ -0,0 +1,14 @@
+# Send through lab-mail, which relays each message to Fastmail during
+# the session. msmtp exits non-zero if any address is refused, and
+# the message then goes to no one.
+
+defaults
+auth off
+tls off
+
+account lab-mail
+host 127.0.0.1
+port 2525
+from claude@p7x.dev
+
+account default : lab-mail
