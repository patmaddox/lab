-#!/bin/sh
-# Remove drafts notmuch-emacs has marked deleted, i.e. superseded by a
-# newer save or sent.  Only drafts: the rest of the maildir is the list
-# itself, which a stray deleted tag must never remove.  This runs before
-# notmuch new scans, so the same run drops them from the database.
-notmuch search --format=text0 --output=files 'tag:deleted and path:drafts/**' \
-  | xargs -0 rm -f
diff --git a/dotfiles/notmuch/notmuch-config.sample b/dotfiles/notmuch/notmuch-config.sample
deleted file mode 100644
index 2921e643..00000000
--- a/dotfiles/notmuch/notmuch-config.sample
+++ /dev/null
@@ -1,33 +0,0 @@
-# ~/.notmuch-config for the lab-devel list; see notmuch-config(1).
-# The package installs this as ~/.notmuch-config only if that file does
-# not exist, and never overwrites it.  Fill in [user]; the identity
-# differs on each machine.
-#
-# The maildir is the list itself, committed to jj, so notmuch must
-# never rename its files: flag sync is off.  mail_root is relative to
-# $HOME, and the database takes notmuch's default location.  Hooks come
-# from the package, in notmuch's default hook dir
-# ~/.config/notmuch/default/hooks, so hook_dir is not set.
-
-[database]
-mail_root=lab/mail.jj/maildir
-
-[user]
-name=YOUR NAME
-primary_email=you@example.com
-
-# Tags are derived from the list by the post-new hook, so notmuch new
-# adds none of its own.  Left unset, it would add inbox and unread.
-[new]
-tags=
-
-[search]
-exclude_tags=deleted
-
-# Patches carry their commit's jj change id in a Change-Id header, the
-# same across every version of a patch.  changeid:<id> finds them all.
-[index]
-header.changeid=Change-Id
-
-[maildir]
-synchronize_flags=false
