+#!/bin/sh
+# Install Pat's mail client config for lab-mail from ../mail: the
+# lab-mail notmuch profile's config, ~/.mbsyncrc, and ~/.msmtprc. Run
+# it as Pat, as just install-mail. The repo holds the config, so an
+# installed file that differs is replaced and kept as <file>.old.
+#
+# It also makes the mail root's sent folder, which mbsync never syncs,
+# and an empty password file for Pat to fill in. It never changes a
+# password file that exists.
+set -eu
+
+src="$(dirname "$(realpath "$0")")/../mail"
+root="${HOME}/mail/pat@p7x.dev"
+pwdir="${HOME}/.config/lab-mail"
+pwfile="${pwdir}/password"
+
+install -d "${HOME}/.config/notmuch/lab-mail"
+install -b -C -m 0644 "${src}/notmuch-config" \
+    "${HOME}/.config/notmuch/lab-mail/config"
+install -b -C -m 0600 "${src}/mbsyncrc" "${HOME}/.mbsyncrc"
+install -b -C -m 0600 "${src}/msmtprc" "${HOME}/.msmtprc"
+
+install -d "${root}/sent/cur" "${root}/sent/new" "${root}/sent/tmp"
+
+install -d -m 0700 "${pwdir}"
+if [ ! -e "${pwfile}" ]; then
+	install -m 0600 /dev/null "${pwfile}"
+	echo "Write the password of pat@p7x.dev on lab-mail into ${pwfile}"
+fi
diff --git a/infra/hosts/beastie/mail/mbsyncrc b/infra/hosts/beastie/mail/mbsyncrc
new file mode 100644
index 00000000..af37f078
--- /dev/null
+++ b/infra/hosts/beastie/mail/mbsyncrc
@@ -0,0 +1,34 @@
+# Pat's ~/.mbsyncrc on beastie, installed by just install-mail: sync
+# the list with lab-mail into ~/mail/pat@p7x.dev. It is
+# dotfiles/notmuch/lab-mail/mbsyncrc.sample with Pat's login; see
+# there for what each setting does.
+#
+# pat@p7x.dev may change the list, so the sync runs both ways and
+# expunges on both sides, and Pat's moves and deletions reach
+# lab-mail. The password is in ~/.config/lab-mail/password, which only
+# Pat can read.
+
+IMAPAccount lab-mail
+Host 127.0.0.1
+Port 2143
+TLSType None
+AuthMechs LOGIN
+User pat@p7x.dev
+PassCmd "cat ~/.config/lab-mail/password"
+
+IMAPStore lab-mail
+Account lab-mail
+
+MaildirStore local
+Path ~/mail/pat@p7x.dev/
+Inbox ~/mail/pat@p7x.dev/INBOX
+
+Channel lab-mail
+Far :lab-mail:
+Near :local:
+Patterns INBOX Next Later Archive
+Create Near
+Sync All
+Expunge Both
+Remove None
+CopyArrivalDate yes
