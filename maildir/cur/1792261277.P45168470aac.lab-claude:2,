+# OpenSMTPD for lab-mail; see spec.org.
+#
+# Takes posted mail on loopback and hands mail for the list to Dovecot
+# over LMTP. It never relays, so nothing posted leaves lab-mail except
+# as a message mbsync copies into a Fastmail folder.
+
+# The list, and the known addresses: everyone reads mail for these on
+# the list, so a reply to all lands once, there. To add an address,
+# add it here.
+table list { "lab-devel@p7x.dev" }
+table known { "pat@p7x.dev", "pat@patmaddox.com", "claude@p7x.dev" }
+
+# Delivery to the list runs as vmail, the only user that may connect
+# to Dovecot's LMTP socket. rcpt-to keeps the list's address in the
+# LMTP RCPT TO, so Delivered-To names it.
+table to-vmail { "@" = "vmail" }
+table to-nobody { "@" = "nobody" }
+
+# Loopback on a non-standard port, so only beastie and the jails that
+# share its addresses can reach it, and no tool finds it by default.
+listen on 127.0.0.1 port 2525
+
+action "list" lmtp "/var/run/dovecot/lmtp" rcpt-to virtual <to-vmail>
+action "discard" mda "/bin/cat >/dev/null" virtual <to-nobody>
+
+# Any other recipient matches no rule and is refused with a 5xx reply.
+match from any for rcpt-to <list> action "list"
+match from any for rcpt-to <known> action "discard"
