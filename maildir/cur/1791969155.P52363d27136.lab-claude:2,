diff --git a/jails/instances/lab-mail/dist/etc/rc.conf.d/smtprelay b/jails/instances/lab-mail/dist/etc/rc.conf.d/smtprelay
new file mode 100644
index 0000000..85b8cd2
--- /dev/null
+++ b/jails/instances/lab-mail/dist/etc/rc.conf.d/smtprelay
@@ -0,0 +1,4 @@
+smtprelay_enable="YES"
+# daemon(8) options; they come before the smtprelay command line.
+smtprelay_flags="-u smtprelay -l mail -T smtprelay"
+smtprelay_env_file="/usr/local/etc/smtprelay/remotes.env"
diff --git a/jails/instances/lab-mail/dist/usr/local/etc/smtprelay/remotes.env b/jails/instances/lab-mail/dist/usr/local/etc/smtprelay/remotes.env
new file mode 100644
index 0000000..adb8bae
--- /dev/null
+++ b/jails/instances/lab-mail/dist/usr/local/etc/smtprelay/remotes.env
@@ -0,0 +1,19 @@
+# Sourced by rc.subr(8) as root when smtprelay starts. The remote
+# carries the Fastmail login, so it is built from mail-creds here and
+# handed to smtprelay in its environment, never written to a file.
+#
+# mail-creds holds the login on line 1 and the password on line 2.
+# Both are percent-encoded, since an "@", ":", "/" or "#" in them
+# would otherwise end its field in the URL. jq is named in full: at
+# boot, rc(8) runs with a PATH that leaves out /usr/local/bin.
+_login="$(sed -n 1p /data/secrets/mail-creds)"
+_password="$(sed -n 2p /data/secrets/mail-creds)"
+if [ -z "${_login}" ] || [ -z "${_password}" ]; then
+	err 1 "/data/secrets/mail-creds needs the login on line 1" \
+	    "and the password on line 2"
+fi
+SMTPRELAY_REMOTES="smtps://\
+$(printf '%s\n' "${_login}" | /usr/local/bin/jq -Rr @uri):\
+$(printf '%s\n' "${_password}" | /usr/local/bin/jq -Rr @uri)\
+@smtp.fastmail.com:465"
+unset _login _password
diff --git a/jails/instances/lab-mail/dist/usr/local/etc/smtprelay/smtprelay.ini b/jails/instances/lab-mail/dist/usr/local/etc/smtprelay/smtprelay.ini
new file mode 100644
index 0000000..974ce24
--- /dev/null
+++ b/jails/instances/lab-mail/dist/usr/local/etc/smtprelay/smtprelay.ini
@@ -0,0 +1,20 @@
+; smtprelay for lab-mail; see spec.org.
+;
+; Each message is relayed to Fastmail during the client's session, so
+; the client gets Fastmail's answer. The remote comes from
+; SMTPRELAY_REMOTES; see remotes.env.
+
+hostname = lab-mail.p7x.dev
+log_format = plain
+
+; Loopback on a non-standard port, so only beastie and the jails that
+; share its addresses can reach it, and no tool finds it by default.
+listen = 127.0.0.1:2525
+allowed_nets = 127.0.0.0/8
+
+; Envelope allowlists, checked at MAIL FROM and RCPT TO before
+; Fastmail is contacted. Domains match exactly and without regard to
+; case; p7x.dev does not match its subdomains. To allow an address,
+; add an alternative to the line.
+allowed_sender = (?i)^claude@p7x\.dev$
+allowed_recipients = (?i)^(pat@patmaddox\.com|[^@]+@p7x\.dev|[^@]+@lists\.p7x\.dev)$
