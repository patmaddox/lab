 1 file changed, 60 insertions(+)

diff --git a/dotfiles/emacs/lisp/pm-notmuch.el b/dotfiles/emacs/lisp/pm-notmuch.el
index 42f278a..65cd76d 100644
--- a/dotfiles/emacs/lisp/pm-notmuch.el
+++ b/dotfiles/emacs/lisp/pm-notmuch.el
@@ -79,6 +79,66 @@ Added to `notmuch-show-insert-text/plain-hook'."
 (add-hook 'notmuch-show-insert-text/plain-hook
           #'pm-notmuch-highlight-diff-regions)
 
+;;; Folding org-style headings in notmuch-show
+
+;; Mail is untrusted, so this reads headings with a regexp and folds
+;; them with overlays. It never turns on org-mode for a message:
+;; org-mode has run Lisp and shell commands found in the text it was
+;; turned on for (see Emacs 29.3 and 29.4 NEWS).
+
+(require 'outline)
+
+(defconst pm-notmuch-heading-regexp "^\\(\\*+\\)[ \t]+[^ \t\n]"
+  "Regexp for an org-style heading line; group 1 is its stars.")
+
+(define-button-type 'pm-notmuch-heading
+  'action #'pm-notmuch-toggle-section
+  'follow-link t
+  'help-echo "mouse-1, RET: fold or unfold this section")
+
+(defun pm-notmuch-toggle-section (button)
+  "Fold or unfold the section headed by BUTTON."
+  (let ((ov (button-get button 'pm-notmuch-section)))
+    (overlay-put ov 'invisible
+                 (unless (overlay-get ov 'invisible)
+                   'pm-notmuch-section))))
+
+(defun pm-notmuch-fold-headings (_msg _depth)
+  "Make org-style headings in notmuch text/plain parts fold.
+Each heading becomes a button that hides the text up to the next
+heading of the same or a higher level.
+Added to `notmuch-show-insert-text/plain-hook'."
+  (add-to-invisibility-spec '(pm-notmuch-section . t))
+  (save-excursion
+    (goto-char (point-min))
+    (let (headings)
+      (while (re-search-forward pm-notmuch-heading-regexp nil t)
+        (push (list (match-beginning 0)
+                    (line-end-position)
+                    (- (match-end 1) (match-beginning 1)))
+              headings))
+      (setq headings (nreverse headings))
+      (while headings
+        (pcase-let* ((`(,beg ,eol ,level) (pop headings))
+                     (next (seq-find (lambda (h) (<= (nth 2 h) level))
+                                     headings))
+                     (end (if next
+                              (1- (car next))
+                            (if (eq (char-before (point-max)) ?\n)
+                                (1- (point-max))
+                              (point-max))))
+                     (ov (make-overlay eol (max eol end))))
+          (overlay-put ov 'pm-notmuch-section t)
+          (make-button beg eol
+                       :type 'pm-notmuch-heading
+                       'face (aref outline-font-lock-faces
+                                   (% (1- level)
+                                      (length outline-font-lock-faces)))
+                       'pm-notmuch-section ov))))))
+
+(add-hook 'notmuch-show-insert-text/plain-hook
+          #'pm-notmuch-fold-headings)
+
 ;;; Claude message handling
 
 (defvar pm-notmuch-claude-handle-message-program "claude-handle-message"
