diff --git a/dotfiles/notmuch/hooks/mail-tag.sh b/dotfiles/notmuch/hooks/mail-tag.sh
index 269caaf..842bc7f 100755
--- a/dotfiles/notmuch/hooks/mail-tag.sh
+++ b/dotfiles/notmuch/hooks/mail-tag.sh
@@ -2,17 +2,25 @@
 #
 # mail-tag.sh -- derive notmuch tags from the contents of the list.
 #
-# The sent, inbox and replied tags are recomputed from the messages on
-# every run, so the database holds no state of its own: rebuild it from
-# the maildir and the same tags come back.
+# The sent, inbox, replied and superseded tags are recomputed from the
+# messages on every run, so the database holds no state of its own:
+# rebuild it from the maildir and the same tags come back.
 #
-#   sent     from the user (notmuch user.primary_email or other_email)
-#   inbox    from someone else, and the user has not replied to it
-#   replied  from someone else, and the user has replied to it
+#   sent        from the user (notmuch user.primary_email or other_email)
+#   inbox       from someone else, and the user has not replied to it
+#   replied     from someone else, and the user has replied to it
+#   superseded  every message of a version a later version replaces
 #
 # "Replied to" means a message from the user names it in In-Reply-To.
 # Drafts get none of these tags.
 #
+# "Replaces" means the cover letter or lone patch of a revised series
+# names the previous version on a line of its own, outside any quote,
+# as "- Link to vN: id:<message-id>". That message and every reply
+# below it are superseded, up to the next version: a revision may
+# reply to an earlier version, so one thread can hold them all, and a
+# review of an old version is as stale as the patches it answers.
+#
 # Runs from the notmuch post-new hook, so notmuch new applies it.
 
 set -eu
@@ -25,12 +33,16 @@ main() {
 	me="$(me_query)"
 
 	{
+		echo "-superseded -- *"
 		echo "-sent -inbox -replied -- ${drafts}"
 		echo "+sent -inbox -replied -- (${me}) and not ${drafts}"
 		echo "-sent +inbox -replied -- not (${me}) and not ${drafts}"
 		replied_ids "${me}" | while read -r id; do
 			echo "+replied -inbox -- id:\"${id}\" and not (${me}) and not ${drafts}"
 		done
+		superseded_ids | while read -r id; do
+			echo "+superseded -- id:\"${id}\" and not ${drafts}"
+		done
 	} | notmuch tag --batch
 }
 
@@ -68,6 +80,92 @@ replied_ids() {
 	' | sort -u
 }
 
+# Message-IDs of every message in a replaced version. Each message
+# belongs to the version whose cover letter, or lone patch, is its
+# nearest ancestor by In-Reply-To that starts a version: one a Link
+# line names, or one that carries a Link line. It is superseded if
+# that version is named.
+superseded_ids() {
+	local links
+	links="$(link_pairs)"
+	[ -n "${links}" ] || return 0
+
+	{
+		printf '%s\n' "${links}" | sed 's/^/L /'
+		printf '%s\n' "${links}" | while read -r rev prev; do
+			notmuch search --output=threads "id:\"${prev}\""
+		done | sort -u | while read -r thread; do
+			notmuch search --output=files --duplicate=1 \
+			    --format=text0 "${thread}"
+		done | xargs -0 -r awk "${parent_awk}" | sed 's/^/P /'
+	} | awk '
+		$1 == "L" { start[$2] = 1; start[$3] = 1; old[$3] = 1; next }
+		{ ids[$2] = 1; if (NF > 2) parent[$2] = $3 }
+		END {
+			for (m in ids) {
+				v = m
+				for (n = 0; !(v in start) && (v in parent) &&
+				    n < 1000; n++)
+					v = parent[v]
+				if (v in old)
+					print m
+			}
+		}
+	' | sort
+}
+
+# For each message file, its Message-ID and the one it replies to:
+# In-Reply-To, or failing that the last References entry.
+parent_awk='
+	FNR == 1 { in_header = 1; field = ""; id = irt = refs = "" }
+	!in_header { next }
+	/^$/ {
+		in_header = 0
+		if (irt == "" && match(refs, /<[^>]+>$/))
+			irt = substr(refs, RSTART + 1, RLENGTH - 2)
+		if (id != "")
+			print id, irt
+		next
+	}
+	/^[ \t]/ { value($0); next }
+	{
+		field = tolower($0)
+		sub(/:.*/, "", field)
+		value($0)
+	}
+	function value(s) {
+		if (field == "message-id" && id == "" &&
+		    match(s, /<[^>]+>/))
+			id = substr(s, RSTART + 1, RLENGTH - 2)
+		else if (field == "in-reply-to" && irt == "" &&
+		    match(s, /<[^>]+>/))
+			irt = substr(s, RSTART + 1, RLENGTH - 2)
+		else if (field == "references") {
+			sub(/^[Rr][Ee][Ff][Ee][Rr][Ee][Nn][Cc][Ee][Ss]:/, "", s)
+			sub(/[ \t]+$/, "", s)
+			refs = refs s
+		}
+	}
+'
+
+# Each "Link to vN" line, as the Message-ID of the revision that
+# carries it and the Message-ID of the version it names. The body is
+# read decoded, so any transfer encoding is undone.
+link_pairs() {
+	notmuch search --output=messages "body:\"link to\" and not ${drafts}" |
+	    while read -r id; do
+		notmuch show --format=raw --part=1 "${id}" |
+		    awk -v rev="${id#id:}" '
+			/^[ \t]*-?[ \t]*Link to v[0-9]+[^:]*:[ \t]*id:[^ \t]/ {
+				match($0, /id:[^ \t]+/)
+				id = substr($0, RSTART + 3, RLENGTH - 3)
+				gsub(/^<|>$/, "", id)
+				print rev, id
+			}
+		'
+	done | sort -u
+}
+
 die() {
 	echo "${0##*/}: ${*}" >&2
 	exit 1

