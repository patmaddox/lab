@@ -2,10 +2,9 @@
 	name = claude
 	email = claude@p7x.dev
 [safe]
-	# The shared repos are owned by the host user, so git refuses them
-	# as dubious ownership unless they are marked safe.
+	# The shared repo is owned by the host user, so git refuses it as
+	# dubious ownership unless it is marked safe.
 	directory = /data/lab.git
-	directory = /data/lab-submissions.git
 [sendemail]
 	# Post patch series to the list through lab-mail, from the
 	# address in each patch's From, without asking.
diff --git a/jails/instances/lab-claude/dist/home/claude/bootstrap.sh b/jails/instances/lab-claude/dist/home/claude/bootstrap.sh
index f56492d0..7528eb67 100755
--- a/jails/instances/lab-claude/dist/home/claude/bootstrap.sh
+++ b/jails/instances/lab-claude/dist/home/claude/bootstrap.sh
@@ -1,39 +1,25 @@
 #!/bin/sh
-# Set up the claude user's lab workspaces: lab/default.jj for trunk
-# and lab/mail.jj for the mail list.  Run once after the jail is
-# built; safe to run again.
+# Set up the claude user's lab workspace, lab/default.jj for trunk, and
+# its copy of the list. Run once after the jail is built; safe to run
+# again.
 set -eu
 
 readonly upstream=/data/lab.git
-readonly submissions=/data/lab-submissions.git
 readonly repo=${HOME}/lab/default.jj
-readonly mailws=${HOME}/lab/mail.jj
 
 if [ ! -d ${repo} ]; then
 	mkdir -p $(dirname ${repo})
 	jj git clone --remote upstream ${upstream} ${repo}
-	jj -R ${repo} git remote add submissions ${submissions}
 fi
 
 cd ${repo}
 jj config set --repo 'revset-aliases."trunk()"' trunk@upstream
-jj config set --repo git.push submissions
 jj git fetch --all-remotes
-jj bookmark track trunk@upstream mail@upstream
+jj bookmark track trunk@upstream
 
-if [ ! -d ${mailws} ]; then
-	jj workspace add --name mail -r mail ${mailws}
-fi
-
-# notmuch hooks and config come from the same package as on any
-# developer machine; only the identity is claude's, taken from the
-# .gitconfig installed with the jail.  Set it before the first notmuch
-# new so the first tags are derived for claude.
+# notmuch hooks come from the same package as on any developer
+# machine; the lab-mail profile's config is installed with the jail.
 (cd ${repo}/dotfiles/notmuch && just install)
-notmuch config set user.name "$(git config user.name)"
-notmuch config set user.primary_email "$(git config user.email)"
-
-notmuch new
 
 # mbsync syncs the list into this mail root, which it does not create.
 mkdir -p ${HOME}/mail/claude@p7x.dev
diff --git a/jails/instances/lab-claude/jail.conf b/jails/instances/lab-claude/jail.conf
index 564d94d4..695e861a 100644
