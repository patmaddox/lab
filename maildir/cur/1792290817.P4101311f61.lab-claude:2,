+++ b/jails/instances/lab-claude/jail.conf
@@ -7,9 +7,6 @@ lab-claude {
   exec.prepare += "mkdir -p ${path}/data/lab.git";
   mount += "/jails/share/lab.git ${path}/data/lab.git nullfs ro 0 0";
 
-  exec.prepare += "mkdir -p ${path}/data/lab-submissions.git";
-  mount += "/jails/share/lab-submissions.git ${path}/data/lab-submissions.git nullfs rw 0 0";
-
   allow.mount;
   allow.mount.devfs;
   allow.mount.fdescfs;
diff --git a/jails/instances/lab-mail/spec.org b/jails/instances/lab-mail/spec.org
index d2deeaad..8325776e 100644
--- a/jails/instances/lab-mail/spec.org
+++ b/jails/instances/lab-mail/spec.org
@@ -287,6 +287,8 @@ up the same way and differ only in the login.
   send-email through msmtp, to the list, and saves its reply by Fcc
   into =sent=, so the message it answered is tagged replied as soon
   as the pass ends.
+- No client reads or writes the jj maildir. The =mail= bookmark, the
+  =submissions= remote, and =~/lab/mail.jj= are retired.
 - =just check= in =dotfiles/notmuch=, run as the user on any
   host, checks that login's client before it is used: mbsync logs in
   and lists the list's folders, a dry run of the sync succeeds, the
