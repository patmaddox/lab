+.Dd October 17, 2026
+.Dt LAB-PROCESS-MAILD 8
+.Os
+.Sh NAME
+.Nm lab-process-maild
+.Nd keep the lab-devel inbox answered
+.Sh SYNOPSIS
+.Nm
+.Cm start | stop | status
+.Sh DESCRIPTION
+.Nm
+runs
+.Ic lab-process-mail
+as a service, so mail on the lab-devel list is answered without an
+operator running it by hand.
+.Ic lab-process-mail
+answers the oldest message in the inbox and exits;
+.Xr daemon 8
+runs it again
+.Va lab_process_maild_interval
+seconds after each exit.
+.Pp
+The commands are:
+.Bl -tag -width status
+.It Cm start
+Run
+.Ic lab-process-mail
+under
+.Xr daemon 8 ,
+which detaches it, writes its output to the log, keeps the pidfile,
+and restarts it.
+It creates the directories of the log and the pidfile if they are
+missing.
+.Xr daemon 8
+starts from an empty environment, keeping only
+.Ev HOME ,
+.Ev USER ,
+.Ev LOGNAME ,
+and
+.Ev PATH ,
+plus
+.Va lab_process_maild_env ,
+so it behaves the same whichever shell started it.
+.It Cm stop
+Stop
+.Xr daemon 8 .
+It passes
+.Dv SIGTERM
+on to
+.Ic lab-process-mail ,
+which finishes the pass in progress, so a reply is never left half
+sent.
+.It Cm status
+Say whether
+.Nm
+is running, and its pid.
+.El
+.Pp
+.Xr daemon 8
+runs
+.Ic lab-process-mail
+again whether or not the last run failed, so a transient failure,
+such as a network outage, costs one interval.
+A message that the agent could not answer is not retried: while it is
+still the oldest in the inbox,
+.Ic lab-process-mail
+fails before the agent starts.
+Answering or archiving the message lets the inbox move again, and
+removing
+.Pa ~/var/db/lab-process-mail/stuck
+tries it once more.
+.Sh CONFIGURATION
+.Nm
+reads its settings from
+.Pa etc/lab-process-maild.conf
+under
+.Va LOCALBASE ,
+the directory above the
+.Pa bin/
+that holds
+.Nm .
+After
+.Ql pkg -r ~/local
+that is
+.Pa ~/local/etc/lab-process-maild.conf .
+The file is optional.
+.Pp
+Like
+.Xr rc.conf 5 ,
+it is a
+.Xr sh 1
+script that sets variables, and those variables are not exported.
+.Bl -tag -width indent
+.It Va lab_process_maild_env
+Environment variables for
+.Ic lab-process-mail ,
+as space-separated
+.Ar name Ns = Ns Ar value
+pairs, like
+.Va ${name}_env
+in
+.Xr rc.subr 8 .
+A value cannot contain a space.
+A
+.Ev PATH
+set here replaces the one
+.Nm
+was started with.
+Default: empty.
+.It Va lab_process_maild_interval
+Seconds to wait after each run before the next, given to
+.Xr daemon 8
+as
+.Fl R .
+Default: 60.
+.It Va lab_process_maild_logfile
+Where
+.Xr daemon 8
+writes the output of every run.
+Default:
+.Pa /var/log/lab-process-maild.log
+for root, and
+.Pa ~/log/lab-process-maild.log
+for anyone else.
+.It Va lab_process_maild_pidfile
+Where
+.Xr daemon 8
+writes its pid.
+Default:
+.Pa /var/run/lab-process-maild.pid
+for root, and
+.Pa ~/var/run/lab-process-maild.pid
+for anyone else.
+.El
+.Pp
+The log is opened with
+.Fl H ,
+so
+.Xr newsyslog 8
+can rotate it.
+.Sh FILES
+.Bl -tag -width indent
+.It Pa ${LOCALBASE}/etc/lab-process-maild.conf
+Settings.
+.It Pa ~/var/db/lab-process-mail/stuck
+The message
+.Ic lab-process-mail
+could not answer, if any.
+.El
+.Sh EXAMPLES
+A conf for an operator who stages work on b/dev, wants a notification
+after each pass, and gives the daemon a PATH of its own:
+.Bd -literal -offset indent
+lab_process_maild_env="LAB_BASE_BRANCH=b/dev@upstream \e
+    NOTIFY_URL=https://ntfy.sh/my-topic \e
+    PATH=/bin:/usr/bin:/usr/local/bin"
+.Ed
+.Pp
+Anything else
+.Ic lab-process-mail
+or claude needs from the environment, such as
+.Ev ANTHROPIC_API_KEY ,
+goes in
+.Va lab_process_maild_env
+too.
+.Sh SEE ALSO
+.Xr rc.conf 5 ,
+.Xr daemon 8 ,
+.Xr newsyslog 8 ,
+.Xr rc.subr 8
diff --git a/src/lab-process-mail/lab-process-maild_test b/src/lab-process-mail/lab-process-maild_test
new file mode 100755
index 0000000..0265aa3
--- /dev/null
+++ b/src/lab-process-mail/lab-process-maild_test
@@ -0,0 +1,169 @@
+#!/usr/bin/env atf-sh
+
+atf_init_test_cases() {
+	atf_add_test_case no_args
+	atf_add_test_case unknown_command
+	atf_add_test_case starts_under_daemon
+	atf_add_test_case settings_from_conf
+	atf_add_test_case starts_with_clean_env
+	atf_add_test_case env_from_conf
+	atf_add_test_case conf_not_exported
+	atf_add_test_case stop_when_not_running
+	atf_add_test_case start_status_stop
+}
+
+# Install the daemon into LOCALBASE, local/, with a lab-process-mail
+# stub beside it that logs each run, and ${STUB_VAR} if set, to
+# calls.log and exits ${STUB_EXIT}, or 0. HOME is home/, so the default
+# log and pidfile land there.
+setup() {
+	stubdir="${PWD}"
+	LOCALBASE="${PWD}/local"
+	DAEMON="${LOCALBASE}/bin/lab-process-maild"
+	CONF="${LOCALBASE}/etc/lab-process-maild.conf"
+	export HOME="${PWD}/home"
+	unset STUB_EXIT STUB_VAR
+	mkdir -p "${LOCALBASE}/bin" "${LOCALBASE}/etc" "${HOME}"
+	cp "$(atf_get_srcdir)/lab-process-maild" "${DAEMON}"
+
+	cat > "${LOCALBASE}/bin/lab-process-mail" <<-EOF
+	#!/bin/sh
+	echo "run \${STUB_VAR:-}" >> "${stubdir}/calls.log"
+	exit "\${STUB_EXIT:-0}"
+	EOF
+	chmod +x "${LOCALBASE}/bin/lab-process-mail"
+}
+
+# Stand in for daemon(8), found through ${PATH}: log its arguments and
+# environment, less the PWD its shell sets, one per line, and do
+# nothing.
+stub_daemon() {
+	mkdir -p bin
+	cat > bin/daemon <<-EOF
+	#!/bin/sh
+	printf '%s\n' "\$@" > "${stubdir}/daemon.args"
+	/usr/bin/env | /usr/bin/grep -v '^PWD=' > "${stubdir}/daemon.env"
+	EOF
+	chmod +x bin/daemon
+	export PATH="${PWD}/bin:${PATH}"
+}
+
+atf_test_case no_args
+no_args_body() {
+	setup
+	atf_check -s exit:1 -e match:"usage" "${DAEMON}"
+}
+
+atf_test_case unknown_command
+unknown_command_body() {
+	setup
+	atf_check -s exit:1 -e match:"usage" "${DAEMON}" run
+}
+
+# daemon(8) runs lab-process-mail itself, and runs it again a minute
+# after each exit.
+atf_test_case starts_under_daemon
+starts_under_daemon_body() {
+	setup
+	stub_daemon
+	atf_check "${DAEMON}" start
+	atf_check test -d "${HOME}/log"
+	atf_check test -d "${HOME}/var/run"
+	printf '%s\n' -f -H -o "${HOME}/log/lab-process-maild.log" \
+	    -P "${HOME}/var/run/lab-process-maild.pid" -R 60 \
+	    -t lab-process-maild "${LOCALBASE}/bin/lab-process-mail" > expout
+	atf_check -o file:expout cat daemon.args
+}
+
+atf_test_case settings_from_conf
+settings_from_conf_body() {
+	setup
+	stub_daemon
+	cat > "${CONF}" <<-EOF
+	lab_process_maild_interval=7
+	lab_process_maild_logfile="${PWD}/logs/maild.log"
+	lab_process_maild_pidfile="${PWD}/run/maild.pid"
+	EOF
+	atf_check "${DAEMON}" start
+	atf_check test -d logs
+	atf_check test -d run
+	printf '%s\n' -f -H -o "${PWD}/logs/maild.log" \
+	    -P "${PWD}/run/maild.pid" -R 7 \
+	    -t lab-process-maild "${LOCALBASE}/bin/lab-process-mail" > expout
+	atf_check -o file:expout cat daemon.args
+}
+
+atf_test_case starts_with_clean_env
+starts_with_clean_env_body() {
+	setup
+	stub_daemon
+	export STUB_VAR=leaked
+	atf_check "${DAEMON}" start
+	printf '%s\n' "HOME=${HOME}" "LOGNAME=$(id -un)" "PATH=${PATH}" \
+	    "USER=$(id -un)" > expout
+	atf_check -o file:expout sort daemon.env
+}
+
+# lab_process_maild_env adds to the environment, and can replace PATH;
+# daemon(8) is still found through the PATH lab-process-maild ran with.
+atf_test_case env_from_conf
+env_from_conf_body() {
+	setup
+	stub_daemon
+	echo 'lab_process_maild_env="STUB_VAR=from-conf PATH=/nowhere"' \
+	    > "${CONF}"
+	atf_check "${DAEMON}" start
+	atf_check -o match:"^STUB_VAR=from-conf\$" cat daemon.env
+	atf_check -o match:"^PATH=/nowhere\$" cat daemon.env
+}
+
+# Like rc.conf(5), the conf sets variables but exports none; only
+# lab_process_maild_env reaches the daemon.
+atf_test_case conf_not_exported
+conf_not_exported_body() {
+	setup
+	stub_daemon
+	echo 'STUB_VAR=from-conf' > "${CONF}"
+	atf_check "${DAEMON}" start
+	atf_check -s exit:1 grep STUB_VAR daemon.env
+}
+
+atf_test_case stop_when_not_running
+stop_when_not_running_body() {
+	setup
+	atf_check -s exit:1 -e match:"not running" "${DAEMON}" stop
+	atf_check -s exit:1 -e match:"not running" "${DAEMON}" status
+}
+
+# Under the real daemon(8): start, see lab-process-mail run again after
+# a run that fails, and stop it.
+atf_test_case start_status_stop
+start_status_stop_body() {
+	setup
+	cat > "${CONF}" <<-EOF
+	lab_process_maild_interval=1
+	lab_process_maild_env="STUB_VAR=from-conf STUB_EXIT=1"
+	EOF
+	atf_check "${DAEMON}" start
+	wait_for 'test "$(grep -c . calls.log 2>/dev/null)" -ge 2'
+	atf_check -o match:"running as pid" "${DAEMON}" status
+	atf_check -s exit:1 -e match:"already running" "${DAEMON}" start
+	atf_check -o match:"stopping" "${DAEMON}" stop
+	wait_for 'test ! -e "${HOME}/var/run/lab-process-maild.pid"'
+	atf_check -s exit:1 -e match:"not running" "${DAEMON}" status
+	atf_check -o match:"^run from-conf\$" cat calls.log
+	n="$(grep -c . calls.log)"
+	sleep 2
+	atf_check -o inline:"${n}\n" grep -c . calls.log
+}
+
+wait_for() {
+	local i
+
+	i=0
+	until eval "${*}"; do
+		i=$((i + 1))
+		[ "${i}" -lt 50 ] || atf_fail "timed out waiting for: ${*}"
+		sleep 0.2
+	done
+}
