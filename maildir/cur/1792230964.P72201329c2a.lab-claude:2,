index 1007da74..b4e9f585 100755
--- a/jails/libexec/_jail.log.do
+++ b/jails/libexec/_jail.log.do
@@ -27,6 +27,7 @@ readonly PKGBASE_CONF="${jailsdir}/share/pkgbase.conf"
 readonly PORTS_CONF="${jailsdir}/share/FreeBSD-ports.conf"
 readonly PKGBASE_PACKAGES="${pkgbase_sets:-FreeBSD-set-base-jail} ${pkgbase_extras:-}"
 readonly PACKAGES="${packages:-}"
+readonly PKG_CACHE="/jails/cache/pkg"
 
 # global vars created by functions
 # rootdir
@@ -68,6 +69,7 @@ install_freebsd() {
 
 	doas mkdir -p ${rootdir}${keys}
 	tar -C ${keys} -cf - . | doas tar -C ${rootdir}${keys} -xf -
+	mount_pkg_cache
 	doas pkg -r ${rootdir} -C ${PKGBASE_CONF} install -r FreeBSD-base -y ${PKGBASE_PACKAGES}
 
 	if [ ! -f ${rootdir}/etc/resolv.conf ]; then
@@ -82,6 +84,7 @@ install_freebsd() {
 		doas pkg -c ${rootdir} install -y ${PACKAGES}
 		verify_packages
 	fi
+	umount_pkg_cache
 
 	# The goredo package installs only goredo itself, which creates
 	# the redo commands as symlinks to it.  It runs with a clean
@@ -94,6 +97,21 @@ install_freebsd() {
 	fi
 }
 
+# Both pkg -r and pkg -c keep their cache under the jail root, which
+# starts empty on every build, so each build would fetch every package
+# again. Lend the root a host cache shared by all instances for the
+# length of the install, then take it back so the jail never sees it.
+mount_pkg_cache() {
+	doas mkdir -p ${PKG_CACHE} ${rootdir}/var/cache/pkg
+	doas mount -t nullfs ${PKG_CACHE} ${rootdir}/var/cache/pkg
+	trap umount_pkg_cache EXIT
+}
+
+umount_pkg_cache() {
+	trap - EXIT
+	doas umount ${rootdir}/var/cache/pkg
+}
+
