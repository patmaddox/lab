-	new_line="$("${NOTMUCH}" search --output=messages -- "${newref}" \
-	    | head -1)"
-	[ -n "${new_line}" ] || die "cannot find superseding message: ${newref}"
-	new_bare="${new_line#id:}"
-	new_subject="$(msg_subject "id:${new_bare}")"
-
-	last_line="$("${NOTMUCH}" search --output=messages \
-	    --sort=newest-first -- "thread:{${query}}" | head -1)"
-	[ -n "${last_line}" ] || die "no messages match: ${query}"
-	last_bare="${last_line#id:}"
-
-	move_thread superseded "${query}"
-
-	# The breadcrumb rides in superseded/ alongside the versions it
-	# points at, delivered through the same agent as any other mail.
-	compose_breadcrumb "id:${last_bare}" "${new_subject}" "${new_bare}" \
-	    | MAILDIR="${root}/superseded" "${MAILDIR_DELIVER}"
-}
-
 # Return the notmuch mail root, where the folders live.
 mail_root() {
 	local root
@@ -143,7 +93,7 @@ mail_root() {
 
 valid_folder() {
 	case "${1}" in
-	accepted | rejected | superseded | archive)
+	accepted | rejected | archive)
 		return 0
 		;;
 	*)
@@ -152,65 +102,4 @@ valid_folder() {
 	esac
 }
 
-# Build a one-line breadcrumb reply to REPLY_TO pointing at the new
-# version.  notmuch reply supplies the threading headers off the old
-# thread.  We add a Date and Message-ID and the one-line body.
-compose_breadcrumb() {
-	local reply_to="${1}"; shift
-	local new_subject="${1}"; shift
-	local new_bare="${1}"; shift
-	local hdrs subject from to inreplyto references
-
-	hdrs="$("${NOTMUCH}" reply --format=json --reply-to=sender -- \
-	    "${reply_to}")"
-	subject="$(reply_header "${hdrs}" Subject)"
-	from="$(reply_header "${hdrs}" From)"
-	to="$(reply_header "${hdrs}" To)"
-	inreplyto="$(reply_header "${hdrs}" In-reply-to)"
-	references="$(reply_header "${hdrs}" References)"
-
-	printf 'From: %s\n' "${from}"
-	if [ -n "${to}" ]; then
-		printf 'To: %s\n' "${to}"
-	fi
-	printf 'Subject: %s\n' "${subject}"
-	printf 'Date: %s\n' "$(date '+%a, %d %b %Y %H:%M:%S %z')"
-	printf 'Message-ID: %s\n' "$(new_msgid)"
-	if [ -n "${inreplyto}" ]; then
-		printf 'In-Reply-To: %s\n' "${inreplyto}"
-	fi
-	if [ -n "${references}" ]; then
-		printf 'References: %s\n' "${references}"
-	fi
-	printf 'MIME-Version: 1.0\n'
-	printf 'Content-Type: text/plain\n'
-	printf '\n'
-	printf 'Superseded by %s <%s>\n' "${new_subject}" "${new_bare}"
-}
-
-reply_header() {
-	local hdrs="${1}"; shift
-	local key="${1}"; shift
-	printf '%s' "${hdrs}" \
-	    | jq -r --arg k "${key}" '.["reply-headers"][$k] // empty'
-}
-
-msg_subject() {
-	local id="${1}"; shift
-	"${NOTMUCH}" show --format=json --body=false -- "${id}" \
-	    | jq -r '.. | objects | select(.match == true)
-	             | .headers.Subject' \
-	    | head -1
-}
-
-new_msgid() {
-	printf '<mailfile.%s.%s.%s@%s>' \
-	    "$(date +%s)" "$$" "$(rand)" \
-	    "$(hostname -s 2>/dev/null || hostname)"
-}
-
-rand() {
-	od -An -N3 -tx1 /dev/urandom | tr -d ' \n'
-}
-
 main "${@}"
