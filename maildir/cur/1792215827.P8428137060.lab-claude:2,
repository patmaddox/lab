@@ -16,27 +16,19 @@
 #     mail-file accepted   thread:0000000000000abc
 #     mail-file rejected   id:patch@example.com
 #     mail-file archive    thread:0000000000000abc
-#     mail-file superseded thread:<old> id:<new-version>
-#
-# Moving to superseded also drops a one-line breadcrumb reply on the
-# old thread naming the version that supersedes it.  The superseding
-# message is required, so the breadcrumb is never forgotten.
 #
 # The move is idempotent.  A file already in the target folder is left
 # alone, and a stale path that notmuch still lists before the next new
 # run is skipped once its source is gone.
 #
-# Override the notmuch binary with NOTMUCH and the delivery agent with
-# MAILDIR_DELIVER.
+# Override the notmuch binary with NOTMUCH.
 
 set -eu
 
 readonly PROGNAME="${0##*/}"
-readonly SCRIPT_DIR="$(dirname "$(realpath "$0")")"
 
 : "${NOTMUCH:=notmuch}"
-: "${MAILDIR_DELIVER:=${SCRIPT_DIR}/../../libexec/mail/maildir-deliver.sh}"
-readonly NOTMUCH MAILDIR_DELIVER
+readonly NOTMUCH
 
 err() {
 	echo "${PROGNAME}: ${*}" >&2
@@ -49,29 +41,16 @@ die() {
 
 usage() {
 	echo "usage: ${PROGNAME} accepted|rejected|archive query" >&2
-	echo "       ${PROGNAME} superseded query superseded-by" >&2
 	exit 1
 }
 
 main() {
-	local folder query superseded_by
-	[ "${#}" -ge 2 ] || usage
