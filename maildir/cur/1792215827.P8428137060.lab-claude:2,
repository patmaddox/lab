+	[ "${#}" -eq 2 ] || usage
 	folder="${1}"; shift
 	query="${1}"; shift
 	valid_folder "${folder}" || die "unknown folder: ${folder}"
-
-	if [ "${folder}" = superseded ]; then
-		[ "${#}" -ge 1 ] || \
-		    die "superseded requires a superseding message"
-		superseded_by="${1}"; shift
-	fi
-	[ "${#}" -eq 0 ] || usage
-
-	if [ "${folder}" = superseded ]; then
-		supersede "${query}" "${superseded_by}"
-	else
-		move_thread "${folder}" "${query}"
-	fi
+	move_thread "${folder}" "${query}"
 }
 
 # Move every file in the thread matching QUERY into FOLDER's cur/.
@@ -103,35 +82,6 @@ move_thread() {
 	done
 }
 
-# Move a thread to superseded and post the breadcrumb reply.
-supersede() {
-	local query="${1}"; shift
-	local newref="${1}"; shift
-	local root new_line new_bare new_subject last_line last_bare
-
-	root="$(mail_root)"
-
-	# Resolve the superseding message and the old thread's newest
