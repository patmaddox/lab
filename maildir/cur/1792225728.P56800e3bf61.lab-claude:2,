change-id: wqvmplynysnvvysqkslmxyzzpnylqzmw

 libexec/mail/format-patch.sh | 68 +++++++++++++++++++++++++++++++++++-
 1 file changed, 67 insertions(+), 1 deletion(-)

diff --git a/libexec/mail/format-patch.sh b/libexec/mail/format-patch.sh
index f7f30e0b..79aa3a3d 100755
--- a/libexec/mail/format-patch.sh
+++ b/libexec/mail/format-patch.sh
@@ -32,6 +32,12 @@
 # base and compared with a range-diff instead, since an interdiff
 # across two bases would show everything that landed between them. A
 # reroll without --previous is refused.
+#
+# A revision is posted as a reply to the first version, as git.git
+# has recommended since June 2026, so every version of a series and
+# its review stay in one thread. --previous names v(N-1); its
+# In-Reply-To chain leads back to v1, which becomes the cover's
+# --in-reply-to. Pass --in-reply-to yourself to override it.
 
 set -eu
 set -o pipefail
@@ -48,11 +54,12 @@ die() {
 }
 
 main() {
-	local arg file reroll previous want_reroll base range
+	local arg file reroll previous want_reroll base range in_reply_to
 	reroll=1
 	previous=
 	base=
 	want_reroll=
+	in_reply_to=
 
 	# git lists the files it writes, unless told to be quiet.
 	for arg; do
@@ -67,6 +74,7 @@ main() {
 		-v*) reroll="${arg#-v}" ;;
 		--reroll-count=*) reroll="${arg#*=}" ;;
 		--base=*) base="${arg#*=}" ;;
+		--in-reply-to|--in-reply-to=*) in_reply_to=1 ;;
 		--previous=*) previous="${arg#*=}"; continue ;;
 		esac
 		set -- "${@}" "${arg}"
@@ -91,6 +99,10 @@ main() {
 			    "comparing with a range-diff"
 			set -- "${@}" --range-diff="${range}"
 		fi
+		if [ -z "${in_reply_to}" ]; then
+			in_reply_to="$(first_version "${previous}")"
+			set -- "${@}" --in-reply-to="${in_reply_to}"
+		fi
 	fi
 
 	git format-patch "${@}" | while read -r file; do
@@ -99,6 +111,60 @@ main() {
 	done
 }
 
+# Print the Message-ID of the first version of the series whose cover
+# letter, or only patch, is ${1}. A revision replies to the first
+# version, so follow In-Reply-To up from each revision until reaching
+# a version with no "vN" in its subject. A revision posted as a
+# thread of its own, with no patch above it, is as far as it goes.
+first_version() {
+	local id file parent
+
+	id="$(bare_id "${1}")"
+	while :; do
+		file="$(notmuch search --output=files --duplicate=1 "id:${id}")"
+		[ -n "${file}" ] || die "id:${id}: no such message"
+		is_revision "${file}" || break
+		parent="$(bare_id "$(header in-reply-to "${file}")")"
+		[ -n "${parent}" ] || break
+		file="$(notmuch search --output=files --duplicate=1 \
+		    "id:${parent}")"
+		[ -n "${file}" ] && is_patch "${file}" || break
+		id="${parent}"
+	done
+	echo "${id}"
+}
+
+# Strip id: and angle brackets from a Message-ID.
+bare_id() {
+	local id
+	id="${1#id:}"
+	id="${id#*<}"
+	echo "${id%%>*}"
+}
+
+# Print header ${1}, lowercase, of message file ${2}, unfolded.
+header() {
+	awk -v name="${1}:" '
+		/^$/ { exit }
+		/^[ \t]/ { if (on) value = value $0; next }
+		{
+			on = tolower(substr($0, 1, length(name))) == name
+			if (on) value = substr($0, length(name) + 1)
+		}
+		END { sub(/^[ \t]+/, "", value); print value }
+	' "${2}"
+}
+
+# Whether message file ${1} is a patch or cover, "[PATCH ...] ...".
+is_patch() {
+	header subject "${1}" | grep -q '^\['
+}
+
+# Whether message file ${1} is a revision, "[PATCH v2 ...] ...".
+is_revision() {
+	header subject "${1}" | grep -Eq '^\[[^]]* v[0-9]+[] ]'
+}
+
 # Add the change id of the commit a patch file was made from.  git
 # format-patch names that commit on the file's first line, the mbox
 # "From <sha>" separator.  The cover letter is no commit's patch.
