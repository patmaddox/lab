diff --git a/jails/instances/lab-mail/dist/usr/local/etc/mbsyncrc b/jails/instances/lab-mail/dist/usr/local/etc/mbsyncrc
new file mode 100644
index 0000000..59f76b6
--- /dev/null
+++ b/jails/instances/lab-mail/dist/usr/local/etc/mbsyncrc
@@ -0,0 +1,28 @@
+# Pull new mail from the Fastmail folder lists into a local maildir.
+#
+# Only new messages move, and only from Fastmail to here: nothing is
+# sent back, and nothing is removed from the maildir. A message
+# deleted or moved on Fastmail stays here.
+
+IMAPAccount fastmail
+Host imap.fastmail.com
+Port 993
+TLSType IMAPS
+UserCmd "sed -n 1p /data/secrets/mail-creds"
+PassCmd "sed -n 2p /data/secrets/mail-creds"
+
+IMAPStore fastmail
+Account fastmail
+
+MaildirStore local
+Path /data/mail/maildir/
+
+Channel lists
+Far :fastmail:lists
+Near :local:lists
+Create Near
+Sync Pull New
+Expunge None
+Remove None
+CopyArrivalDate yes
+SyncState /data/mail/mbsync/
diff --git a/jails/instances/lab-mail/dist/usr/local/libexec/lab-mail/fetch b/jails/instances/lab-mail/dist/usr/local/libexec/lab-mail/fetch
new file mode 100755
index 0000000..5fefd74
--- /dev/null
+++ b/jails/instances/lab-mail/dist/usr/local/libexec/lab-mail/fetch
@@ -0,0 +1,18 @@
+#!/bin/sh
+# Pull new list mail from Fastmail, then let Dovecot read it.
+#
+# mbsync creates mail mode 0600 and folders 0700, whatever the umask.
+# Dovecot reads the maildir as vmail, which must not be able to write
+# it, so the new files are opened up for reading after each pull.
+set -u
+
+readonly maildir=/data/mail/maildir
+
+rc=0
+/usr/local/bin/mbsync -q -c /usr/local/etc/mbsyncrc lists || rc=${?}
+
+find ${maildir} \
+    \( -type d ! -perm -0055 -exec chmod go+rx {} + \) -o \
+    \( -type f ! -perm -0044 -exec chmod go+r {} + \)
+
+exit ${rc}
