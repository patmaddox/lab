+#!/bin/sh
+#
+# applied.sh -- find the patches on the list that a range of commits applied.
+#
+#     applied.sh <revision range> [notmuch query]
+#
+# Prints one line per patch whose diff a commit in the range carries:
+#
+#     <message-id> <commit>
+#
+# A patch and its commit match when git patch-id --stable gives them
+# the same id.  That id hashes the diff alone, ignoring whitespace,
+# line numbers, and the commit message, so a patch still matches after
+# git am, a rebase, or a reworded message.  A patch edited before it
+# was applied gets a new id and does not match.
+#
+# The change id cannot tie them instead: git am drops it, and the
+# applied commit gets a new one.
+#
+# The range is git's, e.g. upstream/trunk~20..upstream/trunk.  The
+# query picks the messages to check, all patches on the list by
+# default.  A cover letter carries no diff and never matches.
+
+set -eu
+set -o pipefail
+
+readonly PROGNAME="${0##*/}"
+
+commits=""
+
+err() {
+	echo "${PROGNAME}: ${*}" >&2
+}
+
+die() {
+	err "${@}"
+	exit 1
+}
+
+usage() {
+	die "usage: ${PROGNAME} <revision range> [notmuch query]"
+}
+
+main() {
+	local range query
+	[ "${#}" -ge 1 ] && [ "${#}" -le 2 ] || usage
+	range="${1}"
+	query="${2:-subject:\"[PATCH\"}"
+
+	commits="$(mktemp "${TMPDIR:-/tmp}/${PROGNAME}.XXXXXX")"
+	trap 'rm -f "${commits}"' EXIT
+
+	git log --no-merges --no-color -p "${range}" -- |
+	    git patch-id --stable | LC_ALL=C sort >"${commits}"
+
+	patch_ids "${query}" | LC_ALL=C sort |
+	    LC_ALL=C join -o 1.2,2.2 - "${commits}"
+}
+
+# "<patch-id> <message-id>" for each message the query matches that
+# carries a diff.
+patch_ids() {
+	local query id pid
+	query="${1}"
+
+	notmuch search --output=messages "${query}" | while read -r id; do
+		pid="$(notmuch show --format=raw "${id}" |
+		    git patch-id --stable | cut -d' ' -f1)"
+		[ -n "${pid}" ] || continue
+		echo "${pid} ${id#id:}"
+	done
+}
+
+main "${@}"

