+PORTNAME=	resend-cli
+DISTVERSION=	2.23.0
+CATEGORIES=	mail
+MASTER_SITES=	https://registry.npmjs.org/${PORTNAME}/-/
+
+MAINTAINER=	patmaddox@FreeBSD.org
+COMMENT=	Command line interface for the Resend email API
+WWW=		https://resend.com/docs/cli \
+		https://github.com/resend/resend-cli
+
+LICENSE=	MIT
+LICENSE_FILE=	${WRKSRC}/LICENSE
+
+USES=		nodejs:run tar:tgz
+
+NO_ARCH=	yes
+NO_BUILD=	yes
+
+SUB_FILES=	resend
+SUB_LIST=	NODE=${LOCALBASE}/bin/node
+
+WRKSRC=		${WRKDIR}/package
+
+PLIST_FILES=	bin/resend \
+		libexec/${PORTNAME}/cli.cjs
+
+do-install:
+	${MKDIR} ${STAGEDIR}${PREFIX}/libexec/${PORTNAME}
+	${INSTALL_DATA} ${WRKSRC}/dist/cli.cjs \
+		${STAGEDIR}${PREFIX}/libexec/${PORTNAME}
+	${INSTALL_SCRIPT} ${WRKDIR}/resend ${STAGEDIR}${PREFIX}/bin
+
+.include <bsd.port.mk>
