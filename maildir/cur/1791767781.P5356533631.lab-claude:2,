diff --git a/mail/resend-cli/pkg-message b/mail/resend-cli/pkg-message
new file mode 100644
index 000000000000..25d2abb1d443
--- /dev/null
+++ b/mail/resend-cli/pkg-message
@@ -0,0 +1,17 @@
+[
+{ type: install
+  message: <<EOM
+resend sends anonymous usage telemetry to Resend by default. To disable
+it, set DO_NOT_TRACK=1 or RESEND_TELEMETRY_DISABLED=1 in the
+environment.
+
+On FreeBSD, credentials saved with "resend login" are stored in a
+plaintext file under the user's home directory; the secure storage
+backends support only macOS, Linux, and Windows. Set RESEND_API_KEY in
+the environment instead to avoid storing the key on disk.
+
+Rendering React Email templates (--react-email) requires the esbuild
+Node.js module, which this package does not provide.
+EOM
+}
+]

