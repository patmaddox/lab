+#!/bin/sh
+# Updates come from the package, not from the upstream installer that
+# the CLI's update notice recommends.
+: ${RESEND_NO_UPDATE_NOTIFIER:=1}
+export RESEND_NO_UPDATE_NOTIFIER
+exec %%NODE%% %%PREFIX%%/libexec/resend-cli/cli.cjs "$@"
