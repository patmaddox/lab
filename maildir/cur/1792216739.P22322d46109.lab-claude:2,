+
+wait_for() {
+	local i
+
+	i=0
+	until eval "${*}"; do
+		i=$((i + 1))
+		[ "${i}" -lt 50 ] || atf_fail "timed out waiting for: ${*}"
+		sleep 0.2
+	done
+}
