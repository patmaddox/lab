@@ -0,0 +1,130 @@
+#!/bin/sh
+#
+# lab-process-maild -- keep the lab-devel inbox answered.
+#
+#	lab-process-maild start		run in the background
+#	lab-process-maild stop		finish the pass in progress and exit
+#	lab-process-maild status	say whether it is running
+#	lab-process-maild drain		answer the inbox until it is empty
+#
+# lab-process-mail is a one-shot program: it answers the oldest inbox
+# message and exits 75 if more are waiting. drain runs it again at once
+# while it exits 75, so a batch of mail is answered back to back. start
+# hands drain to daemon(8), which detaches it, keeps the log and the
+# pidfile, and runs it again lab_process_maild_interval seconds after
+# each exit. lab-process-maild(8) describes the settings.
+
+set -eu
+
+readonly PROGNAME="${0##*/}"
+readonly EX_TEMPFAIL=75
+
+err() {
+	echo "E: ${PROGNAME}: ${*}" >&2
+}
+
+die() {
+	err "${@}"
+	exit 1
+}
+
+usage() {
+	die "usage: ${PROGNAME} start | stop | status | drain"
+}
+
+running() {
+	pgrep -q -L -F "${pidfile}" 2>/dev/null
+}
+
+# Start daemon(8) from an empty environment, keeping only what names
+# the user and finds programs, plus what the conf asks for, so the
+# daemon does not depend on which shell started it. daemon(8) itself
+# is found through the PATH this script runs with, whatever the conf
+# sets. ${lab_process_maild_env} is split into words, as rc.subr(8)
+# splits ${name}_env, so a value cannot hold a space.
+start() {
+	! running || die "already running as pid $(cat "${pidfile}")"
+	mkdir -p "$(dirname -- "${logfile}")" "$(dirname -- "${pidfile}")"
+	set -f
+	env -i -P "${PATH}" \
+	    HOME="${HOME}" USER="${me}" LOGNAME="${me}" PATH="${PATH}" \
+	    ${lab_process_maild_env} \
+	    daemon -f -H -o "${logfile}" -P "${pidfile}" \
+	    -R "${lab_process_maild_interval}" -t "${PROGNAME}" \
+	    "${bindir}/${PROGNAME}" drain
+	set +f
+}
+
+# Run lab-process-mail until it says the inbox is empty or it fails,
+# and exit with its status. daemon(8) sends SIGTERM to this shell
+# alone, and sh holds a trapped signal until the foreground command
+# ends, so the run in progress finishes before drain stops.
+drain() {
+	local status stopping
+
+	stopping=
+	trap 'stopping=1' TERM
+	while :; do
+		status=0
+		"${bindir}/lab-process-mail" || status="${?}"
+		[ "${status}" -eq "${EX_TEMPFAIL}" ] || exit "${status}"
+		[ -z "${stopping}" ] || exit 0
+	done
+}
+
+# daemon(8) passes SIGTERM on to drain, which finishes the run in
+# progress, and does not run it again.
+stop() {
+	running || die "not running"
+	pkill -L -F "${pidfile}"
+	echo "${PROGNAME}: stopping after the current pass"
+}
+
+status() {
+	running || die "not running"
+	echo "${PROGNAME}: running as pid $(cat "${pidfile}")"
+}
+
+# Read the rc.conf(5)-style settings from etc/ under LOCALBASE, the
+# parent of this script's bin/, and fill in the defaults. The log and
+# pidfile go under /var for root and under ${HOME} for anyone else, so
+# both work without a conf.
+configure() {
+	local localbase conf
+
+	bindir="$(CDPATH= cd -- "$(dirname -- "${0}")" && pwd)"
+	localbase="$(CDPATH= cd -- "${bindir}/.." && pwd)"
+	localbase="${localbase%/}"
+	me="$(id -un)"
+
+	lab_process_maild_env=
+	lab_process_maild_interval=60
+	if [ "$(id -u)" -eq 0 ]; then
+		lab_process_maild_logfile="/var/log/${PROGNAME}.log"
+		lab_process_maild_pidfile="/var/run/${PROGNAME}.pid"
+	else
+		lab_process_maild_logfile="${HOME}/log/${PROGNAME}.log"
+		lab_process_maild_pidfile="${HOME}/var/run/${PROGNAME}.pid"
+	fi
+
+	conf="${localbase}/etc/${PROGNAME}.conf"
+	[ ! -e "${conf}" ] || . "${conf}"
+
+	logfile="${lab_process_maild_logfile}"
+	pidfile="${lab_process_maild_pidfile}"
+}
+
+main() {
+	[ "${#}" -eq 1 ] || usage
+	case "${1}" in
+	start|stop|status|drain)
+		configure
+		"${1}"
+		;;
+	*)
+		usage
+		;;
+	esac
+}
+
+main "${@}"
