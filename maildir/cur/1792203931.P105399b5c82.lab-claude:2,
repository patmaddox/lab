+#!/bin/sh
+#
+# lab-process-mail-loop -- keep the lab-devel inbox drained.
+#
+# lab-process-mail answers the inbox once and exits. This runs it
+# again and again, sleeping ${LAB_PROCESS_MAIL_INTERVAL} seconds, or
+# 300, between runs, so new mail is answered without anyone starting
+# it. It stays in the foreground and never forks; leave that to a
+# supervisor such as daemon(8):
+#
+#	daemon -f -o ~/lab/process-mail.log -p ~/lab/process-mail.pid \
+#	    lab-process-mail-loop
+#
+# The environment passes through to lab-process-mail unchanged, so
+# LAB_BASE_BRANCH, NOTIFY_URL, and the rest work as they do there.
+#
+# A failed run stops the loop. When a message is stuck it is still the
+# oldest in the inbox, so running again would only retry it every
+# interval; lab-process-mail has already posted the notice, and the
+# operator restarts the loop once it is dealt with.
+
+set -eu
+
+readonly PROGNAME="${0##*/}"
+readonly INTERVAL="${LAB_PROCESS_MAIL_INTERVAL:-300}"
+
+die() {
+	echo "E: ${PROGNAME}: ${*}" >&2
+	exit 1
+}
+
+main() {
+	local status
+
+	[ "${#}" -eq 0 ] || die "usage: ${PROGNAME}"
+
+	while :; do
+		status=0
+		lab-process-mail || status="${?}"
+		[ "${status}" -eq 0 ] ||
+		    die "lab-process-mail exited ${status}; stopping"
+		sleep "${INTERVAL}"
+	done
+}
+
+main "${@}"
diff --git a/src/lab-process-mail/lab-process-mail-loop_test b/src/lab-process-mail/lab-process-mail-loop_test
new file mode 100755
index 0000000..9a191d5
--- /dev/null
+++ b/src/lab-process-mail/lab-process-mail-loop_test
@@ -0,0 +1,65 @@
+#!/usr/bin/env atf-sh
+
+atf_init_test_cases() {
+	atf_add_test_case no_args
+	atf_add_test_case sleeps_between_runs
+	atf_add_test_case default_interval
+	atf_add_test_case stops_on_failure
+}
+
+# Stub lab-process-mail and sleep, each logging its calls to calls.log.
+# lab-process-mail succeeds until its STUB_FAIL_AT'th run, which exits
+# 1, so every test ends.
+setup() {
+	LOOP="$(atf_get_srcdir)/lab-process-mail-loop"
+	unset LAB_PROCESS_MAIL_INTERVAL
+	stubdir="${PWD}"
+	mkdir bin
+
+	cat > bin/lab-process-mail <<-EOF
+	#!/bin/sh
+	echo run >> "${stubdir}/calls.log"
+	n="\$(grep -c '^run' "${stubdir}/calls.log")"
+	[ "\${n}" -lt "\${STUB_FAIL_AT:-1}" ] || exit 1
+	EOF
+
+	cat > bin/sleep <<-EOF
+	#!/bin/sh
+	echo "sleep \$*" >> "${stubdir}/calls.log"
+	EOF
+
+	chmod +x bin/*
+	export PATH="${PWD}/bin:${PATH}"
+}
+
+atf_test_case no_args
+no_args_body() {
+	setup
+	atf_check -s exit:1 -e match:"usage" "${LOOP}" extra
+	atf_check -s exit:1 test -e calls.log
+}
+
+atf_test_case sleeps_between_runs
+sleeps_between_runs_body() {
+	setup
+	export STUB_FAIL_AT=3 LAB_PROCESS_MAIL_INTERVAL=7
+	atf_check -s exit:1 -e ignore "${LOOP}"
+	printf '%s\n' run 'sleep 7' run 'sleep 7' run > expout
+	atf_check -o file:expout cat calls.log
+}
+
+atf_test_case default_interval
+default_interval_body() {
+	setup
+	export STUB_FAIL_AT=2
+	atf_check -s exit:1 -e ignore "${LOOP}"
+	atf_check -o match:"^sleep 300\$" cat calls.log
+}
+
+atf_test_case stops_on_failure
+stops_on_failure_body() {
+	setup
+	atf_check -s exit:1 -e match:"lab-process-mail exited 1; stopping" \
+	    "${LOOP}"
+	atf_check -o inline:"run\n" cat calls.log
+}
