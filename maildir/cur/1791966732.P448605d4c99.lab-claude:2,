+# Dovecot for lab-mail; see spec.org.
+#
+# Serves the maildir mbsync fetches as one read-only mailbox, lists,
+# over IMAP on loopback. Nothing else: no POP3, LMTP, or submission.
+
+protocols = imap
+listen = 127.0.0.1
+
+# Clients connect over loopback only, so there is no TLS, and any
+# user name and password are accepted.
+ssl = no
+disable_plaintext_auth = no
+
+service imap-login {
+  inet_listener imap {
+    address = 127.0.0.1
+    port = 2143
+  }
+  inet_listener imaps {
+    port = 0
+  }
+}
+
+passdb {
+  driver = static
+  args = nopassword=y
+}
+
+# Every login is the same user, vmail, which can read the maildir but
+# not write it. The indexes, the UID list, and an empty INBOX, which
+# IMAP requires, live in a directory of vmail's own.
+userdb {
+  driver = static
+  args = uid=vmail gid=vmail home=/data/mail/dovecot
+}
+
+namespace inbox {
+  inbox = yes
+  separator = /
+}
+
+mail_location = maildir:/data/mail/maildir:LAYOUT=fs:INBOX=/data/mail/dovecot/inbox:INDEX=/data/mail/dovecot/index:CONTROL=/data/mail/dovecot/control:VOLATILEDIR=/data/mail/dovecot/volatile
+
+# Every mailbox is read-only: clients may list, read, search, and
+# IDLE, but not set flags, append, copy in, or expunge.
+mail_plugins = acl
+
+protocol imap {
+  mail_plugins = $mail_plugins imap_acl
+}
+
+plugin {
+  acl = vfile:/usr/local/etc/dovecot/dovecot-acl
+}
