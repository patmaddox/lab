+# Give the agent a workspace of its own, so a pass never moves the
+# working copy of the trunk workspace. get_up_to_date may have rebased
+# its working-copy commit, so bring the files in line with it.
+prepare_workspace() {
+	if [ ! -d "${ws}" ]; then
+		jj -R "${trunk}" workspace add --name "$(basename "${ws}" .jj)" \
+		    -r trunk@upstream "${ws}"
+	fi
+	jj -R "${ws}" workspace update-stale
+}
