 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/jails/libexec/_jail.log.do b/jails/libexec/_jail.log.do
index 1007da74..db7a9321 100755
--- a/jails/libexec/_jail.log.do
+++ b/jails/libexec/_jail.log.do
@@ -68,7 +68,12 @@ install_freebsd() {
 
 	doas mkdir -p ${rootdir}${keys}
 	tar -C ${keys} -cf - . | doas tar -C ${rootdir}${keys} -xf -
-	doas pkg -r ${rootdir} -C ${PKGBASE_CONF} install -r FreeBSD-base -y ${PKGBASE_PACKAGES}
+	# pkg -r keeps its cache under the root, which starts empty on a
+	# clean build, so point it at the host's cache instead. Only the
+	# host's pkg writes there; the jail never sees it.
+	doas pkg -r ${rootdir} -C ${PKGBASE_CONF} \
+	    -o PKG_CACHEDIR="$(pkg config PKG_CACHEDIR)" \
+	    install -r FreeBSD-base -y ${PKGBASE_PACKAGES}
 
 	if [ ! -f ${rootdir}/etc/resolv.conf ]; then
 		echo "nameserver 8.8.8.8" | doas tee ${rootdir}/etc/resolv.conf > /dev/null

