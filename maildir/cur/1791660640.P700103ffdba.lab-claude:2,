 2 files changed, 38 insertions(+)

diff --git a/dotfiles/emacs/init.el b/dotfiles/emacs/init.el
index e620223..36ba96b 100644
--- a/dotfiles/emacs/init.el
+++ b/dotfiles/emacs/init.el
@@ -576,6 +576,8 @@ and prefixes every line with \"> \"."
 (setq sendmail-program
       (expand-file-name "libexec/maildir-deliver.sh" user-emacs-directory))
 (setq notmuch-draft-tags '("+draft"))
+;; "a" archives by moving the file; see pm-notmuch-archive-move-files.
+(setq notmuch-archive-tags '("-inbox" "+archived"))
 (setq notmuch-search-oldest-first nil)
 (setq notmuch-show-only-matching-messages t)
 (setq notmuch-show-mark-read-tags nil)
diff --git a/dotfiles/emacs/lisp/pm-notmuch.el b/dotfiles/emacs/lisp/pm-notmuch.el
index a323f53..feacf65 100644
--- a/dotfiles/emacs/lisp/pm-notmuch.el
+++ b/dotfiles/emacs/lisp/pm-notmuch.el
@@ -79,6 +79,42 @@ Added to `notmuch-show-insert-text/plain-hook'."
 (add-hook 'notmuch-show-insert-text/plain-hook
           #'pm-notmuch-highlight-diff-regions)
 
+;;; Archiving
+
+(defun pm-notmuch-archive-move-files ()
+  "Move the files of messages that gained or lost the archived tag.
+Adding archived moves each file from cur/ or new/ into archive/;
+removing it moves the file back to cur/.  Drafts never move.
+`notmuch new' then derives the tags from where the files live.
+Added to `notmuch-after-tag-hook'."
+  (with-no-warnings ; Bound dynamically by `notmuch-tag'.
+    (defvar tag-changes)
+    (defvar query))
+  (let* ((archive (member "+archived" tag-changes))
+         (unarchive (member "-archived" tag-changes))
+         (from (if archive
+                   "\\`\\(cur\\|new\\)/[^/]+\\'"
+                 "\\`archive/[^/]+\\'"))
+         (root (and (or archive unarchive)
+                    (file-name-as-directory
+                     (car (process-lines "notmuch" "config" "get"
+                                         "database.mail_root")))))
+         (dest (and root (expand-file-name (if archive "archive" "cur")
+                                           root)))
+         (moved nil))
+    (when root
+      (dolist (file (process-lines "notmuch" "search" "--output=files"
+                                   query))
+        (when (string-match-p from (file-relative-name file root))
+          (make-directory dest t)
+          (rename-file file (expand-file-name
+                             (file-name-nondirectory file) dest))
+          (setq moved t)))
+      (when moved
+        (call-process "notmuch" nil nil nil "new" "--quiet")))))
+
+(add-hook 'notmuch-after-tag-hook #'pm-notmuch-archive-move-files)
+
 ;;; Claude message handling
 
 (defvar pm-notmuch-claude-handle-message-program "claude-handle-message"

