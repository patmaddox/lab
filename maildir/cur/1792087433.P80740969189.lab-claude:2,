+PORTNAME=	signoz
+DISTVERSIONPREFIX=	v
+DISTVERSION=	0.145.0
+CATEGORIES=	net-mgmt
+# prebuilt web frontend; only web/ is installed from it
+MASTER_SITES+=	https://github.com/SigNoz/${PORTNAME}/releases/download/${DISTVERSIONFULL}/:web
+DISTFILES+=	${PORTNAME}-community_linux_amd64${EXTRACT_SUFX}:web
+
+# MAP_ANON with fd -1, which FreeBSD's mmap(2) requires; in no release yet
+PATCH_SITES=	https://github.com/bytedance/sonic/commit/
+PATCHFILES=	bf12ab8c1f789cfbbdfa9d6a4cae69ed136ea516.patch:-p1
+
+MAINTAINER=	patmaddox@FreeBSD.org
+COMMENT=	Observability platform for logs, metrics, and traces
+WWW=		https://signoz.io/
+
+LICENSE=	MIT
+LICENSE_FILE=	${WRKSRC}/LICENSE
+
+ONLY_FOR_ARCHS=	aarch64 amd64
+ONLY_FOR_ARCHS_REASON=	upstream supports and releases only amd64 and arm64
+
+USES=		go:modules
+USE_GITHUB=	nodefault
+# replaces the vendored sonic v1.14.1, which does not build with Go 1.26+
+GH_TUPLE=	bytedance:sonic:v1.15.4:sonic
+USE_RC_SUBR=	${PORTNAME}
+
+GO_MODULE=	github.com/SigNoz/signoz
+GO_TARGET=	./cmd/community:${PORTNAME}
+GO_BUILDFLAGS=	-ldflags "-X ${GO_MODULE}/pkg/version.variant=community \
+		-X ${GO_MODULE}/pkg/version.version=${DISTVERSIONFULL}"
+
+# PATCHFILES are relative to the sonic repository; files/ patches are not
+PATCH_DIST_ARGS=	-d ${WRKSRC_sonic} --suffix ${DISTORIG} --forward \
+			--quiet -E
+SUB_FILES=		pkg-message signoz.yaml.sample
+
+USERS=		${PORTNAME}
+GROUPS=		${PORTNAME}
+
+# after go-post-extract has vendored the modules upstream pins
+pre-patch:
+	${RM} -r ${WRKSRC}/vendor/github.com/bytedance/sonic
+	${LN} -s ${WRKSRC_sonic} ${WRKSRC}/vendor/github.com/bytedance/sonic
+
+post-patch:
+	${REINPLACE_CMD} -e 's|/etc/signoz/web|${DATADIR}/web|' \
+		${WRKSRC}/pkg/web/config.go
+	${REINPLACE_CMD} -e 's|/root/templates|${ETCDIR}/templates|' \
+		${WRKSRC}/pkg/alertmanager/alertmanagerserver/config.go \
+		${WRKSRC}/pkg/emailing/config.go
+	${REINPLACE_CMD} -e 's|/var/lib/signoz|/var/db/signoz|' \
+		${WRKSRC}/pkg/sqlstore/config.go
+# the active query log defaults to the working directory, / under rc.d
+	${REINPLACE_CMD} -e 's|Path: *""|Path: "/var/db/signoz"|' \
+		${WRKSRC}/pkg/prometheus/config.go
+	${REINPLACE_CMD} -e 's|/etc/signoz/web|${DATADIR}/web|' \
+		-e 's|/opt/signoz/conf/templates|${ETCDIR}/templates|' \
+		-e 's|/var/lib/signoz|/var/db/signoz|' \
+		-e 's|path: ""|path: /var/db/signoz|' \
+		${WRKSRC}/conf/example.yaml
+
+post-install:
+	${MKDIR} ${STAGEDIR}${DATADIR} ${STAGEDIR}/var/db/signoz \
+		${STAGEDIR}${ETCDIR}/templates/alertmanager \
+		${STAGEDIR}${ETCDIR}/templates/email
+	${INSTALL_DATA} ${WRKDIR}/signoz.yaml.sample ${STAGEDIR}${ETCDIR}
+# templates are configuration that users may edit; @sample keeps the edits
+.for t in alertmanager/email email/invitation email/reset_password
+	${INSTALL_DATA} ${WRKSRC}/templates/${t}.gotmpl \
+		${STAGEDIR}${ETCDIR}/templates/${t}.gotmpl.sample
+.endfor
+	${INSTALL_DATA} ${WRKSRC}/conf/example.yaml ${STAGEDIR}${DATADIR}
+	(cd ${WRKDIR}/${PORTNAME}-community_linux_amd64 && \
+		${COPYTREE_SHARE} web ${STAGEDIR}${DATADIR} "! -name *.map")
+	${FIND} ${STAGEDIR}${DATADIR}/web -type f | \
+		${SED} -e 's|^${STAGEDIR}${PREFIX}/||' >> ${TMPPLIST}
+
+.include <bsd.port.mk>
