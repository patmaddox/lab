diff --git a/Justfile b/Justfile
index 1e637a8..804f656 100644
--- a/Justfile
+++ b/Justfile
@@ -19,3 +19,13 @@ push:
   jj --quiet git push -b mail --remote jails
   jj --quiet git push -b mail --remote github
   jj --quiet git export
+
+# commit each mail file added in @ on its own, named for its subject
+commit-mail $prefix="mail: ":
+  #!/bin/sh
+  set -eu
+  for f in $(jj st maildir | awk '$1 == "A" { print $2 }'); do
+    subject="$(awk '/^$/ { exit } /^[ \t]/ { printf "%s", $0; next } { printf "\n%s", $0 }' "${f}" |
+      sed -n 's/^[Ss]ubject: *//p')"
+    jj --quiet commit -m "${prefix}${subject:-(no subject)}" "root-file:\"${f}\""
+  done

