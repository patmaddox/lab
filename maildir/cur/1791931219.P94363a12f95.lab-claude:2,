@@ -0,0 +1,88 @@
+#!/bin/sh
+
+# PROVIDE: signoz
+# REQUIRE: LOGIN
+# KEYWORD: shutdown
+#
+# Add the following lines to /etc/rc.conf.local or /etc/rc.conf
+# to enable this service:
+#
+# signoz_enable (bool)
+#     Set it to YES to enable signoz
+#     Set to NO by default
+# signoz_user (string)
+#     Set user that signoz will run under
+#     Default is "%%SIGNOZ_USER%%"
+# signoz_group (string)
+#     Set group that owns signoz files
+#     Default is "%%SIGNOZ_GROUP%%"
+# signoz_config (string)
+#     Set full path to a YAML config file
+#     Default is "", which uses built-in defaults and signoz_env
+# signoz_pidfile (string)
+#     Set full path to pid file
+#     Default is "/var/run/signoz.pid"
+# signoz_syslog_output_enable (bool)
+#     Set it to NO to disable syslog output
+#     Set to YES by default
+# signoz_syslog_output_tag (str)
+#     Set syslog tag if syslog enabled
+#     Default is "signoz"
+# signoz_syslog_output_priority (string)
+#     Set syslog priority if syslog enabled
+#     Default is "info"
+# signoz_syslog_output_facility (string)
+#     Set syslog facility if syslog enabled
+#     Default is "daemon"
+# signoz_env (string)
+#     Set environment variables used with signoz, e.g.
+#     "SIGNOZ_TELEMETRYSTORE_CLICKHOUSE_DSN=tcp://db:9000"
+#     Default is ""
+# signoz_args (string)
+#     Set additional command line arguments
+#     Default is ""
+
+. /etc/rc.subr
+
+name=signoz
+rcvar=signoz_enable
+
+load_rc_config $name
+
+: ${signoz_enable:="NO"}
+: ${signoz_user:="%%SIGNOZ_USER%%"}
+: ${signoz_group:="%%SIGNOZ_GROUP%%"}
+: ${signoz_config:=""}
+: ${signoz_pidfile:="/var/run/signoz.pid"}
+: ${signoz_syslog_output_enable:="YES"}
+: ${signoz_syslog_output_priority:="info"}
+: ${signoz_syslog_output_facility:="daemon"}
+
+if checkyesno signoz_syslog_output_enable; then
+	signoz_syslog_output_flags="-T ${signoz_syslog_output_tag:-${name}} \
+	    -s ${signoz_syslog_output_priority} \
+	    -l ${signoz_syslog_output_facility}"
+fi
+
+if [ -n "${signoz_config}" ]; then
+	required_files="${signoz_config}"
+	signoz_config_flags="--config ${signoz_config}"
+fi
+
+pidfile="${signoz_pidfile}"
+procname="%%PREFIX%%/bin/signoz"
+command="/usr/sbin/daemon"
+command_args="-f ${signoz_syslog_output_flags} -p ${pidfile} -t ${name} \
+	/usr/bin/env ${signoz_env} ${procname} server \
+	${signoz_config_flags} ${signoz_args}"
+
+start_precmd="signoz_start_precmd"
+
+signoz_start_precmd()
+{
+	if [ ! -e "${pidfile}" ]; then
+		install -m 0600 -o "${signoz_user}" -g "${signoz_group}" /dev/null "${pidfile}"
+	fi
+}
+
+run_rc_command "$1"
