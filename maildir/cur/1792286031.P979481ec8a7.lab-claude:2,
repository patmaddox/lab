+# notmuch profile for the lab-devel list as synced from lab-mail; see
+# notmuch-config(1). Use it with NOTMUCH_PROFILE=lab-mail. The
+# package installs this as ~/.config/notmuch/lab-mail/config only if
+# that file does not exist, and never overwrites it. The identity is
+# Pat's on beastie; another login edits [user] and mail_root.
+#
+# mbsync fills the mail root with the list's folders, INBOX, Next,
+# Later, and Archive; notmuch new only indexes them. mail_root is
+# relative to $HOME. The database and the hooks take notmuch's
+# defaults for the profile, ~/.local/share/notmuch/lab-mail and
+# ~/.config/notmuch/lab-mail/hooks.
+
+[database]
+mail_root=mail/pat@p7x.dev
+
+[user]
+name=Pat Maddox
+primary_email=pat@p7x.dev
+other_email=pat@patmaddox.com
+
+# Tags are derived by the post-new hook, so notmuch new adds none of
+# its own. Left unset, it would add inbox and unread.
+[new]
+tags=
+ignore=.uidvalidity;.mbsyncstate;.mbsyncstate.journal;.mbsyncstate.new;.mbsyncstate.lock
+
+[search]
+exclude_tags=deleted
+
+# Patches carry their commit's jj change id in a Change-Id header, the
+# same across every version of a patch. changeid:<id> finds them all.
+[index]
+header.changeid=Change-Id
+
+# unread, flagged, and replied follow \Seen, \Flagged, and \Answered
+# on lab-mail and Fastmail. A read-only login, which cannot set
+# flags, turns this off.
+[maildir]
+synchronize_flags=true
