diff --git a/mail/Makefile b/mail/Makefile
index ad70947d5321..cf289b8fee36 100644
--- a/mail/Makefile
+++ b/mail/Makefile
@@ -273,6 +273,7 @@
     SUBDIR += notimail
     SUBDIR += notmuch
     SUBDIR += notmuch-emacs
+    SUBDIR += notmuch-git
     SUBDIR += notmuch-mutt
     SUBDIR += nullmailer
     SUBDIR += oama
diff --git a/mail/notmuch-git/Makefile b/mail/notmuch-git/Makefile
new file mode 100644
index 000000000000..bdd12bc57f2d
--- /dev/null
+++ b/mail/notmuch-git/Makefile
@@ -0,0 +1,26 @@
+PORTREVISION=	0
+CATEGORIES=	mail
+PKGNAMESUFFIX=	-git
+
+COMMENT=	Synchronize Notmuch tags through a git repository
+WWW=		https://notmuchmail.org/
+
+RUN_DEPENDS=	git:devel/git \
+		notmuch:mail/notmuch
+
+USES=		python:run shebangfix
+SHEBANG_FILES=	notmuch-git.py
+
+MASTERDIR=	${.CURDIR}/../notmuch
+NO_ARCH=	yes
+NO_BUILD=	yes
+
+PORTSCOUT=	limit:^[0-9\.]*$$
+
+PLIST_FILES=	bin/notmuch-git
+
+do-install:
+	${INSTALL_SCRIPT} ${WRKSRC}/notmuch-git.py \
+		${STAGEDIR}${PREFIX}/bin/notmuch-git
+
+.include "${MASTERDIR}/Makefile"
diff --git a/mail/notmuch-git/pkg-descr b/mail/notmuch-git/pkg-descr
new file mode 100644
index 000000000000..9f22bdf24752
--- /dev/null
