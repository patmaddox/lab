 zib/hello-lab-devel/README.md | 9 +++++++++
 zib/hello-lab-devel/hello.sh  | 4 ++++
 2 files changed, 13 insertions(+)
 create mode 100644 zib/hello-lab-devel/README.md
 create mode 100755 zib/hello-lab-devel/hello.sh

diff --git a/zib/hello-lab-devel/README.md b/zib/hello-lab-devel/README.md
new file mode 100644
index 0000000..c5b0a74
--- /dev/null
+++ b/zib/hello-lab-devel/README.md
@@ -0,0 +1,9 @@
+# hello-lab-devel
+
+A proof of concept for the lab-devel mailing list workflow: a task
+asked for on the list, worked as a patch, and posted back for review.
+
+    $ ./hello.sh
+    hello, lab-devel
+    $ ./hello.sh world
+    hello, world
diff --git a/zib/hello-lab-devel/hello.sh b/zib/hello-lab-devel/hello.sh
new file mode 100755
index 0000000..7705ac5
--- /dev/null
+++ b/zib/hello-lab-devel/hello.sh
@@ -0,0 +1,4 @@
+#!/bin/sh
+set -eu
+
+echo "hello, ${1:-lab-devel}"

