+	kill -TERM "${pid}"
+	touch go
+	status=0
+	wait "${pid}" || status="${?}"
+	atf_check_equal 0 "${status}"
+	atf_check -s exit:1 test -e claude.log
+}
+
+wait_for() {
+	local i
+
+	i=0
+	until "${@}"; do
+		i=$((i + 1))
+		[ "${i}" -lt 50 ] || atf_fail "timed out waiting for: ${*}"
