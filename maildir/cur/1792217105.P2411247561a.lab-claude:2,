+#!/usr/bin/env python3
+#
+# rethread.py -- thread each revision of a series under its first
+# version.
+#
+#     rethread.py [--apply] <maildir>/cur
+#
+# A revision now replies to the first version of its series, as
+# git.git does, so every version and its review share one thread.
+# Series posted before that started a fresh thread for each version,
+# linked only by the "Link to v(N-1): id:<message-id>" line in the
+# cover letter or below the "---" of a single patch. This follows
+# those links back to the first version and rewrites the threading
+# headers to match what format-patch.sh now writes:
+#
+#   - the cover, or only patch, of each revision gets In-Reply-To and
+#     References naming the first version
+#   - each k/N patch under that cover gets References naming the first
+#     version and the cover
+#
+# Nothing else in a message changes, and a message already threaded
+# this way is left alone, so a rerun is a no-op. Without --apply it
+# only prints the plan. With --apply it writes the files in place and
+# prints the id of each message it changed, one per line.
+#
+# An existing notmuch database does not follow the change. notmuch new
+# skips an edited file that keeps its name, and notmuch reindex moves
+# the edited message into its new thread but leaves the replies below
+# it in the old one. Rebuild the database instead, keeping the tags:
+#
+#     rethread.py --apply maildir/cur
+#     notmuch dump > /tmp/notmuch.tags
+#     rm -rf <the database's xapian directory>
+#     notmuch new
+#     notmuch restore < /tmp/notmuch.tags
+
+import email
+import email.policy
+import glob
+import os
+import re
+import sys
+
+REVISION = re.compile(r"^\[[^\]]*\b(?:PATCH|RFC)\b[^\]]*?\bv(\d+)\b", re.I)
+NUMBERED = re.compile(r"^\[[^\]]*\b(\d+)/(\d+)\]")
+LINK = re.compile(r"Link to v\d+[^:\n]*:\s*(?:id:)?<?([^\s>]+?)>?\s*$", re.M)
+
+# The lab-mail jail series was first posted unversioned, then
+# renumbered after the spec it carried. Its v8 cover names that
+# posting only as "the earlier posting", so it is linked here.
+EXTRA_LINKS = {
+    "cover.1791959849.git.claude@p7x.dev":
+        "9480e8c6bfeafcf6a37fce4a2f7e508bc3031423.1791961946.git.claude@p7x.dev",
+}
+
+
+def read_messages(cur):
+    msgs = {}
+    for path in sorted(glob.glob(os.path.join(cur, "*"))):
+        with open(path, "rb") as f:
+            m = email.message_from_binary_file(
+                f, policy=email.policy.compat32)
+        mid = (m["Message-ID"] or "").strip().strip("<>")
+        if not mid:
+            continue
+        body = ""
+        for part in m.walk():
+            if part.get_content_type() == "text/plain":
+                payload = part.get_payload(decode=True)
+                if payload:
+                    body += payload.decode("utf-8", "replace")
+        msgs[mid] = {
+            "path": path,
+            "subject": re.sub(r"\s+", " ", str(m["Subject"] or "")),
+            "in_reply_to": (m["In-Reply-To"] or "").strip().strip("<>"),
+            "body": body,
+        }
+    return msgs
+
+
+def is_numbered_patch(subject):
+    n = NUMBERED.match(subject)
+    return bool(n) and int(n.group(1)) != 0
+
+
+def previous_versions(msgs):
+    prev = {}
+    for mid, msg in msgs.items():
+        subject = msg["subject"]
+        if subject.lower().startswith("re:"):
+            continue
+        if not REVISION.match(subject) or is_numbered_patch(subject):
+            continue
+        links = LINK.findall(msg["body"])
+        if links:
+            prev[mid] = links[0]
+        else:
+            print(f"no link to the previous version: {subject}",
+                  file=sys.stderr)
+    prev.update((k, v) for k, v in EXTRA_LINKS.items() if k in msgs)
+    return prev
+
+
+def first_version(mid, prev, msgs):
+    seen = set()
+    while mid in prev and prev[mid] in msgs and mid not in seen:
+        seen.add(mid)
+        mid = prev[mid]
+    return mid
+
+
+# Replace the named headers, keeping every other header byte for byte.
+# The new ones go after Message-ID, where git format-patch puts them.
+def set_headers(path, headers, apply):
+    with open(path, "rb") as f:
+        raw = f.read()
+    end = raw.find(b"\n\n")
+    if end < 0:
+        return False
+    lines = raw[:end].split(b"\n")
+    names = {k.lower().encode() for k in headers}
+    kept = []
+    dropping = False
+    for line in lines:
+        if dropping and line[:1] in (b" ", b"\t"):
+            continue
+        dropping = line.split(b":", 1)[0].lower() in names
+        if not dropping:
+            kept.append(line)
+    at = len(kept)
+    for i, line in enumerate(kept):
+        if line.split(b":", 1)[0].lower() == b"message-id":
+            at = i + 1
+            while at < len(kept) and kept[at][:1] in (b" ", b"\t"):
+                at += 1
+            break
+    kept[at:at] = [f"{k}: {v}".encode() for k, v in headers.items()]
+    data = b"\n".join(kept) + raw[end:]
+    if data == raw:
+        return False
+    if apply:
+        with open(path, "wb") as f:
+            f.write(data)
+    return True
+
+
+def main(argv):
+    apply = "--apply" in argv
+    args = [a for a in argv if a != "--apply"]
+    if len(args) != 1:
+        print("usage: rethread.py [--apply] <maildir>/cur",
+              file=sys.stderr)
+        return 1
+    msgs = read_messages(args[0])
+    prev = previous_versions(msgs)
+    children = {}
+    for mid, msg in msgs.items():
+        children.setdefault(msg["in_reply_to"], []).append(mid)
+
+    for mid in sorted(prev, key=lambda m: msgs[m]["subject"]):
+        v1 = first_version(mid, prev, msgs)
+        if v1 == mid:
+            continue
+        changes = [(mid, {"In-Reply-To": f"<{v1}>",
+                          "References": f"<{v1}>"})]
+        for child in children.get(mid, []):
+            subject = msgs[child]["subject"]
+            if not subject.lower().startswith("re:") and \
+               is_numbered_patch(subject):
+                changes.append((child, {
+                    "In-Reply-To": f"<{mid}>",
+                    "References": f"<{v1}> <{mid}>"}))
+        for cid, headers in changes:
+            if not set_headers(msgs[cid]["path"], headers, apply):
+                continue
+            if apply:
+                print(f"id:{cid}")
+            else:
+                print(f"{msgs[cid]['subject']}\n"
+                      f"    under {msgs[v1]['subject']}")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main(sys.argv[1:]))

