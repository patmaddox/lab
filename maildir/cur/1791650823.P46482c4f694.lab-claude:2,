diff --git a/Justfile b/Justfile
index 7945f87..fb5e2df 100644
--- a/Justfile
+++ b/Justfile
@@ -19,3 +19,19 @@ push:
   jj git push -b mail --quiet --remote jails
   jj git push -b mail --quiet --remote github
   jj git export
+
+# move mail tagged archive into maildir/archive/
+archive:
+  #!/bin/sh
+  set -eu
+  root="$(cd maildir && pwd -P)"
+  mkdir -p "${root}/archive/cur" "${root}/archive/new" "${root}/archive/tmp"
+  notmuch search --output=files 'tag:archive and not path:archive/**' |
+  while IFS= read -r f; do
+    [ -f "${f}" ] || continue
+    dir="$(cd "$(dirname "${f}")" && pwd -P)"
+    case "${dir}" in
+    "${root}/cur"|"${root}/new") mv "${f}" "${root}/archive/${dir##*/}/" ;;
+    esac
+  done
+  notmuch new --quiet

