-        (:name "patches - new" :query "tag:patch not tag:patch:applied not tag:patch:dropped not tag:patch:review not tag:patch:waiting" :key "p" :sort-order newest-first)
-        (:name "patches - review" :query "tag:patch and tag:patch:review" :key "r" :sort-order newest-first)
-        (:name "patches - waiting" :query "tag:patch and tag:patch:waiting" :key "w" :sort-order newest-first)
-        (:name "drafts" :query "tag:draft" :key "d" :sort-order newest-first)
-        (:name "patches - closed" :query "tag:patch:applied or tag:patch:dropped" :sort-order newest-first)
-        (:name "open" :query "not tag:closed" :key "o" :sort-order newest-first)
-        ;;(:name "unread" :query "tag:unread" :key "u" :sort-order newest-first)
-        (:name "sent" :query "tag:sent" :key "s" :sort-order newest-first)
-        (:name "all mail" :query "*" :key "a" :sort-order newest-first)))
+      '((:name "inbox" :query "tag:inbox" :key "i")
+        (:name "patches" :query "tag:inbox and subject:PATCH" :key "p")
+        (:name "drafts" :query "tag:draft" :key "d")
+        (:name "sent" :query "tag:sent" :key "s")
+        (:name "all mail" :query "*" :key "a")))
