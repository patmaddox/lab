 # newest message already in the maildir, so a series delivered in one
 # burst sorts in the order it was delivered.
 #
+# Only a mail message is delivered. The header section must be well
+# formed, every line a header field or the continuation of one, and end
+# with an empty line before the body; From, Subject, and Message-ID
+# must each appear exactly once. Anything else is refused and nothing
+# reaches the maildir, so a stray file or command output piped in by
+# mistake can never show up on the list.
+#
 # git is the transport: the message is only saved, not sent.  Commit it
 # and push; notmuch new indexes it wherever the branch is checked out.
 #
@@ -59,6 +66,10 @@ main() {
 	stamp="$(delivery_time "${maildir}")"
 	name="$(unique_name "${stamp}")"
 	add_headers "${stamp}" >"${maildir}/tmp/${name}"
+	if ! check_message <"${maildir}/tmp/${name}"; then
+		rm -f "${maildir}/tmp/${name}"
+		die "refusing to deliver: not a mail message"
+	fi
 	mv "${maildir}/tmp/${name}" "${maildir}/cur/${name}:2,"
 }
 
@@ -121,6 +132,32 @@ add_headers() {
 	'
 }
 
+# Succeed if stdin is a mail message, as the header comment defines it.
+# Each problem found is reported on stderr.
+check_message() {
+	awk -v prog="${PROGNAME}" '
+		function bad(msg) { print prog ": " msg >"/dev/stderr"; failed = 1 }
+		BEGIN { in_header = 1 }
+		!in_header { next }
+		/^$/ { in_header = 0; next }			# end of headers
+		/^[ \t]/ && NR > 1 { next }			# continuation
+		/^[!-9;-~]+:/ {					# field
+			seen[tolower(substr($0, 1, index($0, ":") - 1))]++
+			next
+		}
+		{ bad("line " NR " is not a header field"); exit }
+		END {
+			if (failed) exit 1
+			if (in_header) bad("no empty line ends the headers")
+			if (seen["from"] != 1) bad("need exactly one From")
+			if (seen["subject"] != 1) bad("need exactly one Subject")
+			if (seen["message-id"] != 1)
+				bad("need exactly one Message-ID")
+			exit failed
+		}
+	'
+}
