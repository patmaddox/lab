+#!/usr/bin/env atf-sh
+
+DELIVER="$(atf_get_srcdir)/maildir-deliver.sh"
+
+atf_init_test_cases() {
+	atf_add_test_case delivers_message
+	atf_add_test_case delivers_patch
+	atf_add_test_case refuses_empty
+	atf_add_test_case refuses_plain_text
+	atf_add_test_case refuses_headers_only
+	atf_add_test_case refuses_missing_message_id
+	atf_add_test_case refuses_two_froms
+}
+
+# A minimal message the list accepts.
+message() {
+	printf 'From: claude <claude@p7x.dev>\n'
+	printf 'To: lab-devel@p7x.dev\n'
+	printf 'Subject: Hello\n'
+	printf 'Message-ID: <1.abc@p7x.dev>\n'
+	printf '\n'
+	printf 'Body.\n'
+}
+
+# The maildir should hold exactly ${1} messages, and no leftovers.
+check_count() {
+	atf_check -o "inline:${1}\n" sh -c 'ls maildir/cur | wc -l | tr -d " "'
+	atf_check -o empty ls maildir/tmp
+}
+
+# Delivering file "in" should fail with a message matching ${1}.
+refuse() {
+	export MAILDIR="${PWD}/maildir"
+	atf_check -s exit:1 -e "match:${1}" "${DELIVER}" <in
+	check_count 0
+}
+
+atf_test_case delivers_message
+delivers_message_head() {
+	atf_set descr "A well-formed message is delivered and dated"
+}
+delivers_message_body() {
+	export MAILDIR="${PWD}/maildir"
+	message >in
+	atf_check "${DELIVER}" -i lab-devel@p7x.dev <in
+	check_count 1
+	atf_check -o match:'^Date: ' cat maildir/cur/*
+}
+
+atf_test_case delivers_patch
+delivers_patch_head() {
+	atf_set descr "git format-patch output is delivered without its mbox separator"
+}
+delivers_patch_body() {
+	export MAILDIR="${PWD}/maildir"
+	{
+		printf 'From 0123456789012345678901234567890123456789 Mon Sep 17 00:00:00 2001\n'
+		printf 'From: claude <claude@p7x.dev>\n'
+		printf 'Subject: [PATCH] a: Change b\n'
+		printf ' continued\n'
+		printf 'Message-ID: <1.abc@p7x.dev>\n'
+		printf '\n'
+		printf -- '---\n'
+	} >in
+	atf_check "${DELIVER}" <in
+	check_count 1
+	atf_check -o not-match:'^From [0-9a-f]' cat maildir/cur/*
+}
+
+atf_test_case refuses_empty
+refuses_empty_head() {
+	atf_set descr "Empty input is refused"
+}
+refuses_empty_body() {
+	: >in
+	refuse 'need exactly one From'
+}
+
+atf_test_case refuses_plain_text
+refuses_plain_text_head() {
+	atf_set descr "Text that is not a message is refused"
+}
+refuses_plain_text_body() {
+	printf 'hello world\n\nmore\n' >in
+	refuse 'line 1 is not a header field'
+}
+
+atf_test_case refuses_headers_only
+refuses_headers_only_head() {
+	atf_set descr "Headers with no empty line after them are refused"
+}
+refuses_headers_only_body() {
+	message | sed '/^$/,$d' >in
+	refuse 'no empty line ends the headers'
+}
+
+atf_test_case refuses_missing_message_id
+refuses_missing_message_id_head() {
+	atf_set descr "A message without a Message-ID is refused"
+}
+refuses_missing_message_id_body() {
+	message | grep -v '^Message-ID' >in
+	refuse 'need exactly one Message-ID'
+}
+
+atf_test_case refuses_two_froms
+refuses_two_froms_head() {
+	atf_set descr "A message with two From fields is refused"
+}
+refuses_two_froms_body() {
+	{ printf 'From: x@example.org\n'; message; } >in
+	refuse 'need exactly one From'
+}
