+#!/bin/sh
+#
+# get-up-to-date.sh -- bring trunk work and the mail outbox up to date.
+#
+# The best-effort, deterministic part of a process-email pass.  It
+# fetches every remote, rebases your unmerged trunk work onto
+# trunk@upstream, rebases your outbox bookmark onto mail@upstream, and
+# indexes the list with notmuch.
+#
+# It does not judge anything.  A rebase that conflicts still succeeds
+# and leaves the conflict in the commit; a patch applied upstream with
+# edits survives as a redundant commit.  Settling those is left to
+# whoever runs this next, and the state is in jj for them to read:
+#
+#     jj log -r 'conflicts() & mine()'
+#
+# Running it twice is harmless.  It exits non-zero only when a step
+# fails outright, such as a fetch that cannot reach a remote.
+#
+# The trunk workspace is the one holding this script.  The mail
+# workspace is ${MAIL_WORKSPACE}, or ~/lab/mail.jj.  The outbox bookmark
+# is named for your login.
+
+set -eu
+set -o pipefail
+
+readonly PROGNAME="${0##*/}"
+
+# Your commits off trunk, less everything descended from the list.
+# Trunk and the list share no commit but root(), so the outbox is left
+# out however far the list has moved since it was built on.
+readonly WORK='mine() ~ ::trunk@upstream ~ (::mail@upstream ~ root())::'
+
+err() {
+	echo "${PROGNAME}: ${*}" >&2
+}
+
+die() {
+	err "${@}"
+	exit 1
+}
+
+main() {
+	local trunk mail me
+	trunk="$(CDPATH= cd -- "$(dirname -- "${0}")/../.." && pwd)" \
+	    || die "cannot resolve trunk workspace"
+	mail="${MAIL_WORKSPACE:-${HOME}/lab/mail.jj}"
+	[ -d "${mail}" ] || die "${mail}: no mail workspace"
+	me="$(whoami)"
+
+	# Both workspaces share one repo, so one fetch covers them.
+	jj -R "${trunk}" git fetch --all-remotes
+
+	jj -R "${trunk}" rebase -s "roots(${WORK})" -d trunk@upstream \
+	    --skip-emptied
+
+	# A bookmark with no pending mail, missing or merged in full, has
+	# nothing to rebase; point it at the list's tip instead.
+	if [ -z "$(jj -R "${mail}" log --no-graph -T commit_id \
+	    -r "bookmarks(exact:${me}) ~ ::mail@upstream")" ]; then
+		jj -R "${mail}" bookmark set "${me}" -r mail@upstream
+	fi
+	jj -R "${mail}" rebase -b "${me}" -d mail@upstream --skip-emptied
+	jj -R "${mail}" new "${me}"
+
+	notmuch new --quiet
+}
+
+main "${@}"
