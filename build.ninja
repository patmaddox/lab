ninja_out = ninja-out
bin_out = ${ninja_out}/bin

rule sh_cmd
  command = test -x ${in} && cp ${in} ${out} && touch ${out}

subninja src/freebsd-src/freebsd.ninja
#subninja src/freebsd-ports/ports.ninja

subninja infra/images/devbsd/devbsd.ninja
subninja infra/images/poudriere-builder/poudriere-builder.ninja

subninja src/sync-pw/sync-pw.ninja
subninja src/urlcheck/urlcheck.ninja

subninja src/patmaddox.com/patmaddox.com.ninja
