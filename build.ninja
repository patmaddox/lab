ninja_out = ninja-out
bin_out = ${ninja_out}/bin

rule sh_cmd
  command = test -x ${in} && cp ${in} ${out} && touch ${out}

build all: phony mod.pkg.bin mod.pkg.freebsd mod.pkg.images mod.pkg.sites

build pkg.bin: phony mod.pkg.bin
build pkg.freebsd: phony mod.pkg.freebsd
build pkg.images: phony mod.pkg.images
build pkg.sites: phony mod.pkg.sites

# bin
build mod.pkg.bin: phony mod.bin.sync-pw mod.bin.urlcheck

subninja src/sync-pw/sync-pw.ninja
subninja src/urlcheck/urlcheck.ninja

# freebsd

subninja src/freebsd-src/freebsd.ninja
#subninja src/freebsd-ports/ports.ninja

# images
build mod.pkg.images: phony mod.images.archie mod.images.devbsd mod.images.poudriere-builder

subninja infra/images/archie/images.archie.ninja
subninja infra/images/beastie/images.beastie.ninja
subninja infra/images/gulliver/images.gulliver.ninja
subninja infra/images/devbsd/devbsd.ninja
subninja infra/images/poudriere-builder/poudriere-builder.ninja

# sites
build mod.pkg.sites: phony mod.patmaddox.com

subninja src/patmaddox.com/patmaddox.com.ninja

default all
